@using DiceCombats
@inject DiceCombatsService CombatService
@inject IStringLocalizer<Resources.Localization.CreatureCustomFieldRenderer> Loc

@if (EditionMode)
{
    <div class="dc-fbody dc-fbody-col">
        <button type="button" class="dc-btn dc-btn-fill" @onclick="@(() => Field.AddOption())">
            <DcIcon Name="add" />
            @Loc["CBFieldAddOption"]
        </button>

        <div class="dc-opt-grid" style="width:100%;">
            @foreach (int i in Enumerable.Range(0, Field.Labels.Count))
            {
                <div class="dc-opt" style="flex-wrap:wrap;">
                    <div class="dc-field" style="flex:1 1 90px;">
                        <span class="dc-flabel">@Loc["OptionLabel"]</span>
                        <input class="dc-inp" type="text" @bind="Field.Labels[i]" @bind:event="oninput" />
                    </div>
                    <label class="dc-chk">
                        <input type="checkbox" @bind="Field.SelectedOptions[i]" />
                        @Field.Labels[i]
                    </label>
                    <button type="button" class="dc-ib dc-danger" title="Delete"
                            @onclick="@(() => Field.RemoveOption(Field.Labels[i]))">
                        <DcIcon Name="delete" />
                    </button>
                </div>
            }
        </div>
    </div>
}
else
{
    @* The whole group toggles between the collapsed chip list and the full
       list of conditions, exactly as it did before. *@
    <div class="dc-fgrp" style="flex-wrap:wrap;cursor:pointer;" @onclick="ToggleMaximized">
        <span class="dc-flabel">@Field.Title</span>
        @if (_dndConditionsFieldMaximized == false)
        {
            @if (Field.SelectedOptions.Count(x => x == true) == 0)
            {
                <span class="dc-tag">
                    @Loc["DnDConditionAddCondition"]
                    @* The chevron keeps the accent the Success colour carried. *@
                    <span style="display:inline-flex;color:var(--a1);"><DcIcon Name="double-right" /></span>
                </span>
            }
            @foreach (int i in Enumerable.Range(0, Field.Labels.Count))
            {
                @if (Field.SelectedOptions[i] == true)
                {
                    <span class="dc-tog dc-on">@Field.Labels[i]</span>
                }
            }
        }
        else
        {
            <span class="dc-tag">
                @Loc["DnDConditionMinimize"]
                <span style="display:inline-flex;color:var(--a1);"><DcIcon Name="double-left" /></span>
            </span>
            @foreach (int i in Enumerable.Range(0, Field.Labels.Count))
            {
                var index = i;
                @if (Field.SelectedOptions[index] == true)
                {
                    <label class="dc-chk">
                        <input type="checkbox" checked="@Field.SelectedOptions[index]"
                               @onchange="@(e => OnOptionChanged(index, e.Value is bool v && v))" />
                        <span class="dc-tog dc-on">@Field.Labels[index]</span>
                    </label>
                }
                else
                {
                    <label class="dc-chk">
                        <input type="checkbox" checked="@Field.SelectedOptions[index]"
                               @onchange="@(e => OnOptionChanged(index, e.Value is bool v && v))" />
                        @Field.Labels[index]
                    </label>
                }
            }
        }
    </div>
}

@code {
    [Parameter] public DCCreatureConditionsField Field { get; set; } = default!;
    [Parameter] public bool EditionMode { get; set; } = false;
    [Parameter] public EventCallback OnChange { get; set; }
    [Parameter] public EventCallback<CustomFieldChangeInfo> OnFieldChanged { get; set; }

    private bool _dndConditionsFieldMaximized = false;

    private async Task ToggleMaximized()
    {
        _dndConditionsFieldMaximized = !_dndConditionsFieldMaximized;
        if (OnChange.HasDelegate)
            await OnChange.InvokeAsync();
    }

    private async Task OnOptionChanged(int index, bool newValue)
    {
        var oldValue = Field.SelectedOptions[index];
        Field.SelectedOptions[index] = newValue;

        if (OnFieldChanged.HasDelegate)
        {
            await OnFieldChanged.InvokeAsync(new CustomFieldChangeInfo
            {
                Field = Field,
                OldValue = oldValue,
                NewValue = newValue,
                Action = newValue ? "Added" : "Removed",
                OptionIndex = index,
                OptionName = Field.Labels.ElementAtOrDefault(index)
            });
        }

        if (OnChange.HasDelegate)
            await OnChange.InvokeAsync();
    }
}
