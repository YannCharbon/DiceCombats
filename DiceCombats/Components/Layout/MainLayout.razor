@inherits LayoutComponentBase

@inject DiceCombatsService CombatsService
@inject NavigationManager Navigation
@implements IDisposable

<PopupNotification></PopupNotification>

<StorageAlerts />

<ImportWizard />

<WebLinkModal />

<DCNavMenu />

<MudThemeProvider IsDarkMode="true" Theme="DCTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="page">
    <!--<div class="sidebar">
        <NavMenu />
    </div>-->

    <main>
        <article class="content px-4" id="mainpagebody">
            @Body
        </article>

        <div style="height:20px;">
            <!--Dummy div to add white space at bottom of page-->
        </div>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        App.PagesReloadRequested += ReloadInPlace;
    }

    // A full reload of the web page in the same web view: every component and
    // every scoped service starts again, as with a new page, but the native
    // window around it is left alone (see App.ReloadPages).
    private void ReloadInPlace()
    {
        _ = InvokeAsync(() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true));
    }

    public void Dispose()
    {
        App.PagesReloadRequested -= ReloadInPlace;
    }

    // Every colour below is a stop of the brand gradient or a step of the
    // surface ramp defined in wwwroot/css/app.css, so MudBlazor's components
    // sit in the same colour world as the app's own. The previous
    // Colors.Teal.Darken1/Darken4 appeared nowhere in the gradient.
    MudTheme DCTheme = new MudTheme()
    {
        PaletteDark = new PaletteDark()
            {
                Primary = "#32C87E",   // gradient stop 2
                Secondary = "#23AA80", // gradient stop 4
                Tertiary = "#C2D12E",  // gradient stop 1
                Info = "#00AAAA",      // gradient stop 3
                Success = "#32C87E",
                Warning = "#E0A33C",
                Error = "#E04545",

                Black = "#09100E",
                Background = "#09100E",   // --s0, the page ground
                BackgroundGray = "#152521",
                // --s4, one step above .dc-panel: a MudPaper or expansion
                // panel sitting on a panel has to separate from it.
                Surface = "#1B312C",
                DrawerBackground = "#09100E",
                AppbarBackground = "#09100E",

                TextPrimary = "rgba(255,255,255,0.88)",
                TextSecondary = "rgba(255,255,255,0.54)",
                ActionDefault = "rgba(255,255,255,0.54)",

                LinesDefault = "#24463F",
                LinesInputs = "#2E5A4E",
                Divider = "#24463F",
                TableLines = "#24463F",
                TableHover = "#223C36",
                OverlayDark = "rgba(4,20,14,0.6)",
            },

        ZIndex = new ZIndex
            {
                Dialog = 4000,
                Popover = 3500,
                Snackbar = 4500,
                Tooltip = 4600
            },
    };
}
