@page "/"

@inject NavigationManager Navigation
@inject DiceCombatsService CombatService
@inject IStringLocalizer<Resources.Localization.Home> Loc

<GenericModal TContent="WelcomeMessage" OnClose="HandleWelcomeMessageModalClose" @ref="WelcomeMessageModalRef">
    <WelcomeMessage NewVersion="_newVersion" UpdateAvailable="_updateAvailable" UpdateInfos="_updateInfos" />
</GenericModal>

<div class="dc-home">

    <div style="text-align:center;">
        <h1 class="dc-h1" style="font-size:34px;">@Loc["Title"]</h1>
        <p class="dc-sub" style="font-size:15px;max-width:560px;margin:8px auto 0 auto;">@Loc["Description"]</p>
    </div>

    <section>
        <div style="display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap;">
            <h2 class="dc-h2" style="border:0;padding-bottom:0;">@Loc["PinnedCombatsTitle"]</h2>
            @if (CombatService.GetPinnedCombatsGuids().Count > 0)
            {
                <a class="dc-crumb" @onclick="@(() => Navigation.NavigateTo("/combatsexplorer"))">@Loc["AllCombatsLink"] &rarr;</a>
            }
        </div>

        @if (CombatService.GetCreatureList().Count == 0)
        {
            @RenderEmptyState(Loc["PinnedCombatsNoCreatures"], Loc["PinnedCombatsCreateFirstCreature"], "/newcreature")
        }
        else if (CombatService.GetCombatList().Count == 0)
        {
            @RenderEmptyState(Loc["PinnedCombatsNoCombats"], Loc["PinnedCombatsCreateFirstCombat"], "/combatmanager/new")
        }
        else if (CombatService.GetPinnedCombatsGuids().Count == 0)
        {
            @RenderEmptyState(Loc["PinnedCombatsNoPinned"], Loc["PinnedCombatsSelect"], "/combatsexplorer")
        }
        else
        {
            <div class="dc-grid-3">
                @foreach (string guid in CombatService.GetPinnedCombatsGuids())
                {
                    var combat = CombatService.GetCombatFromGUID(guid);
                    if (combat == null) continue;
                    @RenderPinnedCard(combat)
                }
            </div>
        }
    </section>

    <section>
        <h2 class="dc-h2" style="border:0;padding-bottom:0;">@Loc["StartSomethingTitle"]</h2>
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:14px;">
            <button type="button" class="dc-btn dc-btn-fill"
                    @onclick="@(() => Navigation.NavigateTo("/combatmanager/new"))">
                <DcIcon Name="add" />
                @Loc["NewCombatBtn"]
            </button>
            <button type="button" class="dc-btn dc-btn-out"
                    @onclick="@(() => Navigation.NavigateTo("/newcreature"))">
                <DcIcon Name="add" />
                @Loc["NewCreatureBtn"]
            </button>
            <button type="button" class="dc-btn dc-btn-out"
                    @onclick="@(() => Navigation.NavigateTo("/automations"))">
                <DcIcon Name="auto-mode" />
                @Loc["AutomationTitle"]
            </button>
        </div>
    </section>

    <div style="border-top:1px solid var(--b1);padding-top:22px;text-align:center;">
        <span class="dc-meta">DiceCombats @CombatService.GetVersion() &middot; &copy; Yann Charbon &middot; GPL-3.0-or-later</span>
    </div>

</div>

@code {
    private GenericModal<WelcomeMessage>? WelcomeMessageModalRef;

    private bool _newVersion = false;
    private bool _updateAvailable = false;
    private GitHubRelease? _updateInfos = null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            string lastKnownVersion = Preferences.Get("LastKnownVersion", "-1");

            // The service decides whether to go to the network; this only reads
            // the conclusion. A failed check leaves the last known release in
            // place rather than reporting nothing.
            var status = await CombatService.CheckUpdateAsync();
            _updateInfos = status.Release;

            if (status.State == DCUpdateCheckState.UpdateAvailable && _updateInfos != null)
            {
                string lastShown = Preferences.Get("LastShowedNewVersion", "-1");
                _updateAvailable = lastShown != _updateInfos.tag_name && lastShown != "-1";
            }

            if (lastKnownVersion != CombatService.GetVersion())
            {
                _newVersion = true;
            }

            // Show the modal if necessary
            if (lastKnownVersion == "-1" || _newVersion || _updateAvailable)
            {
                WelcomeMessageModalRef?.Show();
            }

            StateHasChanged();
        }
    }

    private void HandleWelcomeMessageModalClose(bool result)
    {
        Preferences.Set("LastKnownVersion", CombatService.GetVersion());
        if (_updateInfos != null)
        {
            Preferences.Set("LastShowedNewVersion", _updateInfos.tag_name);
        }
    }

    /// A pinned combat, shown as the same strip the combats explorer uses:
    /// a combat should not look like two different things depending on which
    /// page you are on. Third row is the opposition, on one scrolling line.
    private RenderFragment RenderPinnedCard(DCCombat combat) => __builder =>
    {
        var c = combat;
        var roster = DCCombatRoster.Of(c);
        var players = DCCombatRoster.PlayerCount(c);

        <div class="dc-strip dc-clickable dc-k-npc"
             @onclick="@(() => Navigation.NavigateTo($"/combatmanager/{c.Id}"))">
            <div class="dc-tile">
                <DcIcon Name="shield" Size="24" />
            </div>
            <div class="dc-strip-body">
                <div class="dc-strip-name">@c.Name</div>
                <div class="dc-meta">@MetaOf(c, players)</div>
                @if (roster.Count > 0)
                {
                    <div class="dc-roster">
                        <div class="dc-roster-track">
                            @foreach (var entry in roster)
                            {
                                <span class="dc-mini">
                                    <span class="dc-dot"></span>
                                    @entry.Name
                                    <b>&times;@entry.Count</b>
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    };

    /// The three "nothing here yet" states share one shape.
    private RenderFragment RenderEmptyState(string text, string actionLabel, string route) => __builder =>
    {
        <div class="dc-panel" style="text-align:center;padding:28px 16px;">
            <p class="dc-meta" style="margin:0 0 16px 0;">@text</p>
            @* The one call to action on an otherwise empty section, so it keeps
               the larger size the MudButton had. *@
            <button type="button" class="dc-btn dc-btn-fill" style="min-height:42px;padding:0 20px;font-size:14px;"
                    @onclick="@(() => Navigation.NavigateTo(route))">
                <DcIcon Name="add" Size="18" />
                @actionLabel
            </button>
        </div>
    };

    private string MetaOf(DCCombat combat, int players)
    {
        var parts = new List<string>
        {
            $"{DCCombatRoster.CreatureCount(combat)} {Loc["CreaturesMeta"]}"
        };

        if (players > 0)
        {
            parts.Add($"{players} {Loc["PlayersMeta"]}");
        }

        if (!string.IsNullOrWhiteSpace(combat.Campaign))
        {
            parts.Add(combat.Campaign);
        }

        return string.Join(" · ", parts);
    }
}
