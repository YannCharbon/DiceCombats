@using DiceCombats
@inject DiceCombatsService CombatService
@inject IStringLocalizer<Resources.Localization.CreatureCustomFieldRenderer> Loc

@if (EditionMode)
{
    <div class="dc-fbody dc-fbody-col">
        <div style="display:flex;flex-wrap:wrap;align-items:flex-end;gap:11px;">
            <div class="dc-field">
                <span class="dc-flabel">@Loc["TextGridHorizontal"]</span>
                <div class="dc-step">
                    <button type="button" @onclick="@(() => SetColumns(Field.Columns - 1))">&minus;</button>
                    <input class="dc-num" type="number" min="1" value="@Field.Columns"
                           @onchange="@(e => SetColumns(ParseInt(e.Value, Field.Columns)))" />
                    <button type="button" @onclick="@(() => SetColumns(Field.Columns + 1))">+</button>
                </div>
            </div>
            <div class="dc-field">
                <span class="dc-flabel">@Loc["TextGridVertical"]</span>
                <div class="dc-step">
                    <button type="button" @onclick="@(() => SetRows(Field.Rows - 1))">&minus;</button>
                    <input class="dc-num" type="number" min="1" value="@Field.Rows"
                           @onchange="@(e => SetRows(ParseInt(e.Value, Field.Rows)))" />
                    <button type="button" @onclick="@(() => SetRows(Field.Rows + 1))">+</button>
                </div>
            </div>
            <label class="dc-chk">
                <input type="checkbox" @bind="Field.HasColumnHeaders" />
                @Loc["TextGridColumnLabels"]
            </label>
            <label class="dc-chk">
                <input type="checkbox" @bind="Field.HasRowHeaders" />
                @Loc["TextGridRowLabels"]
            </label>
        </div>

        <div style="overflow-x:auto;width:100%;">
            <table class="dc-gtab" style="min-width:600px;">
                @if (Field.HasColumnHeaders)
                {
                    <tr>
                        @if (Field.HasRowHeaders)
                        {
                            <th class="dc-row">&nbsp;</th>
                        }
                        @foreach (int i in Enumerable.Range(0, Field.ColumnHeaders.Count))
                        {
                            <th>
                                <input class="dc-inp" type="text" style="min-width:100px;"
                                       title="@Loc["TextGridColumnName"]" placeholder="@Loc["TextGridColumnName"]"
                                       @bind="Field.ColumnHeaders[i]" @bind:event="oninput" />
                            </th>
                        }
                    </tr>
                }
                @foreach (int i in Enumerable.Range(0, Field.Rows))
                {
                    <tr>
                        @if (Field.HasRowHeaders)
                        {
                            <th class="dc-row">
                                <input class="dc-inp" type="text" style="min-width:100px;"
                                       title="@Loc["TextGridRowName"]" placeholder="@Loc["TextGridRowName"]"
                                       @bind="Field.RowHeaders[i]" @bind:event="oninput" />
                            </th>
                        }
                        @foreach (int j in Enumerable.Range(0, Field.Columns))
                        {
                            <td style="vertical-align:top;">
                                <div class="dc-opt" style="flex-direction:column;align-items:stretch;gap:5px;">
                                    <label class="dc-chk">
                                        <input type="checkbox" @bind="Field.HasTextLabels[i][j]" />
                                        @Loc["TextGridShowLabel"]
                                    </label>
                                    @if (Field.HasTextLabels[i][j] == true)
                                    {
                                        <div class="dc-field">
                                            <span class="dc-flabel">Label</span>
                                            <input class="dc-inp" type="text" style="min-width:100px;"
                                                   @bind="Field.TextLabels[i][j]" @bind:event="oninput" />
                                        </div>
                                    }
                                    <div class="dc-field">
                                        <span class="dc-flabel">@Field.TextLabels[i][j]</span>
                                        <textarea class="dc-inp dc-gta dc-gcell" rows="1" data-dc-grow="height"
                                                  @bind="Field.TextValues[i][j]" @bind:event="oninput"></textarea>
                                    </div>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </table>
        </div>
    </div>
}
else
{
    <div class="dc-fgrp dc-fgrp-col">
        <span class="dc-flabel">@Field.Title</span>
        <table class="dc-gtab">
            @if (Field.HasColumnHeaders)
            {
                <tr>
                    @if (Field.HasRowHeaders)
                    {
                        <th class="dc-row">&nbsp;</th>
                    }
                    @foreach (int i in Enumerable.Range(0, Field.ColumnHeaders.Count))
                    {
                        <th>@Field.ColumnHeaders[i]</th>
                    }
                </tr>
            }
            @foreach (int i in Enumerable.Range(0, Field.Rows))
            {
                var rowIndex = i;
                <tr>
                    @if (Field.HasRowHeaders)
                    {
                        <th class="dc-row">@Field.RowHeaders[rowIndex]</th>
                    }
                    @foreach (int j in Enumerable.Range(0, Field.Columns))
                    {
                        var columnIndex = j;
                        <td style="vertical-align:top;">
                            @if (Field.HasTextLabels[rowIndex][columnIndex] == true)
                            {
                                <div class="dc-field">
                                    <span class="dc-flabel">@Field.TextLabels[rowIndex][columnIndex]</span>
                                    <textarea class="dc-inp dc-gta dc-gcell" rows="1" data-dc-grow="height" spellcheck="false"
                                              value="@Field.TextValues[rowIndex][columnIndex]"
                                              @oninput="@(e => OnTextValueChanged(rowIndex, columnIndex, e.Value?.ToString() ?? string.Empty))"></textarea>
                                </div>
                            }
                            else
                            {
                                <textarea class="dc-inp dc-gta dc-gcell" rows="1" data-dc-grow="height" spellcheck="false"
                                          value="@Field.TextValues[rowIndex][columnIndex]"
                                          @oninput="@(e => OnTextValueChanged(rowIndex, columnIndex, e.Value?.ToString() ?? string.Empty))"></textarea>
                            }
                        </td>
                    }
                </tr>
            }
        </table>
    </div>
}

@code {
    [Parameter] public DCCreatureTextGridField Field { get; set; } = default!;
    [Parameter] public bool EditionMode { get; set; } = false;
    [Parameter] public EventCallback OnChange { get; set; }
    [Parameter] public EventCallback<CustomFieldChangeInfo> OnFieldChanged { get; set; }

    private static int ParseInt(object? raw, int fallback)
        => int.TryParse(raw?.ToString(), out var parsed) ? parsed : fallback;

    // The stepper draws its own buttons, so the Min="1" the numeric field used
    // to enforce is enforced here instead.
    private void SetRows(int value) => Field.Rows = value < 1 ? 1 : value;

    private void SetColumns(int value) => Field.Columns = value < 1 ? 1 : value;

    private async Task OnTextValueChanged(int rowIndex, int columnIndex, string value)
    {
        var oldValue = Field.TextValues[rowIndex][columnIndex];
        Field.TextValues[rowIndex][columnIndex] = value;

        if (OnFieldChanged.HasDelegate)
        {
            await OnFieldChanged.InvokeAsync(new CustomFieldChangeInfo
            {
                Field = Field,
                OldValue = oldValue,
                NewValue = value,
                Action = "Changed",
                RowIndex = rowIndex,
                RowName = Field.RowHeaders.ElementAtOrDefault(rowIndex),
                ColumnIndex = columnIndex,
                ColumnName = Field.ColumnHeaders.ElementAtOrDefault(columnIndex),
                TextLabel = Field.TextLabels[rowIndex].ElementAtOrDefault(columnIndex)
            });
        }

        if (OnChange.HasDelegate)
            await OnChange.InvokeAsync();
    }
}
