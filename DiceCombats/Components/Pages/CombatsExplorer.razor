@page "/combatsexplorer"
@using System.Text.Json
@inject NavigationManager Navigation
@inject DiceCombatsService CombatService
@inject IFileHandler FileHandler
@inject PopupNotificationService PopupNotificationService
@inject IStringLocalizer<Resources.Localization.CombatsExplorer> Loc

<h1 class="dc-h1">@Loc["CombatsTitle"]</h1>
<p class="dc-sub" style="margin-bottom:18px;">@Loc["CombatsSubtitle"]</p>

<div class="dc-irow dc-irow-wrap" style="gap:10px; margin-bottom:10px;">
    <button type="button" class="dc-btn dc-btn-fill" @onclick="@(() => Navigation.NavigateTo("/combatmanager/new"))">
        <DcIcon Name="add" />
        @Loc["NewCombatBtn"]
    </button>
    <button type="button" class="dc-btn dc-btn-out" @onclick="@(() => ExportAllCombats())" title="@Loc["ExportAllCombatsBtnTitle"]">
        <DcIcon Name="upload" />
        @Loc["ExportAllCombatsBtn"]
    </button>
    <button type="button" class="dc-btn dc-btn-out" @onclick="@(() => ImportCombats())" title="@Loc["ImportCombatsBtnTitle"]">
        <DcIcon Name="download" />
        @Loc["ImportCombatsBtn"]
    </button>
    @* The old MudSwitch, as the house toggle chip: it lights up while the
       per-combat edition buttons are showing. *@
    <button type="button" class="dc-tog @(_showEditionButtons ? "dc-on" : "")"
            aria-pressed="@(_showEditionButtons ? "true" : "false")"
            @onclick="@(() => _showEditionButtons = !_showEditionButtons)">
        <DcIcon Name="tune" Size="14" />
        @Loc["ShowEditonBtnsToggle"]
    </button>
</div>

@* The search box draws its own trailing affordance: the magnifier while it is
   empty, a clear button once there is something to clear. *@
<div class="dc-field" style="max-width:420px; margin-bottom:6px;">
    <label class="dc-flabel" for="combat-search">@Loc["SearchCombat"]</label>
    <span style="position:relative;display:block;">
        <input class="dc-inp" id="combat-search" type="text" spellcheck="false" style="padding-right:34px;"
               value="@_search" @oninput="@(e => _search = e.Value?.ToString() ?? string.Empty)" />
        @if (!string.IsNullOrEmpty(_search))
        {
            <button type="button" class="dc-ib" title="@Loc["CancelBtn"]"
                    style="position:absolute;right:2px;top:50%;transform:translateY(-50%);width:28px;height:28px;"
                    @onclick="@(() => _search = string.Empty)">
                <DcIcon Name="close" Size="14" />
            </button>
        }
        else
        {
            <span style="position:absolute;right:9px;top:50%;transform:translateY(-50%);color:var(--t3);pointer-events:none;">
                <DcIcon Name="search" />
            </span>
        }
    </span>
</div>

@* Where you are in the campaign tree. *@
<div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin:16px 2px 4px 2px;">
    @if (_openCampaign == null)
    {
        <span style="font-size:13px; color:var(--t2);">@Loc["RootCrumb"]</span>
    }
    else
    {
        <span class="dc-crumb" @onclick="CloseCampaign">@Loc["RootCrumb"]</span>
        <span style="color:var(--t4); font-size:13px;">/</span>
        <span style="font-size:13px; color:var(--t2);">@_openCampaign</span>
    }
</div>

@if (_openCampaign == null && !string.IsNullOrWhiteSpace(_search))
{
    @* Searching from the root reaches into the campaigns: the matching combats
       are listed themselves, grouped under the campaign they belong to. *@
    var results = SearchResults();

    <h2 class="dc-h2" style="margin-top:22px;">@Loc["SearchResultsTitle"]</h2>

    if (results.Count == 0)
    {
        <p class="dc-empty">@Loc["NoSearchResult"]</p>
    }

    foreach (var group in results
        .GroupBy(c => string.IsNullOrWhiteSpace(c.Campaign) ? string.Empty : c.Campaign)
        .OrderBy(g => g.Key, StringComparer.CurrentCulture))
    {
        var campaign = group.Key;
        <h2 class="dc-h2" style="margin-top:18px;">
            @if (campaign.Length == 0)
            {
                @Loc["NoCampaignTitle"]
            }
            else
            {
                <span style="cursor:pointer;" @onclick="() => OpenCampaign(campaign)">
                    <DcIcon Name="folder-open" />
                    @campaign
                </span>
            }
        </h2>
        @RenderCombatGrid(group.OrderBy(c => c.Name, StringComparer.CurrentCulture).ToList())
    }
}
else if (_openCampaign == null)
{
    @* Root view: the campaign folders first, then the combats that belong to none. *@
    var campaigns = CombatService.GetCampaigns();
    if (campaigns.Count > 0)
    {
        <h2 class="dc-h2" style="margin-top:22px;">@Loc["CampaignsTitle"]</h2>
        <div class="dc-grid-3">
            @foreach (string campaign in campaigns)
            {
                var name = campaign;
                var count = CombatService.GetCombatsOfCampaign(name).Count;
                @* A campaign keeps the full brand gradient on its tile, so it
                   never reads as a combat whatever the view. *@
                <div class="dc-strip dc-clickable" @onclick="() => OpenCampaign(name)">
                    <div class="dc-icon">
                        <DcIcon Name="folder-open" Size="24" />
                    </div>
                    <div class="dc-strip-body">
                        <div class="dc-strip-name">@name</div>
                        <div class="dc-meta">@count @Loc["CombatsMeta"]</div>
                    </div>
                    <DcIcon Name="chevron-right" Size="20" Class="dc-i-muted" />
                </div>
            }
        </div>
    }

    <h2 class="dc-h2" style="margin-top:22px;">@Loc["LooseCombatsTitle"]</h2>
    @RenderCombats(CombatService.GetCombatList().FindAll(x => string.IsNullOrWhiteSpace(x.Campaign)), Loc["NoCombats"])
}
else
{
    @* Inside a campaign: only its combats, plus the way out and a rename. *@
    <div class="dc-irow dc-irow-wrap" style="gap:10px; margin:10px 0 0 0; align-items:flex-end;">
        <button type="button" class="dc-btn dc-btn-out" @onclick="CloseCampaign">
            <DcIcon Name="arrow-back" />
            @Loc["BackBtn"]
        </button>
        <DcIcon Name="folder-open" Size="20" Class="dc-i-accent" />
        @if (_renamingCampaign)
        {
            @* Sized wrapper: .dc-inp is width:100%, so as a bare flex item it
               would eat the row and shove the confirm/cancel to the far right. *@
            <div class="dc-field" style="width:320px;">
                <label class="dc-flabel" for="campaign-rename">@Loc["CampaignName"]</label>
                <input class="dc-inp" id="campaign-rename" type="text" spellcheck="false"
                       @bind="_campaignRename" @bind:event="oninput" />
            </div>
            <button type="button" class="dc-ib" @onclick="ConfirmRenameCampaign" title="@Loc["RenameCampaignBtn"]">
                <DcIcon Name="check" Class="dc-i-accent" />
            </button>
            <button type="button" class="dc-ib" @onclick="@(() => _renamingCampaign = false)" title="@Loc["CancelBtn"]">
                <DcIcon Name="close" />
            </button>
        }
        else
        {
            <span style="font-size:17px;font-weight:700;color:var(--t1);">@_openCampaign</span>
            <button type="button" class="dc-ib" @onclick="StartRenameCampaign" title="@Loc["RenameCampaignBtn"]">
                <DcIcon Name="edit" />
            </button>
        }
    </div>

    @RenderCombats(VisibleCombats(_openCampaign), Loc["NoCombatsInCampaign"])
}

<DcConfirm @ref="_confirm" Destructive="true" />

@code {
    private DcConfirm? _confirm;

    private bool _showEditionButtons;

    private string _search = string.Empty;

    /// Null = root view (campaign folders + combats with no campaign); otherwise
    /// the campaign whose "folder" the user has entered.
    private string? _openCampaign;

    private bool _renamingCampaign;
    private string _campaignRename = string.Empty;

    private bool MatchesSearch(string text) =>
        string.IsNullOrWhiteSpace(_search) ||
        text.Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase);

    /// Every combat matching the search, campaigns included. A combat also
    /// matches through its campaign name, so searching a campaign lists all
    /// the combats it holds.
    private List<DCCombat> SearchResults()
    {
        return CombatService.GetCombatList()
            .FindAll(x => MatchesSearch(x.Name) ||
                          (!string.IsNullOrWhiteSpace(x.Campaign) && MatchesSearch(x.Campaign)));
    }

    /// Combats of the open campaign, narrowed by the search unless the campaign
    /// name itself is what matched.
    private List<DCCombat> VisibleCombats(string campaign)
    {
        var combats = CombatService.GetCombatsOfCampaign(campaign);
        return MatchesSearch(campaign) ? combats : combats.FindAll(x => MatchesSearch(x.Name));
    }

    private void OpenCampaign(string campaign)
    {
        _openCampaign = campaign;
        _search = string.Empty;
        _renamingCampaign = false;
    }

    private void CloseCampaign()
    {
        _openCampaign = null;
        _search = string.Empty;
        _renamingCampaign = false;
    }

    private void StartRenameCampaign()
    {
        _campaignRename = _openCampaign ?? string.Empty;
        _renamingCampaign = true;
    }

    private void ConfirmRenameCampaign()
    {
        if (_openCampaign == null) return;

        string newName = _campaignRename.Trim();
        if (newName.Length > 0 && newName != _openCampaign)
        {
            CombatService.RenameCampaign(_openCampaign, newName);
            // Stay in the same folder under its new name.
            _openCampaign = newName;
        }

        _renamingCampaign = false;
    }

    /// One letter-grouped card list, used by the root view and inside a campaign.
    private RenderFragment RenderCombats(List<DCCombat> combats, string emptyText) => __builder =>
    {
        if (combats.Count == 0)
        {
            <p class="dc-empty">@(string.IsNullOrWhiteSpace(_search) ? emptyText : Loc["NoSearchResult"])</p>
        }

        foreach (var group in combats
            .GroupBy(c => InitialOf(c.Name))
            .OrderBy(g => g.Key, StringComparer.CurrentCulture))
        {
            <div class="dc-alpha">@group.Key</div>
            @RenderCombatGrid(group.OrderBy(c => c.Name, StringComparer.CurrentCulture).ToList())
        }
    };

    /// The cards themselves, without any grouping of their own.
    private RenderFragment RenderCombatGrid(List<DCCombat> combats) => __builder =>
    {
        <div class="dc-grid-3">
            @foreach (DCCombat combat in combats)
            {
                @RenderCombatStrip(combat)
            }
        </div>
    };

    /// One strip per combat, laid out three-up by .dc-grid-3.
    ///
    /// Third row: the opposition. Two combats that both say "7 creature(s)"
    /// are told apart by what is in them, not by the count, so the roster is
    /// on the entry rather than behind a click. It stays on one line and
    /// scrolls sideways when it does not fit, so every strip in the grid keeps
    /// the same height.
    private RenderFragment RenderCombatStrip(DCCombat combat) => __builder =>
    {
        var c = combat;
        var roster = DCCombatRoster.Of(c);
        var players = DCCombatRoster.PlayerCount(c);

        <div class="dc-strip dc-clickable dc-k-npc"
             @onclick="@(() => Navigation.NavigateTo($"/combatmanager/{c.Id}"))">
            <div class="dc-tile">
                <DcIcon Name="shield" Size="24" />
            </div>
            <div class="dc-strip-body">
                <div class="dc-strip-name">@c.Name</div>
                <div class="dc-meta">@MetaOf(c, players)</div>
                @if (roster.Count > 0)
                {
                    <div class="dc-roster">
                        <div class="dc-roster-track">
                            @foreach (var entry in roster)
                            {
                                <span class="dc-mini">
                                    <span class="dc-dot"></span>
                                    @entry.Name
                                    <b>&times;@entry.Count</b>
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
            <div style="display:flex; gap:2px;" @onclick:stopPropagation="true">
                @RenderCombatActions(c)
            </div>
        </div>
    };

    /// Pin, and the edition buttons when the toolbar switch is on.
    private RenderFragment RenderCombatActions(DCCombat combat) => __builder =>
    {
        var c = combat;
        var isPinned = CombatService.IsCombatPinned(c.Id.ToString());

        @* One mark instead of two icons: solid and accented while the combat
           is pinned, hollow and quiet while it is not. *@
        <button type="button" class="dc-ib" @onclick="() => TogglePinned(c)" title="@Loc["PinnedBtn"]">
            <DcIcon Name="pin" Filled="@isPinned" Class="@(isPinned ? "dc-i-accent" : null)" />
        </button>
        @if (_showEditionButtons)
        {
            <button type="button" class="dc-ib" @onclick="() => Edit(c)" title="@Loc["CombatEditBtn"]">
                <DcIcon Name="edit" />
            </button>
            <button type="button" class="dc-ib" @onclick="() => ExportCombat(c)" title="@Loc["CombatExportBtn"]">
                <DcIcon Name="upload" />
            </button>
            <button type="button" class="dc-ib dc-danger" @onclick="() => DeleteCombat(c)" title="@Loc["CombatDeleteBtn"]">
                <DcIcon Name="delete" Class="dc-i-danger" />
            </button>
        }
    };

    private async Task DeleteCombat(DCCombat combat)
    {
        if (_confirm == null) return;

        bool confirm = await _confirm.AskAsync(
            Loc["DeleteCombatTitle"],
            string.Format(Loc["DeleteCombatQuestion"], combat.Name),
            Loc["DeleteConfirmBtn"], Loc["CancelBtn"]);
        if (!confirm) return;

        CombatService.DeleteCombat(combat);
        CombatService.SaveCombats();

        // The campaign may have just lost its last combat, so its folder is gone.
        if (_openCampaign != null && CombatService.GetCombatsOfCampaign(_openCampaign).Count == 0)
        {
            CloseCampaign();
        }

        StateHasChanged();
    }

    /// Grouping key: the first letter, or "#" for names starting with anything else
    /// (digits, punctuation). The old 'a'..'z' loop silently hid those entries.
    private static string InitialOf(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "#";
        var first = char.ToUpperInvariant(name.TrimStart()[0]);
        return char.IsLetter(first) ? first.ToString() : "#";
    }

    /// The party is counted rather than listed: every combat has roughly the
    /// same party, so listing it would drown out the opposition.
    private string MetaOf(DCCombat combat, int players)
    {
        var parts = new List<string>
        {
            $"{DCCombatRoster.CreatureCount(combat)} {Loc["CreaturesMeta"]}"
        };

        if (players > 0)
        {
            parts.Add($"{players} {Loc["PlayersMeta"]}");
        }

        if (combat.DurationCount > 0)
        {
            parts.Add($"{combat.DurationCount} {Loc["RoundsMeta"]}");
        }

        return string.Join(" · ", parts);
    }

    private void TogglePinned(DCCombat combat)
    {
        var guid = combat.Id.ToString();
        if (CombatService.IsCombatPinned(guid))
        {
            CombatService.RemoveCombatFromPinnedByGUID(guid);
        }
        else
        {
            CombatService.AddCombatToPinnedByGUID(guid);
        }
        StateHasChanged();
    }

    private void Edit(DCCombat combat)
    {
        Navigation.NavigateTo($"/combatmanager/{combat.Id.ToString()}?EditionMode=true");
    }

    private async Task ExportCombat(DCCombat combat)
    {
        var options = new JsonSerializerOptions
            {
                WriteIndented = true,
                DefaultBufferSize = 15 * 1024 * 1024 // 15MiB
            };
        string json = JsonSerializer.Serialize(combat, options);

        var fileName = $"DC_combat_{combat.Name}.json";
        var data = System.Text.Encoding.UTF8.GetBytes(json);

        await FileHandler.SaveFileAsync(fileName, data);

        if (CombatService.IsCurrentCulture("fr"))
        {
            PopupNotificationService.Show("Exportation", $"Combat '{combat.Name}' exporté avec succès", PopupNotificationService.Type.SUCCESS, 3000);
        } else
        {
            PopupNotificationService.Show("Combat export", $"Successfully exported '{combat.Name}'", PopupNotificationService.Type.SUCCESS, 3000);
        }
    }

    private async Task ExportAllCombats()
    {
        var options = new JsonSerializerOptions
            {
                WriteIndented = true,
                DefaultBufferSize = 15 * 1024 * 1024 // 15MiB
            };
        string json = JsonSerializer.Serialize(CombatService.GetCombatList(), options);

        var fileName = $"DC_all_combats.json";
        var data = System.Text.Encoding.UTF8.GetBytes(json);

        await FileHandler.SaveFileAsync(fileName, data);

        if (CombatService.IsCurrentCulture("fr"))
        {
            PopupNotificationService.Show("Exportation", "Tous les combats exportés avec succès", PopupNotificationService.Type.SUCCESS, 3000);
        } else
        {
            PopupNotificationService.Show("Combat export", "Successfully exported all combats", PopupNotificationService.Type.SUCCESS, 3000);
        }
    }

    private async Task ImportCombats()
    {
        var fileData = await FileHandler.LoadFileAsync();
        if (fileData != null)
        {
            string json = System.Text.Encoding.UTF8.GetString(fileData);
            var options = new JsonSerializerOptions
                {
                    DefaultBufferSize = 15 * 1024 * 1024 // 15MiB
                };
            try
            {
                var newCombat = JsonSerializer.Deserialize<DCCombat>(json, options);
                if (newCombat != null)
                {
                    if (newCombat.JsonMitigatorId != DCJsonMitigatorId.COMBAT)
                    {
                        if (CombatService.IsCurrentCulture("fr"))
                        {
                            PopupNotificationService.Show("Importation", "Ce fichier ne contient pas de combat", PopupNotificationService.Type.FAILURE, 4000);
                        }
                        else
                        {
                            PopupNotificationService.Show("Combat import", "This file does not contain combats", PopupNotificationService.Type.FAILURE, 4000);
                        }
                        throw new InvalidDataException("JSON does not contain a combat");
                    }
                    if (CombatService.GetCombatFromGUID(newCombat.Id.ToString()) == null)
                    {
                        CombatService.AddCombat(newCombat);
                        Debug.WriteLine($"Added new combat '{newCombat.Name}'");
                        foreach (DCCreature creature in newCombat.CreaturesList)
                        {
                            if (CombatService.GetCreatureFromGUID(creature.Id.ToString()) == null)
                            {
                                CombatService.AddCreature(creature);
                                Debug.WriteLine($"Add '{creature.Name}' creature");
                            }
                        }

                        if (CombatService.IsCurrentCulture("fr"))
                        {
                            PopupNotificationService.Show("Importation", $"Combat '{newCombat.Name}' importé avec succès", PopupNotificationService.Type.SUCCESS, 3000);
                        } else
                        {
                            PopupNotificationService.Show("Combat import", $"Successfully imported '{newCombat.Name}'", PopupNotificationService.Type.SUCCESS, 3000);
                        }
                    }
                    else
                    {
                        Debug.WriteLine($"The combat '{newCombat.Name}' already exists.");
                    }
                }
            }
            catch (Exception ex)
            {
                Debug.WriteLine(ex.Message);
                try
                {
                    Debug.WriteLine("File does not contain a single creature. Trying a Creature list.");

                    var newCombatList = JsonSerializer.Deserialize<List<DCCombat>>(json, options);

                    if (newCombatList != null)
                    {
                        if (newCombatList.Count > 0 && newCombatList[0].JsonMitigatorId != DCJsonMitigatorId.COMBAT) {
                            if (CombatService.IsCurrentCulture("fr"))
                            {
                                PopupNotificationService.Show("Importation", "Ce fichier ne contient pas de combat", PopupNotificationService.Type.FAILURE, 4000);
                            }
                            else
                            {
                                PopupNotificationService.Show("Combat import", "This file does not contain combats", PopupNotificationService.Type.FAILURE, 4000);
                            }
                            throw new InvalidDataException("JSON does not contain combats");
                        }
                        foreach (DCCombat combat in newCombatList)
                        {
                            if (CombatService.GetCombatFromGUID(combat.Id.ToString()) == null)
                            {
                                CombatService.AddCombat(combat);
                                Debug.WriteLine($"Added new combat '{combat.Name}'");
                                foreach (DCCreature creature in combat.CreaturesList)
                                {
                                    if (CombatService.GetCreatureFromGUID(creature.Id.ToString()) == null)
                                    {
                                        CombatService.AddCreature(creature);
                                        Debug.WriteLine($"Add '{creature.Name}' creature");
                                    }
                                }

                                if (CombatService.IsCurrentCulture("fr"))
                                {
                                    PopupNotificationService.Show("Importation", "Combat(s) importés avec succès", PopupNotificationService.Type.SUCCESS, 3000);
                                } else
                                {
                                    PopupNotificationService.Show("Combat import", "Successfully imported multiple combats", PopupNotificationService.Type.SUCCESS, 3000);
                                }
                            }
                            else
                            {
                                Debug.WriteLine($"The combat '{combat.Name}' already exists.");
                            }
                        }
                    }
                }
                catch (Exception ex1)
                {
                    Debug.WriteLine(ex1.Message);
                    Debug.WriteLine("File does not contain any valid combat.");
                    if (CombatService.IsCurrentCulture("fr"))
                    {
                        PopupNotificationService.Show("Importation", "Le fichier ne contient aucun combat valide", PopupNotificationService.Type.FAILURE, 4000);
                    } else
                    {
                        PopupNotificationService.Show("Combat import", "File does not contain any valid combat", PopupNotificationService.Type.FAILURE, 4000);
                    }
                }
            }
        }
        else
        {
            Debug.WriteLine("File does not contain any data.");
            if (CombatService.IsCurrentCulture("fr"))
            {
                PopupNotificationService.Show("Importation", "Le fichier ne contient aucune donnée", PopupNotificationService.Type.FAILURE, 4000);
            }
            else
            {
                PopupNotificationService.Show("Combat import", "File does not contain any data", PopupNotificationService.Type.FAILURE, 4000);
            }
        }
    }
}