@*
    Settings → Data: backups, then sharing. The data folder section comes
    with its own work (spec §7.1).

    A backup row is a strip, not a table: four columns do not fit a phone.
    The column names stay as hover titles on what they label.
*@

@using DiceCombats.Storage
@inject BackupService Backups
@inject DiceCombatsService CombatService
@inject DiceCombats.Portability.DCBundleService Bundles
@inject DiceCombats.Portability.DCImportFlow ImportFlow
@inject DataFolderService DataFolder
@inject IFileHandler FileHandler
@inject PopupNotificationService PopupNotificationService
@inject StorageNotices Notices
@inject IStringLocalizer<Resources.Localization.Portability> Loc

<div class="dc-panel">
    <div style="display:flex;">
        <div class="dc-pill">
            <DcIcon Name="save" Size="26" />
            <h3>@Loc["DataPanelTitle"]</h3>
        </div>
    </div>

    <div class="dc-strip-name" style="margin-top:14px;">@Loc["BackupsTitle"]</div>
    <p class="dc-meta" style="margin:6px 0 0;">@Loc["BackupsHelp"]</p>

    <div class="dc-irow dc-irow-wrap" style="gap:10px;margin-top:12px;">
        <button type="button" class="dc-btn dc-btn-fill" disabled="@_busy" @onclick="BackUpNow">
            <DcIcon Name="save" /> @Loc["BackupNowBtn"]
        </button>
        <button type="button" class="dc-btn dc-btn-out" disabled="@_busy" @onclick="RestoreFromFile">
            <DcIcon Name="upload-file" /> @Loc["BackupRestoreFromFileBtn"]
        </button>
        <button type="button" class="dc-btn dc-btn-out" disabled="@_busy" @onclick="SaveBackupToFile">
            <DcIcon Name="download" /> @Loc["BackupSaveToFileBtn"]
        </button>
        @if (OperatingSystem.IsWindows())
        {
            <button type="button" class="dc-btn dc-btn-out" @onclick="OpenBackupsFolder">
                <DcIcon Name="folder-open" /> @Loc["BackupOpenFolderBtn"]
            </button>
        }
    </div>

    @* Only the most recent backup shows here; the others are one click away
       in "All backups…", so that the page stays short. *@
    <div class="dc-stack" style="gap:8px;margin-top:12px;">
        @if (_backups == null)
        {
            <span class="dc-meta">…</span>
        }
        else if (_backups.Count == 0)
        {
            <span class="dc-meta">@Loc["BackupListEmpty"]</span>
        }
        else
        {
            <span class="dc-meta">@Loc["BackupLatestLabel"]</span>
            @BackupRow(_backups[0])
            @if (_backups.Count > 1)
            {
                <div>
                    <button type="button" class="dc-btn dc-btn-out dc-btn-sm" @onclick="() => _showAll = true">
                        <DcIcon Name="list" Size="16" /> @Loc["BackupAllBtn"] (@_backups.Count)
                    </button>
                </div>
            }
        }
    </div>

    <div class="dc-strip-name" style="margin-top:18px;">@Loc["SharingTitle"]</div>
    <p class="dc-meta" style="margin:6px 0 0;">@Loc["ExportLibraryHelp"]</p>
    <div class="dc-irow dc-irow-wrap" style="gap:10px;margin-top:12px;">
        <button type="button" class="dc-btn dc-btn-out" disabled="@_busy" @onclick="ExportLibrary">
            <DcIcon Name="upload" /> @Loc["ExportLibraryBtn"]
        </button>
        <button type="button" class="dc-btn dc-btn-out" disabled="@_busy" @onclick="ImportFromFile">
            <DcIcon Name="download" /> @Loc["ImportFromFileBtn"]
        </button>
    </div>

    @* Windows only (workplan §1.3): on Android the data stays on the device,
       and export or a backup saved to a file take it elsewhere. *@
    @if (OperatingSystem.IsWindows())
    {
        <div class="dc-strip-name" style="margin-top:18px;">@Loc["DataFolderTitle"]</div>
        <p class="dc-meta" style="margin:6px 0 0;">@Loc["DataFolderHelp"]</p>
        <div class="dc-note" style="margin-top:10px;">
            @if (Location.IsDefault && !Location.IsDebugOverride)
            {
                <b>@Loc["DataFolderDefault"]</b><br />
            }
            <span style="overflow-wrap:anywhere;">@Location.Root</span>
            @if (Location.IsDebugOverride && Location.IsDefault)
            {
                @(" ")<span>@Loc["DataFolderDebugSuffix"]</span>
            }
        </div>
        @if (_moveProgress != null)
        {
            <p class="dc-meta" style="margin:8px 0 0;">@_moveProgress</p>
        }
        <div class="dc-irow dc-irow-wrap" style="gap:10px;margin-top:12px;">
            <button type="button" class="dc-btn dc-btn-out" disabled="@_busy" @onclick="() => ChangeFolder(null)">
                <DcIcon Name="folder-open" /> @Loc["DataFolderChangeBtn"]
            </button>
            <button type="button" class="dc-btn dc-btn-out" @onclick="() => OpenFolder(Location.Root)">
                <DcIcon Name="launch" /> @Loc["DataFolderOpenBtn"]
            </button>
            @if (!Location.IsDefault)
            {
                <button type="button" class="dc-btn dc-btn-out" disabled="@_busy" @onclick="() => ChangeFolder(Location.DefaultRoot)">
                    <DcIcon Name="restore" /> @Loc["DataFolderResetBtn"]
                </button>
            }
        </div>
        @if (DataFolder.PreviousRoot is string previous && Directory.Exists(previous))
        {
            <div class="dc-note" style="margin-top:12px;">
                @string.Format(Loc["OldCopyNotice"], previous)
                <div style="margin-top:8px;">
                    <button type="button" class="dc-btn dc-btn-danger dc-btn-sm" disabled="@_busy" @onclick="() => DeleteOldCopy(previous)">
                        <DcIcon Name="delete" Size="16" /> @Loc["OldCopyDeleteBtn"]
                    </button>
                </div>
            </div>
        }
    }
</div>

@if (_restartPending)
{
    <div class="dc-confirm-scrim">
        <div class="dc-confirm" role="alertdialog" aria-modal="true">
            <h3 class="dc-confirm-title">@Loc["DataFolderTitle"]</h3>
            <p class="dc-confirm-msg">@Loc["MoveRestartNotice"]</p>
            <div class="dc-confirm-foot">
                <button type="button" class="dc-btn dc-btn-fill" @onclick="RestartNow"><DcIcon Name="sync" /> @Loc["MoveRestartBtn"]</button>
            </div>
        </div>
    </div>
}

@if (_existing != null)
{
    <div class="dc-confirm-scrim">
        <div class="dc-confirm" role="dialog" aria-modal="true" style="width:min(620px,100%);">
            <h3 class="dc-confirm-title">@Loc["ExistingFolderTitle"]</h3>
            <p class="dc-confirm-msg" style="margin-bottom:6px;">
                @string.Format(Loc["ExistingThisComputer"], _existingMine)<br />
                @string.Format(Loc["ExistingThisFolder"], _existingTheirs)
            </p>
            <p class="dc-confirm-msg">@Loc["ExistingFolderText"]</p>
            <div class="dc-stack" style="gap:10px;margin-bottom:14px;">
                <div>
                    <button type="button" class="dc-btn dc-btn-fill" @onclick="UseExisting"><DcIcon Name="check" /> @Loc["ExistingUseFolderBtn"]</button>
                    <div class="dc-meta" style="margin-top:4px;">@Loc["ExistingUseFolderHelp"]</div>
                </div>
                <div>
                    <button type="button" class="dc-btn dc-btn-out" @onclick="ReplaceExisting"><DcIcon Name="upload" /> @Loc["ExistingReplaceBtn"]</button>
                    <div class="dc-meta" style="margin-top:4px;">@Loc["ExistingReplaceHelp"]</div>
                </div>
                <div>
                    <button type="button" class="dc-btn dc-btn-out" @onclick="MergeExisting"><DcIcon Name="sync" /> @Loc["ExistingMergeBtn"]</button>
                    <div class="dc-meta" style="margin-top:4px;">@Loc["ExistingMergeHelp"]</div>
                </div>
            </div>
            <div class="dc-confirm-foot">
                <button type="button" class="dc-btn" @onclick="() => _existing = null">@Loc["WizardCancelBtn"]</button>
            </div>
        </div>
    </div>
}

@if (_showAll && _backups != null)
{
    <div class="dc-confirm-scrim" @onclick="() => _showAll = false">
        <div class="dc-confirm" role="dialog" aria-modal="true" style="width:min(720px,100%);max-height:85vh;display:flex;flex-direction:column;"
             @onclick:stopPropagation="true">
            <h3 class="dc-confirm-title">@Loc["BackupAllTitle"]</h3>
            <div class="dc-stack" style="gap:8px;overflow-y:auto;min-height:0;margin-bottom:14px;">
                @foreach (var backup in _backups)
                {
                    @BackupRow(backup)
                }
            </div>
            <div class="dc-confirm-foot">
                <button type="button" class="dc-btn dc-btn-fill" @onclick="() => _showAll = false">
                    <DcIcon Name="check" /> @Loc["AlertCloseBtn"]
                </button>
            </div>
        </div>
    </div>
}

<DcConfirm @ref="_confirm" />

@code {
    private DataLocation Location => DataFolder.Location;
    private string? _moveProgress;
    private bool _restartPending;
    private string? _existing;
    private string _existingTheirs = "";
    private string _existingMine = "";

    private IReadOnlyList<BackupInfo>? _backups;
    private bool _busy;
    private bool _showAll;

    private RenderFragment BackupRow(BackupInfo backup) => __builder =>
    {
        var b = backup;
        <div class="dc-strip">
            <div class="dc-strip-body">
                <div class="dc-strip-name" title="@Loc["BackupColDate"]">@b.CreatedAtUtc.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</div>
                <div class="dc-meta">
                    <span title="@Loc["BackupColReason"]">@ReasonLabel(b.Reason)</span>
                    &middot;
                    <span title="@Loc["BackupColComputer"]">@b.Machine</span>
                </div>
                <div class="dc-meta" title="@Loc["BackupColContents"]">
                    @(b.Readable ? SummaryText(b.Summary) : Loc["BackupUnreadable"])
                </div>
            </div>
            <button type="button" class="dc-btn dc-btn-out dc-btn-sm" disabled="@(_busy || !b.Readable)" @onclick="() => RestoreFromList(b)">
                <DcIcon Name="restore" Size="16" /> @Loc["BackupRestoreBtn"]
            </button>
        </div>
    };
    private DcConfirm? _confirm;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        try
        {
            _backups = await Backups.ListBackupsAsync();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Debug.WriteLine($"Listing backups failed: {ex.Message}");
            _backups = Array.Empty<BackupInfo>();
        }
    }

    private string ReasonLabel(string reason) => reason switch
    {
        BackupReason.Auto => Loc["BackupReasonAuto"],
        BackupReason.Manual => Loc["BackupReasonManual"],
        BackupReason.BeforeImport => Loc["BackupReasonBeforeImport"],
        BackupReason.BeforeRestore => Loc["BackupReasonBeforeRestore"],
        BackupReason.BeforeMove => Loc["BackupReasonBeforeMove"],
        _ => reason,
    };

    private string SummaryText(IReadOnlyDictionary<string, int>? summary)
    {
        if (summary == null) return string.Empty;
        var parts = new List<string>();
        void Add(string key, string resource)
        {
            if (summary.TryGetValue(key, out int count)) parts.Add(string.Format(Loc[resource], count));
        }
        Add("creatures", "SummaryCreatures");
        Add("combats", "SummaryCombats");
        Add("playerGroups", "SummaryPlayerGroups");
        Add("fieldTemplates", "SummaryFieldTemplates");
        Add("automations", "SummaryAutomations");
        Add("combatLogs", "SummaryCombatLogs");
        return string.Join(" · ", parts);
    }

    private async Task BackUpNow()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Backups.CreateBackupAsync(BackupReason.Manual);
            PopupNotificationService.Show(Loc["BackupsTitle"], Loc["BackupDone"], PopupNotificationService.Type.SUCCESS, 3000);
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"Backup failed: {ex}");
            PopupNotificationService.Show(Loc["BackupsTitle"], string.Format(Loc["BackupFailed"], ex.Message), PopupNotificationService.Type.FAILURE, 6000);
        }
        finally
        {
            _busy = false;
            await RefreshAsync();
        }
    }

    /// A fresh backup of the data as it is now, handed to the save picker: on
    /// Android this is the way to take the data to another device.
    private async Task SaveBackupToFile()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var backup = await Backups.CreateBackupAsync(BackupReason.Manual);
            await RefreshAsync();
            StateHasChanged();

            byte[] bytes = await File.ReadAllBytesAsync(backup.Path);
            if (await FileHandler.SaveFileAsync(backup.FileName, bytes, ".zip", "application/zip", Loc["BackupFileType"]))
            {
                PopupNotificationService.Show(Loc["BackupsTitle"], Loc["ExportDone"], PopupNotificationService.Type.SUCCESS, 3000);
            }
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"Saving a backup to a file failed: {ex}");
            PopupNotificationService.Show(Loc["BackupsTitle"], string.Format(Loc["ExportFailed"], ex.Message), PopupNotificationService.Type.FAILURE, 6000);
        }
        finally
        {
            _busy = false;
        }
    }

    // The import makes a before-import backup: the list is read again after.
    private async Task ImportFromFile()
    {
        await ImportFlow.ImportFromFileAsync();
        await RefreshAsync();
    }

    private async Task ExportLibrary()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            if (await Bundles.ExportLibraryAsync("DC_library.json"))
            {
                PopupNotificationService.Show(Loc["ExportTitle"], Loc["ExportDone"], PopupNotificationService.Type.SUCCESS, 3000);
            }
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"Library export failed: {ex}");
            PopupNotificationService.Show(Loc["ExportTitle"], string.Format(Loc["ExportFailed"], ex.Message), PopupNotificationService.Type.FAILURE, 6000);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RestoreFromList(BackupInfo backup)
    {
        _showAll = false;
        byte[] bytes;
        try
        {
            bytes = await File.ReadAllBytesAsync(backup.Path);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            PopupNotificationService.Show(Loc["BackupsTitle"], Loc["RestoreDamaged"], PopupNotificationService.Type.FAILURE, 6000);
            Debug.WriteLine($"Reading the backup failed: {ex.Message}");
            return;
        }
        await RestoreAsync(bytes);
    }

    private async Task RestoreFromFile()
    {
        if (_busy) return;
        var (_, data) = await FileHandler.PickFileAsync();
        if (data == null || data.Length == 0) return;
        await RestoreAsync(data);
    }

    private async Task RestoreAsync(byte[] zip)
    {
        if (_busy || _confirm == null) return;
        _busy = true;
        try
        {
            var (check, manifest) = await Backups.CheckAsync(zip);
            if (check != BackupCheck.Ok || manifest == null)
            {
                ShowRefusal(check);
                return;
            }

            string date = manifest.CreatedAtUtc.ToLocalTime().ToString("g", CultureInfo.CurrentCulture);
            bool confirmed = await _confirm.AskAsync(Loc["RestoreConfirmTitle"], string.Format(Loc["RestoreConfirmText"], date),
                                                     Loc["RestoreConfirmBtn"], Loc["WizardCancelBtn"]);
            if (!confirmed) return;

            try
            {
                await Backups.RestoreAsync(zip);
                Notices.ReportRestore(true);
            }
            catch (BackupRefusedException refused)
            {
                ShowRefusal(refused.Check);
                return;
            }
            catch (BackupSafetyFailedException safety)
            {
                PopupNotificationService.Show(Loc["BackupsTitle"], string.Format(Loc["BackupFailed"], safety.Message), PopupNotificationService.Type.FAILURE, 6000);
                return;
            }
            catch (BackupRollbackFailedException rollback)
            {
                // The files stay blocked and nothing was read again, so the
                // pages are left as they are; the safety backup is in the list.
                Debug.WriteLine($"Restore and rollback failed: {rollback}");
                Notices.ReportRollbackFailed(rollback.SafetyBackupFileName);
                await RefreshAsync();
                return;
            }
            catch (Exception ex)
            {
                Debug.WriteLine($"Restore failed: {ex}");
                Notices.ReportRestore(false, ex.Message);
            }

            // Every page held objects of the data that was just replaced.
            (Application.Current as App)?.ReloadPages();
        }
        finally
        {
            _busy = false;
        }
    }

    private void ShowRefusal(BackupCheck check)
    {
        string message = check switch
        {
            BackupCheck.WrongApp => Loc["RestoreWrongApp"],
            BackupCheck.NewerVersion => Loc["RestoreNewerVersion"],
            _ => Loc["RestoreDamaged"],
        };
        PopupNotificationService.Show(Loc["BackupsTitle"], message, PopupNotificationService.Type.FAILURE, 6000);
    }

    // ── data folder (Windows) ──────────────────────────────────────────

    /// The chosen folder (or the default one, for "Back to the default
    /// folder") is checked, then the data is moved there, or the folder's
    /// own data is offered.
    private async Task ChangeFolder(string? target)
    {
        if (_busy) return;
        string? folder = target ?? await FileHandler.PickFolderAsync();
        if (folder == null) return;

        var check = DataFolder.CheckTarget(folder);
        string? refusal = check.Check switch
        {
            MoveTargetCheck.NotWritable => Loc["MoveErrorNotWritable"],
            MoveTargetCheck.NoSpace => string.Format(Loc["MoveErrorNoSpace"], Size(check.NeededBytes), Size(check.FreeBytes)),
            MoveTargetCheck.InsideCurrent => Loc["MoveErrorInsideCurrent"],
            MoveTargetCheck.AppData => Loc["MoveErrorAppData"],
            MoveTargetCheck.OtherApp => Loc["MoveErrorOtherApp"],
            MoveTargetCheck.Invalid => string.Format(Loc["StartupInvalidText"], check.Folder),
            _ => null,
        };
        if (refusal != null)
        {
            PopupNotificationService.Show(Loc["DataFolderTitle"], refusal, PopupNotificationService.Type.FAILURE, 8000);
            return;
        }

        if (check.Check == MoveTargetCheck.ExistingLibrary)
        {
            _existingTheirs = Contents(BackupService.SummarizeFolder(check.Folder));
            _existingMine = Contents(BackupService.SummarizeFolder(Location.Root));
            _existing = check.Folder;
            return;
        }

        if (_confirm == null) return;
        string text = string.Format(Loc["MoveConfirmText"], check.Folder);
        if (check.Check == MoveTargetCheck.UseSubfolder) text += " " + string.Format(Loc["MoveSubfolderNote"], check.Folder);
        text += " " + Loc["MoveCloudTip"];
        if (!await _confirm.AskAsync(Loc["MoveConfirmTitle"], text, Loc["MoveConfirmBtn"], Loc["WizardCancelBtn"]))
        {
            DataFolderService.DiscardTarget(check);
            return;
        }

        await RunMoveAsync(progress => DataFolder.MoveAsync(check.Folder, progress));
    }

    private async Task UseExisting()
    {
        string folder = _existing!;
        _existing = null;
        await RunMoveAsync(_ => DataFolder.UseExistingAsync(folder));
    }

    private async Task ReplaceExisting()
    {
        string folder = _existing!;
        _existing = null;
        if (_confirm == null) return;
        if (!await _confirm.AskAsync(Loc["ExistingReplaceBtn"], string.Format(Loc["ReplaceConfirmText"], folder),
                                     Loc["ExistingReplaceBtn"], Loc["WizardCancelBtn"])) return;
        await RunMoveAsync(progress => DataFolder.ReplaceExistingAsync(folder, progress));
    }

    // The folder's library is imported into this computer's data with the
    // import wizard (choices for every conflict); once the import is applied,
    // the result replaces the folder's data, which is backed up first.
    private async Task MergeExisting()
    {
        string folder = _existing!;
        _existing = null;
        byte[] bundle;
        try
        {
            bundle = DataFolderService.ReadFolderAsBundle(folder, CombatService.GetVersion());
        }
        catch (Exception ex)
        {
            PopupNotificationService.Show(Loc["DataFolderTitle"], string.Format(Loc["MoveFailed"], ex.Message, Location.Root), PopupNotificationService.Type.FAILURE, 8000);
            return;
        }
        bool somethingToAdd;
        try
        {
            var session = await Bundles.AnalyseAsync(bundle);
            somethingToAdd = session.Plan.AllItems.Any(i => i.Inserts);
        }
        catch (Exception ex)
        {
            PopupNotificationService.Show(Loc["DataFolderTitle"], string.Format(Loc["MoveFailed"], ex.Message, Location.Root), PopupNotificationService.Type.FAILURE, 8000);
            return;
        }

        if (somethingToAdd)
        {
            if (await ImportFlow.StartAsync(bundle) == null) return;   // cancelled: nothing changes
        }
        else
        {
            // The import would have nothing to do: ask whether to go on.
            if (_confirm == null) return;
            if (!await _confirm.AskAsync(Loc["ExistingMergeBtn"], Loc["MergeNothingNewText"],
                                         Loc["MergeNothingNewBtn"], Loc["WizardCancelBtn"])) return;
        }

        await RunMoveAsync(async progress =>
        {
            await DataFolder.MergeLogsAndPinsFromAsync(folder);
            await DataFolder.ReplaceExistingAsync(folder, progress);
        });
    }

    // Moves, then restarts. A failure leaves everything as it was: the data
    // stays where it is, and the app keeps using it.
    private async Task RunMoveAsync(Func<IProgress<(int Done, int Total)>, Task> move)
    {
        _busy = true;
        var progress = new Progress<(int Done, int Total)>(p =>
        {
            _moveProgress = string.Format(Loc["MoveInProgress"], p.Done, p.Total);
            InvokeAsync(StateHasChanged);
        });
        try
        {
            _moveProgress = string.Format(Loc["MoveInProgress"], 0, "…");
            StateHasChanged();
            var started = DateTime.UtcNow;
            await move(progress);

            // A short copy still shows its progress for a moment; the last
            // line stays under the notice.
            var shown = DateTime.UtcNow - started;
            if (shown < TimeSpan.FromSeconds(1.5)) await Task.Delay(TimeSpan.FromSeconds(1.5) - shown);
            _restartPending = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"Moving the data failed: {ex}");
            _moveProgress = null;
            PopupNotificationService.Show(Loc["DataFolderTitle"], string.Format(Loc["MoveFailed"], ex.Message, Location.Root), PopupNotificationService.Type.FAILURE, 10000);
            _busy = false;
        }
    }

    private void RestartNow()
    {
        DataFolder.ReleaseFolder();
        (Application.Current as App)?.Restart();
    }

    private async Task DeleteOldCopy(string previous)
    {
        if (_confirm == null) return;
        if (!await _confirm.AskAsync(Loc["OldCopyDeleteBtn"], string.Format(Loc["OldCopyDeleteConfirm"], previous),
                                     Loc["OldCopyDeleteBtn"], Loc["WizardCancelBtn"])) return;
        try
        {
            DataFolder.DeleteOldCopy();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            PopupNotificationService.Show(Loc["DataFolderTitle"], ex.Message, PopupNotificationService.Type.FAILURE, 8000);
        }
    }

    private string Contents(IReadOnlyDictionary<string, int> summary) => SummaryText(summary);

    private static string Size(long bytes) => bytes >= 1024 * 1024 * 1024
        ? (bytes / (1024d * 1024 * 1024)).ToString("0.0", CultureInfo.CurrentCulture) + " GB"
        : (bytes / (1024d * 1024)).ToString("0.0", CultureInfo.CurrentCulture) + " MB";

    private static void OpenFolder(string folder)
    {
        try
        {
            Process.Start(new ProcessStartInfo("explorer.exe", $"\"{folder}\"") { UseShellExecute = true });
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"Opening the folder failed: {ex.Message}");
        }
    }

    private void OpenBackupsFolder()
    {
        try
        {
            Directory.CreateDirectory(Backups.BackupsDir);
            Process.Start(new ProcessStartInfo("explorer.exe", $"\"{Backups.BackupsDir}\"") { UseShellExecute = true });
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"Opening the backups folder failed: {ex.Message}");
        }
    }
}
