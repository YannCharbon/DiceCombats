@page "/creaturesexplorer/"

@using System.Text.Json
@inject DiceCombatsService CombatService
@inject NavigationManager Navigation
@inject IFileHandler FileHandler
@inject PopupNotificationService PopupNotificationService
@inject IDialogService DialogService
@inject IStringLocalizer<Resources.Localization.CreaturesExplorer> Loc

<style>
    /* Card list with the same anatomy as the DiceAudio scenes catalogue, teal/green theme. */
    .dc-card {
        border-radius: 12px;
        background: #12201d;
        border: 1px solid #24463f;
        padding: 16px 18px;
        display: flex;
        align-items: center;
        gap: 14px;
        transition: box-shadow 0.2s, border-color 0.2s;
    }

        .dc-card:hover {
            box-shadow: 0 4px 16px rgba(255,255,255,0.08);
            border-color: #3c7a6c;
        }

    .dc-card-clickable {
        cursor: pointer;
    }

    .dc-icon {
        width: 52px;
        height: 52px;
        border-radius: 10px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(-45deg, rgba(85,197,109,0.35), rgba(50,200,126,0.45), rgba(0,170,170,0.55), rgba(35,170,128,0.65));
    }

    .dc-body {
        flex: 1;
        min-width: 0;
    }

    .dc-name {
        font-weight: bold;
        font-size: 15px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .dc-meta {
        font-size: 12px;
        color: grey;
    }

    .dc-cat-header {
        font-size: 15px;
        font-weight: bold;
        color: #33bbb0;
        border-bottom: 1px solid #24463f;
        padding: 14px 4px 4px 4px;
        margin: 4px 2px;
    }

    .dc-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 10px;
        margin: 10px 2px 6px 2px;
    }

    .dc-empty {
        color: grey;
        padding: 20px;
    }
</style>

<h3>@Loc["ExplorerTitle"]</h3>
<MudText Typo="Typo.body2" Style="color:grey; margin-bottom:14px;">
    @Loc["ExplorerSubtitle"]
</MudText>

<MudStack Row="true" Wrap="Wrap.Wrap" Style="gap:10px; margin-bottom:10px;">
    <MudButton OnClick="@(() => Navigation.NavigateTo("/newcreature"))" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="@Color.Primary">@Loc["NewCreatureBtn"]</MudButton>
    <MudButton OnClick="@(() => ExportAllCreatures())" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Upload" Color="@Color.Primary">@Loc["ExportCreaturesBtn"]</MudButton>
    <MudButton OnClick="@(() => ImportCreatures())" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" Color="@Color.Primary">@Loc["ImportCreaturesBtn"]</MudButton>
    <MudButton OnClick="@(() => PlayerGroupsModalRef?.Show())" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Groups2" Color="@Color.Primary">@Loc["PlayerGroupsBtn"]</MudButton>
</MudStack>

<div style="max-width:420px; margin-bottom:6px;">
    <MudTextField T="string" Immediate="true" Value="@_search" ValueChanged="@((string v) => _search = v)"
                  Label="@Loc["SearchCreature"]" Variant="Variant.Outlined" Clearable="true"
                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" />
</div>

@RenderCreatureSection(false, Loc["CreaturesTitle"], Loc["NoCreatures"], Icons.Material.Filled.Pets)
@RenderCreatureSection(true, Loc["PlayersTitle"], Loc["NoPlayers"], Icons.Material.Filled.Person)

<GenericModal TContent="PlayerGroupsEditor" @ref="PlayerGroupsModalRef" OnClose="OnPlayerGroupsModalClose">
    <PlayerGroupsEditor />
</GenericModal>

@code {
    private GenericModal<PlayerGroupsEditor>? PlayerGroupsModalRef;

    private string _search = string.Empty;

    /// Case-insensitive substring match on the name, like the selector's search.
    private bool Matches(DCCreature creature) =>
        string.IsNullOrWhiteSpace(_search) ||
        creature.Name.Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase);

    private void OnPlayerGroupsModalClose(bool result) => StateHasChanged();

    /// Both sections (monsters/NPCs and player characters) share the exact same
    /// card anatomy; only the filter, heading and icon differ.
    private RenderFragment RenderCreatureSection(bool isPlayer, string title, string emptyText, string icon) => __builder =>
    {
        var creatures = CombatService.GetCreatureList().Where(x => x.IsPlayer == isPlayer && Matches(x)).ToList();

        <div class="dc-cat-header" style="font-size:28px;">@title</div>

        if (creatures.Count == 0)
        {
            <p class="dc-empty">@(string.IsNullOrWhiteSpace(_search) ? emptyText : Loc["NoSearchResult"])</p>
        }

        foreach (var group in creatures
            .GroupBy(c => InitialOf(c.Name))
            .OrderBy(g => g.Key, StringComparer.CurrentCulture))
        {
            <div class="dc-cat-header">@group.Key</div>
            <div class="dc-grid">
                @foreach (var creature in group.OrderBy(c => c.Name, StringComparer.CurrentCulture))
                {
                    var c = creature;
                    <div class="dc-card dc-card-clickable" @onclick="() => Edit(c)">
                        <div class="dc-icon">
                            <MudIcon Icon="@icon" />
                        </div>
                        <div class="dc-body">
                            <div class="dc-name">@c.Name</div>
                            <div class="dc-meta">@MetaOf(c)</div>
                        </div>
                        <div @onclick:stopPropagation="true">
                            <MudIconButton OnClick="() => Edit(c)" Icon="@Icons.Material.Filled.Edit" title="@Loc["EditCreatureBtn"]" />
                            <MudIconButton OnClick="() => ExportCreature(c)" Icon="@Icons.Material.Filled.Upload" title="@Loc["ExportCreatureBtn"]" />
                            <MudIconButton OnClick="() => DeleteCreature(c)" Icon="@Icons.Material.Filled.Delete" Color="@Color.Error" title="@Loc["DeleteCreatureBtn"]" />
                        </div>
                    </div>
                }
            </div>
        }
    };

    /// Grouping key: the first letter, or "#" for names starting with anything else
    /// (digits, punctuation). The old 'a'..'z' loop silently hid those entries.
    private static string InitialOf(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "#";
        var first = char.ToUpperInvariant(name.TrimStart()[0]);
        return char.IsLetter(first) ? first.ToString() : "#";
    }

    private string MetaOf(DCCreature creature)
    {
        var parts = new List<string>
        {
            $"{creature.CustomFields.Count} {Loc["FieldsMeta"]}"
        };

        return string.Join(" · ", parts);
    }

    private void Edit(DCCreature creature)
    {
        Navigation.NavigateTo($"/creaturemanager/{creature.Id.ToString()}");
    }

    private async Task DeleteCreature(DCCreature creature)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            Loc["DeleteCreatureTitle"],
            string.Format(Loc["DeleteCreatureQuestion"], creature.Name),
            yesText: Loc["DeleteConfirmBtn"], cancelText: Loc["CancelBtn"]);
        if (confirm != true) return;

        CombatService.DeleteCreature(creature);
        CombatService.SaveCreatures();
        StateHasChanged();
    }

    private async Task ExportCreature(DCCreature creature)
    {
        var options = new JsonSerializerOptions
            {
                WriteIndented = true,
                DefaultBufferSize = 15 * 1024 * 1024 // 15MiB
            };
        string json = JsonSerializer.Serialize(creature, options);

        var fileName = $"DC_creature_{creature.Name}.json";
        var data = System.Text.Encoding.UTF8.GetBytes(json);

        await FileHandler.SaveFileAsync(fileName, data);

        if (CombatService.IsCurrentCulture("fr"))
        {
            PopupNotificationService.Show("Exportation", $"Créature '{creature.Name}' exportée avec succès", PopupNotificationService.Type.SUCCESS, 3000);
        } else {
            PopupNotificationService.Show("Creature export", $"Successfully exported '{creature.Name}'", PopupNotificationService.Type.SUCCESS, 3000);
        }
    }

    private async Task ExportAllCreatures()
    {
        var options = new JsonSerializerOptions
            {
                WriteIndented = true,
                DefaultBufferSize = 15 * 1024 * 1024 // 15MiB
            };
        string json = JsonSerializer.Serialize(CombatService.GetCreatureList(), options);

        var fileName = $"DC_all_creatures.json";
        var data = System.Text.Encoding.UTF8.GetBytes(json);

        await FileHandler.SaveFileAsync(fileName, data);

        if (CombatService.IsCurrentCulture("fr"))
        {
            PopupNotificationService.Show("Exportation", $"Toutes les créatures exportées avec succès", PopupNotificationService.Type.SUCCESS, 3000);
        } else
        {
            PopupNotificationService.Show("Creature export", "Successfully exported all creatures", PopupNotificationService.Type.SUCCESS, 3000);
        }
    }

    private async Task ImportCreatures()
    {
        var fileData = await FileHandler.LoadFileAsync();
        if (fileData != null)
        {
            string json = System.Text.Encoding.UTF8.GetString(fileData);
            var options = new JsonSerializerOptions
                {
                    DefaultBufferSize = 15 * 1024 * 1024 // 15MiB
                };
            try
            {
                var newCreature = JsonSerializer.Deserialize<DCCreature>(json, options);
                if (newCreature != null)
                {
                    if (newCreature.JsonMitigatorId != DCJsonMitigatorId.CREATURE)
                    {
                        if (CombatService.IsCurrentCulture("fr"))
                        {
                            PopupNotificationService.Show("Importation", "Ce fichier ne contient pas de créature", PopupNotificationService.Type.FAILURE, 4000);
                        }
                        else
                        {
                            PopupNotificationService.Show("Combat import", "This file does not contain creatures", PopupNotificationService.Type.FAILURE, 4000);
                        }
                        throw new InvalidDataException("JSON does not contain a creature");
                    }
                    if (CombatService.GetCreatureFromGUID(newCreature.Id.ToString()) == null)
                    {
                        CombatService.AddCreature(newCreature);
                        Debug.WriteLine($"Added new creature '{newCreature.Name}'");
                    }
                    else
                    {
                        Debug.WriteLine($"The creature '{newCreature.Name}' already exists.");
                    }

                    if (CombatService.IsCurrentCulture("fr"))
                    {
                        PopupNotificationService.Show("Importation", $"Créature '{newCreature.Name}' importée avec succès", PopupNotificationService.Type.SUCCESS, 3000);
                    }
                    else {
                        PopupNotificationService.Show("Creature import", $"Successfully imported {newCreature.Name}", PopupNotificationService.Type.SUCCESS, 3000);
                    }
                }
            }
            catch
            {
                try
                {
                    Debug.WriteLine("File does not contain a single creature. Trying a Creature list.");

                    var newCreatureList = JsonSerializer.Deserialize<List<DCCreature>>(json, options);

                    if (newCreatureList != null)
                    {
                        if (newCreatureList.Count > 0 && newCreatureList[0].JsonMitigatorId != DCJsonMitigatorId.CREATURE)
                        {
                            if (CombatService.IsCurrentCulture("fr"))
                            {
                                PopupNotificationService.Show("Importation", "Ce fichier ne contient pas de créature", PopupNotificationService.Type.FAILURE, 4000);
                            }
                            else
                            {
                                PopupNotificationService.Show("Combat import", "This file does not contain creatures", PopupNotificationService.Type.FAILURE, 4000);
                            }
                            throw new InvalidDataException("JSON does not contain creatues");
                        }
                        foreach (DCCreature creature in newCreatureList)
                        {
                            if (CombatService.GetCreatureFromGUID(creature.Id.ToString()) == null)
                            {
                                CombatService.AddCreature(creature);
                                Debug.WriteLine($"Added new creature '{creature.Name}'");
                            }
                            else
                            {
                                Debug.WriteLine($"The creature '{creature.Name}' already exists.");
                            }
                        }
                        if (CombatService.IsCurrentCulture("fr"))
                        {
                            PopupNotificationService.Show("Importation", $"Créature(s) importée(s) avec succès", PopupNotificationService.Type.SUCCESS, 3000);
                        } else
                        {
                            PopupNotificationService.Show("Creature import", "Successfully imported multiple creatures", PopupNotificationService.Type.SUCCESS, 3000);
                        }
                    }
                }
                catch
                {
                    Debug.WriteLine("File does not contain any valid creature.");
                    if (CombatService.IsCurrentCulture("fr"))
                    {
                        PopupNotificationService.Show("Importation", $"Le fichier ne contient aucune créature valide", PopupNotificationService.Type.FAILURE, 4000);
                    }
                    else {
                        PopupNotificationService.Show("Creature import", "File does not contain any valid creature", PopupNotificationService.Type.FAILURE, 4000);
                    }
                }
            }
        }
        else
        {
            Debug.WriteLine("File does not contain any data.");
            if (CombatService.IsCurrentCulture("fr"))
            {
                PopupNotificationService.Show("Importation", $"Le fichier ne contient aucune donnée", PopupNotificationService.Type.FAILURE, 4000);
            }
            else {
                PopupNotificationService.Show("Creature import", "File does not contain any data", PopupNotificationService.Type.FAILURE, 4000);
            }
        }
    }
}
