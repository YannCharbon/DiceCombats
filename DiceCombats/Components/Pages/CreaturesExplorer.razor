@page "/creaturesexplorer/"

@using System.Text.Json
@inject DiceCombatsService CombatService
@inject NavigationManager Navigation
@inject IFileHandler FileHandler
@inject PopupNotificationService PopupNotificationService
@inject DiceCombats.Portability.DCBundleService Bundles
@inject DiceCombats.Portability.DCImportFlow ImportFlow
@inject IStringLocalizer<Resources.Localization.Portability> PLoc
@inject IStringLocalizer<Resources.Localization.CreaturesExplorer> Loc

<h1 class="dc-h1">@Loc["ExplorerTitle"]</h1>
<p class="dc-sub" style="margin-bottom:18px;">@Loc["ExplorerSubtitle"]</p>

<div class="dc-irow dc-irow-wrap" style="gap:10px; margin-bottom:10px;">
    <button type="button" class="dc-btn dc-btn-fill" @onclick="@(() => Navigation.NavigateTo("/newcreature"))">
        <DcIcon Name="add" />
        @Loc["NewCreatureBtn"]
    </button>
    <button type="button" class="dc-btn dc-btn-out" @onclick="@(() => ExportAllCreatures())" title="@Loc["ExportCreaturesBtnTitle"]">
        <DcIcon Name="upload" />
        @Loc["ExportCreaturesBtn"]
    </button>
    <button type="button" class="dc-btn dc-btn-out" @onclick="@(() => ImportCreatures())" title="@Loc["ImportCreaturesBtnTitle"]">
        <DcIcon Name="download" />
        @PLoc["ImportFromFileBtn"]
    </button>
    <button type="button" class="dc-btn dc-btn-out" @onclick="@(() => PlayerGroupsModalRef?.Show())">
        <DcIcon Name="groups" />
        @Loc["PlayerGroupsBtn"]
    </button>
</div>

@* The search box draws its own trailing affordance: the magnifier while it is
   empty, a clear button once there is something to clear. *@
<div class="dc-field" style="max-width:420px; margin-bottom:6px;">
    <label class="dc-flabel" for="creature-search">@Loc["SearchCreature"]</label>
    <span style="position:relative;display:block;">
        <input class="dc-inp" id="creature-search" type="text" spellcheck="false" style="padding-right:34px;"
               value="@_search" @oninput="@(e => _search = e.Value?.ToString() ?? string.Empty)" />
        @if (!string.IsNullOrEmpty(_search))
        {
            <button type="button" class="dc-ib" title="@Loc["CancelBtn"]"
                    style="position:absolute;right:2px;top:50%;transform:translateY(-50%);width:28px;height:28px;"
                    @onclick="@(() => _search = string.Empty)">
                <DcIcon Name="close" Size="14" />
            </button>
        }
        else
        {
            <span style="position:absolute;right:9px;top:50%;transform:translateY(-50%);color:var(--t3);pointer-events:none;">
                <DcIcon Name="search" />
            </span>
        }
    </span>
</div>

@* How many of each kind are listed below. *@
<div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin:16px 2px 4px 2px;">
    <span style="font-size:13px; color:var(--t2);">@CountLabel()</span>
</div>

@RenderCreatureSection(false, Loc["CreaturesTitle"], Loc["NoCreatures"], "pets")
@RenderCreatureSection(true, Loc["PlayersTitle"], Loc["NoPlayers"], "person")

<GenericModal TContent="PlayerGroupsEditor" @ref="PlayerGroupsModalRef" OnClose="OnPlayerGroupsModalClose">
    <PlayerGroupsEditor />
</GenericModal>

<DcConfirm @ref="_confirm" Destructive="true" />

@code {
    private GenericModal<PlayerGroupsEditor>? PlayerGroupsModalRef;

    private DcConfirm? _confirm;

    private string _search = string.Empty;

    /// Counted separately, because "41 creatures" while four of them are
    /// players contradicts the two sections right below it.
    private string CountLabel()
    {
        var shown = CombatService.GetCreatureList().Where(Matches).ToList();
        int players = shown.Count(c => c.IsPlayer);
        int creatures = shown.Count - players;

        var parts = new List<string> { $"{creatures} {Loc["CreaturesCountLabel"]}" };
        if (players > 0)
        {
            parts.Add($"{players} {Loc["PlayersMeta"]}");
        }

        return string.Join(" \u00b7 ", parts);
    }

    /// Case-insensitive substring match on the name, like the selector's search.
    private bool Matches(DCCreature creature) =>
        string.IsNullOrWhiteSpace(_search) ||
        creature.Name.Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase);

    private void OnPlayerGroupsModalClose(bool result) => StateHasChanged();

    /// Both sections (monsters/NPCs and player characters) share the exact same
    /// card anatomy; only the filter, heading and icon differ. `icon` is a
    /// DcIcon name.
    private RenderFragment RenderCreatureSection(bool isPlayer, string title, string emptyText, string icon) => __builder =>
    {
        var creatures = CombatService.GetCreatureList().Where(x => x.IsPlayer == isPlayer && Matches(x)).ToList();

        <h2 class="dc-h2" style="margin-top:22px;">@title</h2>

        if (creatures.Count == 0)
        {
            <p class="dc-empty">@(string.IsNullOrWhiteSpace(_search) ? emptyText : Loc["NoSearchResult"])</p>
        }

        foreach (var group in creatures
            .GroupBy(c => InitialOf(c.Name))
            .OrderBy(g => g.Key, StringComparer.CurrentCulture))
        {
            <div class="dc-alpha">@group.Key</div>
            <div class="dc-grid-3">
                @foreach (var creature in group.OrderBy(c => c.Name, StringComparer.CurrentCulture))
                {
                    @RenderCreatureStrip(creature, isPlayer, icon)
                }
            </div>
        }
    };

    /// One strip per creature, laid out three-up by .dc-grid-3. Not a
    /// full-width row - the grid is what makes a long library readable.
    private RenderFragment RenderCreatureStrip(DCCreature creature, bool isPlayer, string icon) => __builder =>
    {
        var c = creature;

        <div class="dc-strip dc-clickable @KindClass(isPlayer)" @onclick="() => Edit(c)">
            <div class="dc-tile">
                <DcIcon Name="@icon" Size="24" />
            </div>
            <div class="dc-strip-body">
                <div class="dc-strip-name">@c.Name</div>
                <div class="dc-meta">@MetaOf(c)</div>
            </div>
            <div style="display:flex; gap:2px;" @onclick:stopPropagation="true">
                @RenderCreatureActions(c)
            </div>
        </div>
    };

    /// Edit / export / delete.
    private RenderFragment RenderCreatureActions(DCCreature creature) => __builder =>
    {
        var c = creature;

        <button type="button" class="dc-ib" @onclick="() => Edit(c)" title="@Loc["EditCreatureBtn"]">
            <DcIcon Name="edit" />
        </button>
        <button type="button" class="dc-ib" @onclick="() => ExportCreature(c)" title="@Loc["ExportCreatureBtn"]">
            <DcIcon Name="upload" />
        </button>
        <button type="button" class="dc-ib dc-danger" @onclick="() => DeleteCreature(c)" title="@Loc["DeleteCreatureBtn"]">
            <DcIcon Name="delete" Class="dc-i-danger" />
        </button>
    };

    private static string KindClass(bool isPlayer) => isPlayer ? "dc-k-pc" : "dc-k-npc";

    /// Grouping key: the first letter, or "#" for names starting with anything else
    /// (digits, punctuation). The old 'a'..'z' loop silently hid those entries.
    private static string InitialOf(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "#";
        var first = char.ToUpperInvariant(name.TrimStart()[0]);
        return char.IsLetter(first) ? first.ToString() : "#";
    }

    private string MetaOf(DCCreature creature)
    {
        var parts = new List<string>
        {
            $"{creature.CustomFields.Count} {Loc["FieldsMeta"]}"
        };

        return string.Join(" · ", parts);
    }

    private void Edit(DCCreature creature)
    {
        Navigation.NavigateTo($"/creaturemanager/{creature.Id.ToString()}");
    }

    private async Task DeleteCreature(DCCreature creature)
    {
        if (_confirm == null) return;

        bool confirm = await _confirm.AskAsync(
            Loc["DeleteCreatureTitle"],
            string.Format(Loc["DeleteCreatureQuestion"], creature.Name),
            Loc["DeleteConfirmBtn"], Loc["CancelBtn"]);
        if (!confirm) return;

        CombatService.DeleteCreature(creature);
        CombatService.SaveCreatures();
        StateHasChanged();
    }

    private Task ExportCreature(DCCreature creature) =>
        ExportAsync(() => Bundles.ExportCreaturesAsync(new[] { creature }, $"DC_creature_{creature.Name}.json"));

    private Task ExportAllCreatures() =>
        ExportAsync(() => Bundles.ExportCreaturesAsync(CombatService.GetCreatureList(), "DC_all_creatures.json"));

    private Task ImportCreatures() => ImportFromFileAsync();

    // Export and import go through the bundle format (spec §2.2): a bundle or
    // any older DiceCombats export reads back. A cancelled file dialog says
    // nothing.
    private async Task ExportAsync(Func<Task<bool>> export)
    {
        try
        {
            if (await export())
            {
                PopupNotificationService.Show(PLoc["ExportTitle"], PLoc["ExportDone"], PopupNotificationService.Type.SUCCESS, 3000);
            }
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"Export failed: {ex}");
            PopupNotificationService.Show(PLoc["ExportTitle"], string.Format(PLoc["ExportFailed"], ex.Message), PopupNotificationService.Type.FAILURE, 6000);
        }
    }

    // Any DiceCombats file, through the import wizard; the list is drawn
    // again once the wizard is closed.
    private async Task ImportFromFileAsync()
    {
        await ImportFlow.ImportFromFileAsync();
        StateHasChanged();
    }
}
