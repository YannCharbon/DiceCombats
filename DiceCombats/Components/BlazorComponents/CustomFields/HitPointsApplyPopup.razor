@using DiceCombats
@inject IStringLocalizer<Resources.Localization.CreatureCustomFieldRenderer> Loc

<style>
    /* Outside the equation, so it takes a line of its own at the foot of
       .dc-hptotal. Violet to match the maximum-reduction section head: this note
       is what that control did. */
    .hp-max-note {
        flex: 0 0 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-top: 2px;
        padding-top: 9px;
        border-top: 1px solid var(--b1);
        color: #B39DDB;
        font-size: 13px;
    }

    /* A term of the equation carries an icon next to its number, and the bold
       element holding it is inline by default, so without this the icon would
       sit on the text baseline.
       (Written without an angle-bracket tag name on purpose: Razor parses the
       contents of a style block as markup and would read one as a real tag.) */
    .hp-eq {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }
</style>

<h4 style="text-align:center;margin-bottom:10px;">@Field.Title</h4>

@* ---------------- The calculation, first ---------------- *@
@* One line, read left to right: current, every applied term, result. *@
<div class="dc-hptotal" style="margin-bottom:12px;">
    <div class="dc-hpterm">
        <b class="hp-eq">@Field.CurrentHP<small>/ @Field.EffectiveMaximumHP</small></b>
    </div>

    @foreach (var line in _damageLines.Where(x => x.Amount > 0))
    {
        var l = line;
        var kind = Field.GetKind(l.Kind);
        var rule = string.IsNullOrEmpty(l.Kind) ? null : Field.ResolveRule(l.Kind, l.Tags);
        <span class="dc-hpop">−</span>
        <div class="dc-hpterm">
            <b class="hp-eq" style="@($"color:{(kind == null ? "#e57373" : kind.Color)};")">
                @if (kind != null)
                {
                    <DcIcon Name="@kind.Icon" Size="20" />
                }
                @MitigatedAmount(l)
            </b>
            @if (rule != null && MitigatedAmount(l) != l.Amount)
            {
                <span>@rule.Name<br />@FormulaFor(l)</span>
            }
        </div>
    }

    @if (TemporaryAbsorbed > 0)
    {
        <span class="dc-hpop">+</span>
        <div class="dc-hpterm">
            <b class="hp-eq" style="color:var(--a3);">
                <DcIcon Name="shield" Size="20" />@TemporaryAbsorbed
            </b>
            <span>@Loc["HPCalcAbsorbed"]</span>
        </div>
    }

    @if (_heal > 0)
    {
        <span class="dc-hpop">+</span>
        <div class="dc-hpterm">
            <b class="hp-eq" style="color:#66bb6a;">
                <DcIcon Name="add" Size="20" />@_heal
            </b>
            <span>@Loc["HPHeal"]</span>
        </div>
    }

    <span class="dc-hpop">=</span>
    <div class="dc-hpterm">
        <b class="hp-eq" style="@($"color:{ResultColor};")">@PreviewCurrentHP<small>/ @PreviewMaximum</small></b>
        @if (PreviewTemporaryHP > 0)
        {
            <span style="color:var(--a3);">+@PreviewTemporaryHP @Loc["HPTemporaryShort"]</span>
        }
    </div>

    @* Outside the equation: this moves the ceiling, the denominator above, not
       the current hit points. *@
    @if (_maximumReduction > 0)
    {
        <div class="hp-max-note">
            <DcIcon Name="remove" Size="16" />
            @Loc["HPMaxReductionLabel"] : @Field.MaximumHP − @_maximumReduction = @PreviewMaximum
        </div>
    }
</div>

@* ---------------- Damage ---------------- *@
<div class="dc-msec" style="margin-bottom:12px;">
    <div class="dc-msec-head">
        @* Dark red needs white ink; .dc-msec-title's default ink is the near-black
           one that reads on the accent green. *@
        <span class="dc-msec-title" style="background-color:#8B2C3B;color:#FFFFFF;">
            <DcIcon Name="remove" Size="16" />@Loc["HPDamage"]
        </span>
        <button type="button" class="dc-btn dc-btn-out" @onclick="AddLine">
            <DcIcon Name="add" Size="16" />@Loc["HPAddLine"]
        </button>
    </div>

    @* Who gets credited. Defaults to whoever holds the initiative, which is
       right most of the time and leaves the common case at zero clicks. *@
    @if (SourceContext != null && SourceContext.Candidates.Count > 0)
    {
        <div class="dc-irow dc-irow-wrap" style="margin-bottom:8px;">
            <span class="dc-flabel">@Loc["HPSource"]</span>
            <div class="dc-kstrip">
                @foreach (var candidate in SourceContext.Candidates)
                {
                    var c = candidate;
                    <button type="button" class="dc-kchip @(_sourceName == c.Name ? "dc-on" : "")"
                            style="background-color:@(c.IsPlayer ? "#00695C" : "var(--s5)");color:#FFFFFF;"
                            @onclick="() => _sourceName = c.Name">
                        @if (c.IsPlayer)
                        {
                            <DcIcon Name="person" Size="14" />
                        }
                        @c.Name
                    </button>
                }
                <button type="button" class="dc-kchip @(string.IsNullOrEmpty(_sourceName) ? "dc-on" : "")"
                        style="background-color:var(--b2);color:#FFFFFF;"
                        @onclick="() => _sourceName = string.Empty">
                    @Loc["HPNoSource"]
                </button>
            </div>
        </div>
    }

    @foreach (var line in _damageLines)
    {
        var l = line;
        <div class="dc-hpline">
            <div class="dc-irow dc-irow-wrap">
                <div class="dc-field">
                    <span class="dc-flabel">@Loc["HPAmount"]</span>
                    <div class="dc-step">
                        <button type="button" @onclick="@(() => StepAmount(l, -1))">&minus;</button>
                        <input type="number" class="dc-num" min="0" value="@l.Amount"
                               @oninput="@((ChangeEventArgs e) => SetAmount(l, e.Value?.ToString()))" />
                        <button type="button" @onclick="@(() => StepAmount(l, 1))">+</button>
                    </div>
                </div>

                @if (Field.DamageKinds.Count > 0)
                {
                    @* Once a kind is picked the rest fold away; clicking the
                       picked one again brings them back. *@
                    <div class="dc-kstrip">
                        @foreach (var kind in Field.DamageKinds)
                        {
                            var k = kind;
                            @if (l.KindsExpanded || l.Kind == k.Name)
                            {
                                <button type="button" class="dc-kchip @(l.Kind == k.Name ? "dc-on" : "")"
                                        style="@($"background-color:{k.Color};color:{k.TextColor};")"
                                        @onclick="() => SelectKind(l, k.Name)">
                                    <DcIcon Name="@k.Icon" Size="14" />
                                    @k.Name
                                </button>
                            }
                        }
                        @if (l.KindsExpanded)
                        {
                            <button type="button" class="dc-kchip @(string.IsNullOrEmpty(l.Kind) ? "dc-on" : "")"
                                    style="background-color:var(--b2);color:#FFFFFF;"
                                    @onclick="() => SelectKind(l, string.Empty)">
                                @Loc["HPNoKind"]
                            </button>
                        }
                        else
                        {
                            <span class="dc-flabel" style="align-self:center;">@Loc["HPChangeKind"]</span>
                        }
                    </div>
                }

                <button type="button" class="dc-ib dc-danger" style="margin-left:auto;"
                        title="@Loc["HPRemoveLine"]" aria-label="@Loc["HPRemoveLine"]" @onclick="() => RemoveLine(l)">
                    <DcIcon Name="delete" Size="16" />
                </button>
            </div>

            @* Shown whenever the system has tags, kind selected or not. *@
            @if (Field.Tags.Count > 0)
            {
                <div class="dc-irow dc-irow-wrap" style="margin-top:6px;gap:5px;">
                    <span class="dc-flabel">@Loc["HPTagsTitle"]</span>
                    @foreach (string tag in Field.Tags)
                    {
                        var t = tag;
                        <button type="button" class="dc-kchip @(l.Tags.Contains(t) ? "dc-on" : "")"
                                style="background-color:#4A5A7A;color:#FFFFFF;"
                                @onclick="() => ToggleTag(l, t, !l.Tags.Contains(t))">
                            @t
                        </button>
                    }
                </div>
            }
        </div>
    }
</div>

@* ------- Heal, temporary hit points, maximum reduction, side by side -------
   One number each, so they sit side by side instead of stacking three near
   empty rows. *@
<div class="dc-mgrid3">
    <div class="dc-msec">
        <div class="dc-msec-head">
            <span class="dc-msec-title" style="background-color:var(--a3);">
                <DcIcon Name="add" Size="16" />@Loc["HPHeal"]
            </span>
            <div class="dc-field">
                <span class="dc-flabel">@Loc["HPAmount"]</span>
                <div class="dc-step">
                    <button type="button" @onclick="@(() => StepHeal(-1))">&minus;</button>
                    <input type="number" class="dc-num" min="0" value="@_heal"
                           @oninput="@((ChangeEventArgs e) => _heal = ParseAmount(e.Value?.ToString()))" />
                    <button type="button" @onclick="@(() => StepHeal(1))">+</button>
                </div>
            </div>
        </div>
        <p class="dc-msec-help" style="margin-bottom:0;">@Loc["HPHealHint"]</p>
    </div>

    <div class="dc-msec">
        <div class="dc-msec-head">
            <span class="dc-msec-title" style="background-color:var(--a3);">
                <DcIcon Name="shield" Size="16" />@Loc["HPTemporary"]
            </span>
            <div class="dc-field">
                <span class="dc-flabel">@Loc["HPAmount"]</span>
                <div class="dc-step">
                    <button type="button" @onclick="@(() => StepTemporary(-1))">&minus;</button>
                    <input type="number" class="dc-num" min="0" value="@_temporary"
                           @oninput="@((ChangeEventArgs e) => _temporary = ParseAmount(e.Value?.ToString()))" />
                    <button type="button" @onclick="@(() => StepTemporary(1))">+</button>
                </div>
            </div>
        </div>
        <p class="dc-msec-help" style="margin-bottom:0;">@Loc["HPTemporaryHint"]</p>
    </div>

    <div class="dc-msec">
        <div class="dc-msec-head">
            @* Violet, white ink: the near-black default would vanish on it. *@
            <span class="dc-msec-title" style="background-color:#6A4C93;color:#FFFFFF;">
                <DcIcon Name="remove" Size="16" />@Loc["HPMaxReductionLabel"]
            </span>
            <div class="dc-field">
                <span class="dc-flabel">@Loc["HPAmount"]</span>
                <div class="dc-step">
                    <button type="button" @onclick="@(() => StepMaximumReduction(-1))">&minus;</button>
                    <input type="number" class="dc-num" min="0" value="@_maximumReduction"
                           @oninput="@((ChangeEventArgs e) => _maximumReduction = ParseAmount(e.Value?.ToString()))" />
                    <button type="button" @onclick="@(() => StepMaximumReduction(1))">+</button>
                </div>
            </div>
        </div>
        <p class="dc-msec-help" style="margin-bottom:0;">@Loc["HPMaxReductionHint"]</p>
    </div>
</div>

<p class="dc-msec-help" style="text-align:center;margin:8px 0 0;">@Loc["HPApplyHint"]</p>

@code {
    [Parameter] public DCCreatureHitPointsField Field { get; set; } = default!;
    [Parameter] public EventCallback<CustomFieldChangeInfo> OnApplied { get; set; }
    [CascadingParameter] public DCDamageSourceContext? SourceContext { get; set; }

    private string _sourceName = string.Empty;
    private string _lastSuggestedSource = string.Empty;

    private class DamageLine
    {
        public int Amount { get; set; } = 0;
        public string Kind { get; set; } = string.Empty;
        public List<string> Tags { get; set; } = new List<string>();
        // Whether the kinds other than the picked one are on screen.
        public bool KindsExpanded { get; set; } = true;
    }

    private List<DamageLine> _damageLines = new List<DamageLine>();
    private int _heal = 0;
    private int _temporary = 0;
    private int _maximumReduction = 0;

    protected override void OnInitialized()
    {
        Reset();
        base.OnInitialized();
    }

    /// <summary>
    /// Brings the staging area back to what the field currently holds. Called
    /// when the popup opens and once an attack has been applied, so a reopened
    /// popup never shows the lines of the previous one.
    /// </summary>
    public void Reset()
    {
        _damageLines.Clear();
        AddLine();
        _heal = 0;
        _temporary = (int)Field.TemporaryHP;
        _maximumReduction = (int)Field.MaximumHPReduction;
        _lastSuggestedSource = SourceContext?.SuggestedSource ?? string.Empty;
        _sourceName = _lastSuggestedSource;
    }

    /// The source follows the initiative as it moves. A pick made by hand is kept
    /// as long as the initiative stays on the same creature.
    protected override void OnParametersSet()
    {
        string suggested = SourceContext?.SuggestedSource ?? string.Empty;
        if (suggested != _lastSuggestedSource)
        {
            _lastSuggestedSource = suggested;
            _sourceName = suggested;
        }

        base.OnParametersSet();
    }

    private void AddLine()
    {
        // A new line keeps the previous kind, so entering several hits of the
        // same kind does not mean picking it again every time.
        var previous = _damageLines.LastOrDefault();
        _damageLines.Add(new DamageLine { Kind = previous?.Kind ?? string.Empty });
    }

    private void RemoveLine(DamageLine line)
    {
        _damageLines.Remove(line);
        if (_damageLines.Count == 0) AddLine();
    }

    /// Every box in this popup is a count, so a half-typed or emptied box reads
    /// as zero and never as a negative number.
    private static int ParseAmount(string? text)
        => int.TryParse(text, out int value) ? Math.Max(0, value) : 0;

    private void SetAmount(DamageLine line, string? text)
    {
        line.Amount = ParseAmount(text);
    }

    private static void StepAmount(DamageLine line, int delta)
    {
        line.Amount = Math.Max(0, line.Amount + delta);
    }

    private void StepHeal(int delta) => _heal = Math.Max(0, _heal + delta);

    private void StepTemporary(int delta) => _temporary = Math.Max(0, _temporary + delta);

    private void StepMaximumReduction(int delta) => _maximumReduction = Math.Max(0, _maximumReduction + delta);

    private void SelectKind(DamageLine line, string kind)
    {
        // Clicking the kind already picked reopens the list rather than
        // reselecting the same thing.
        if (line.Kind == kind && !string.IsNullOrEmpty(kind))
        {
            line.KindsExpanded = !line.KindsExpanded;
            return;
        }

        line.Kind = kind;
        if (string.IsNullOrEmpty(kind))
        {
            line.Tags.Clear();
            line.KindsExpanded = true;
        }
        else
        {
            line.KindsExpanded = false;
        }
    }

    private void ToggleTag(DamageLine line, string tag, bool selected)
    {
        if (selected)
        {
            if (!line.Tags.Contains(tag)) line.Tags.Add(tag);
        }
        else
        {
            line.Tags.Remove(tag);
        }
    }

    private int MitigatedAmount(DamageLine line)
    {
        if (string.IsNullOrEmpty(line.Kind)) return line.Amount;
        var rule = Field.ResolveRule(line.Kind, line.Tags);
        return rule == null ? line.Amount : rule.Apply(line.Amount);
    }

    /// Spells out the arithmetic of one line, e.g. "38 × 0.5 − 2 = 17".
    private string FormulaFor(DamageLine line)
    {
        var rule = string.IsNullOrEmpty(line.Kind) ? null : Field.ResolveRule(line.Kind, line.Tags);
        if (rule == null) return line.Amount.ToString();

        string formula = line.Amount.ToString();
        if (rule.Factor != 1.0) formula += $" × {rule.Factor}";
        if (rule.FlatReduction != 0) formula += $" − {rule.FlatReduction}";
        return $"{formula} = {rule.Apply(line.Amount)}";
    }

    private int TotalDamage => _damageLines.Sum(x => MitigatedAmount(x));

    private uint StagedTemporary => (uint)Math.Max(0, _temporary);

    private int TemporaryAbsorbed => (int)Math.Min(StagedTemporary, (uint)Math.Max(0, TotalDamage));

    private uint PreviewTemporaryHP => StagedTemporary - (uint)TemporaryAbsorbed;

    private int PreviewMaximum => Math.Max(0, (int)Field.MaximumHP - Math.Max(0, _maximumReduction));

    private int PreviewCurrentHP
    {
        get
        {
            int result = Field.CurrentHP - (TotalDamage - TemporaryAbsorbed);
            if (!Field.AllowNegative) result = Math.Max(0, result);
            return Math.Min(PreviewMaximum, result + Math.Max(0, _heal));
        }
    }

    private string ResultColor
    {
        get
        {
            if (PreviewCurrentHP < Field.CurrentHP) return "#e57373";
            if (PreviewCurrentHP > Field.CurrentHP) return "#66bb6a";
            return "white";
        }
    }

    /// <summary>
    /// Commits everything staged as a single change, so one undo takes the whole
    /// attack back.
    /// </summary>
    public async Task ApplyAsync()
    {
        bool changed = TotalDamage > 0 || _heal > 0
            || StagedTemporary != Field.TemporaryHP
            || Math.Max(0, _maximumReduction) != (int)Field.MaximumHPReduction;
        if (!changed)
        {
            Reset();
            return;
        }

        int oldValue = Field.CurrentHP;
        Field.SaveUndo();

        Field.TemporaryHP = StagedTemporary;
        Field.MaximumHPReduction = (uint)Math.Max(0, _maximumReduction);

        uint absorbed = Field.ApplyDamage(TotalDamage);
        Field.ApplyHeal(Math.Max(0, _heal));

        var kinds = _damageLines.Where(x => x.Amount > 0 && !string.IsNullOrEmpty(x.Kind)).Select(x => x.Kind).Distinct().ToList();

        var info = new CustomFieldChangeInfo
        {
            Field = Field,
            OldValue = oldValue,
            NewValue = Field.CurrentHP,
            Action = "CurrentChanged",
            ChangeDirection = Field.CurrentHP > oldValue ? "Increased" : (Field.CurrentHP < oldValue ? "Decreased" : "Unchanged"),
            SourceName = _sourceName,
            // Picked here, so the statistics can tell it apart from a guess.
            SourceInferred = false,
            SourceIsPlayer = SourceContext?.IsPlayer(_sourceName) ?? false,
            DamageLines = _damageLines
                .Where(x => x.Amount > 0)
                .Select(x => new DCDamageLineInfo
                {
                    Kind = x.Kind,
                    RuleName = Field.ResolveRule(x.Kind, x.Tags)?.Name ?? string.Empty,
                    RawAmount = x.Amount,
                    AppliedAmount = MitigatedAmount(x),
                    Tags = new List<string>(x.Tags)
                })
                .ToList()
        };
        info.Data["damageKinds"] = kinds.Count > 0 ? string.Join(", ", kinds) : null;
        info.Data["rawDamage"] = _damageLines.Sum(x => x.Amount);
        info.Data["appliedDamage"] = TotalDamage;
        info.Data["appliedHeal"] = Math.Max(0, _heal);
        info.Data["temporaryAbsorbed"] = (int)absorbed;

        Reset();

        if (OnApplied.HasDelegate)
            await OnApplied.InvokeAsync(info);
    }
}
