@page "/combatmanager/{CombatGuid}"
@using System.Timers

@inject DiceCombatsService CombatService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<Resources.Localization.CombatManager> Loc
@inject DiceCombats.Automations.IDiceEventPublisher EventPublisher
@inject DiceCombats.Automations.CombatLogService CombatLog
@inject IDialogService DialogService

<style>
    .CombatEditorFloatingInitiativeWindow {
    position: fixed;
    bottom: 50px;
    right: 10px;
    width: 450px;
    background-color: #303030;
    border: 1px solid #505050;
    border-radius: 10px;
    box-shadow: 0 2px 10px rgba(255, 255, 255, 0.1);
    padding: 10px;
    z-index: 1000;
    max-height: 450px;
    overflow-y: scroll;
    overflow-x: hidden;
    zoom: 0.85;
    }

    @@media screen and (max-width: 768px) {
    .CombatEditorFloatingInitiativeWindow {
    width: calc(100% - 1rem);
    max-height: 350px;
    }
    }

    .CombatEditorCreatureLayout {
    background-color: #303030;
    box-shadow: 0 2px 10px rgba(255, 255, 255, 0.1);
    border: 1px solid #505050;
    padding: 5px;
    border-radius: 10px;
    }

    .CombatEditorCustomFieldsLayout {
    box-shadow: 0 2px 10px rgba(255, 255, 255, 0.1);
    border: 1px solid #505050;
    padding: 5px;
    border-radius: 10px;
    }

    .NotesLabel label {
    background-color: #004D40;
    color: white;
    padding: 2px;
    border-radius: 4px;
    }

    .markdown-content {
    color: white;
    }

    .markdown-content table,
    .markdown-content th,
    .markdown-content td {
    border: 1px solid white;
    padding: 5px;
    }

    .markdown-content th,
    .markdown-content td {
    background-color: #004D40;
    }


    .masonry-layout {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem; /* Space between items */
    }

    .masonry-item {
    display: block;
    width: calc(50% - 1rem); /* Adjust width for 3 items per row */
    margin-bottom: 1rem;
    /* Masonry places items with left/top. A transform here would turn the card into
    the containing block of every position:fixed descendant - which is how the
    detailed popup modal ended up thrown off the right edge of the screen. */
    transform: none !important;
    }

    @@media screen and (max-width: 768px) {
    .masonry-item {
    width: calc(100% - 1rem); /* Adjust for smaller screens */
    }
    }

    @@media screen and (max-width: 480px) {
    .masonry-item {
    width: 100%; /* Single column for narrow screens */
    }
    }

    .play-pause-stop-button {
    border-radius: 30px;
    border-width: 2px;
    border-color: var(--mud-palette-primary);
    color: var(--mud-palette-primary);
    padding: 3px;
    cursor: pointer;
    }

    .current-initiative-creature {
        background: linear-gradient( -45deg, #8a8a8a 0%, /* dark cyan-ish */
        #005f5f 50%, /* dark grey */
        #8a8a8a 100% /* back to dark cyan-ish */
        );
        background-size: 200% 200%;
        animation: gradient 8s ease-in-out infinite;
        padding: 5px;
    }

    @@keyframes gradient {
    0% {
    background-position: 0% 50%;
    }

    50% {
    background-position: 100% 50%;
    }

    100% {
    background-position: 0% 50%; /* same as 0% → no jump */
    }
    }

    #markdown-rendered-div a:link {
        color: #00B0B0;
    }

    .combat-recording {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background-color: #4E1414;
        border: 1px solid #A03030;
        border-radius: 30px;
        padding: 2px 10px;
        font-size: 0.85rem;
        color: #FFB0B0;
    }

    .combat-recording-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background-color: #E04545;
        animation: combat-recording-blink 1.6s ease-in-out infinite;
    }

    @@keyframes combat-recording-blink {
        0% { opacity: 1; }
        50% { opacity: 0.25; }
        100% { opacity: 1; }
    }

</style>

<script>
    // Fingerprint of everything the layout depends on, so a render that changed
    // nothing does not trigger a relayout.
    window.dcMasonrySignature = window.dcMasonrySignature || function (grid, itemSelector) {
    const items = grid.querySelectorAll(itemSelector);
    let sig = grid.clientWidth + ':' + items.length;
    for (let i = 0; i < items.length; i++) {
    sig += '|' + items[i].offsetHeight;
    }
    return sig;
    };

    window.initializeMasonry = (selector) => {
    const grid = document.querySelector(selector);
    if (!grid) {
    return;
    }
    // Called after every render: relayout the instance the element already has
    // instead of stacking a new one (and another resize listener) on top of it.
    if (grid.dcMasonry) {
    const signature = window.dcMasonrySignature(grid, '.masonry-item');
    if (signature === grid.dcMasonrySignatureValue) {
    return;
    }
    grid.dcMasonrySignatureValue = signature;
    grid.dcMasonry.reloadItems();
    grid.dcMasonry.layout();
    return;
    }
    grid.dcMasonry = new Masonry(grid, {
    itemSelector: '.masonry-item',
    columnWidth: '.masonry-item',
    percentPosition: true,
    gutter: 10,
    // Never animate. Outlayer animates a move by putting a transform on each item
    // for the duration of the transition, and a transformed element becomes the
    // containing block for its position:fixed descendants. The detailed popup modal
    // is rendered inside a creature card, so every animated relayout re-anchored it
    // to that card - it jumped to the right, overflowed the screen, then snapped
    // back when the transition ended. Only the first layout was ever instant, which
    // is why this appeared once instances started being reused across renders.
    transitionDuration: 0
    });
    grid.dcMasonrySignatureValue = window.dcMasonrySignature(grid, '.masonry-item');
    };
</script>

<GenericModal TContent="CreaturesSelector" OnClose="HandleCreaturesSelectorModalClose" @ref="CreaturesSelectorModalRef">
    <CreaturesSelector Combat="_combat" />
</GenericModal>

<div class="CombatEditorFloatingInitiativeWindow">
    <MudGrid Style="padding:10px;">
        <MudItem><h3>@Loc["InitiativeTitle"]</h3></MudItem>
        @if (_initiativeWindowsMaximized)
        {
            <MudItem><MudIcon @onclick="SortCreaturesInitiativeRankByRoll" Icon="@Icons.Material.Filled.Sort" Title="@Loc["InitiativeSort"]" Style="cursor:pointer;background-color:darkcyan;border-radius:5px;" Size="@Size.Large"></MudIcon></MudItem>
            <MudItem><MudIcon @onclick="CreaturesInitiativeReset" Icon="@Icons.Material.Filled.Sync" Title="@Loc["InitiativeReset"]" Style="cursor:pointer;background-color:darkcyan;border-radius:5px;" Size="@Size.Large"></MudIcon></MudItem>
            <MudItem><MudIcon @onclick="MoveToNextCreatureInInitiative" Icon="@Icons.Material.Filled.KeyboardDoubleArrowRight" Title="@Loc["InitiativeNext"]" Style="cursor:pointer;background-color:darkcyan;border-radius:5px;" Size="@Size.Large"></MudIcon></MudItem>
            <MudItem sm="2"><MudIcon @onclick="() => _initiativeWindowsMaximized = false" Icon="@Icons.Material.Filled.ArrowCircleDown" Title="@Loc["InitiativeMinimize"]" Style="cursor:pointer;" Size="@Size.Large"></MudIcon></MudItem>
        }
        else
        {
            <MudItem sm="2"><MudIcon @onclick="() => _initiativeWindowsMaximized = true" Icon="@Icons.Material.Filled.ArrowCircleUp" Title="@Loc["InitiativeMaximize"]" Style="cursor:pointer;" Size="@Size.Large"></MudIcon></MudItem>
        }
    </MudGrid>

    @if (_initiativeWindowsMaximized)
    {
        <table>
            <tr style="border-bottom:solid; border-bottom-width:1px;">
                <th>@Loc["InitiativeCreature"]</th>
                <th>@Loc["InitiativeRoll"]</th>
                <th>@Loc["InitiativeOrder"]</th>
                <th>@Loc["InitiativeQuickLink"]</th>
            </tr>
            @foreach (DCCreature creature in _initiativeWindowCreatureListCopy)
            {
                <tr style="border-bottom:solid; border-bottom-width:1px;"
                class="@(creature.Name == _currentInitiativeCreature.Name ? "current-initiative-creature" : "")">
                    <td style="width:240px;padding:5px;">@creature.Name</td>
                    <td style="width:60px;padding:5px;"><MudNumericField T="int" Style="color:#A0A0A0;" @bind-Value="creature.InitiativeRoll"></MudNumericField></td>
                    <td style="width:60px;padding:5px;"><MudNumericField T="int" Style="color:white;font-weight:bold;font-size:16pt" @bind-Value="creature.InitiativeRank"></MudNumericField></td>
                    <td style="width:120px;padding:5px;">
                        <a style="cursor:pointer;border-radius:30px;padding:5px;background-color:darkcyan;" onclick="@($"scrollToElementById('{creature.Id.ToString()}')")">@Loc["InitiativeQuickLinkBtn"]</a>
                    </td>
                </tr>
            }
        </table>
    }
</div>

<div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:start; padding-bottom:5px;">
    <MudStack Row="true" Style="padding-bottom:20px;" Wrap="Wrap.Wrap">
        <MudStack Row="true">
            <h1>@_combat.Name</h1>
            <MudButton OnClick="() => CreaturesSelectorModalRef?.Show()" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit" IconColor="Color.Primary" Size="Size.Large">@Loc["EditBtn"]</MudButton>
        </MudStack>
    </MudStack>
    <MudStack Row="true" AlignItems="AlignItems.Center">
        @if (_timer.Enabled)
        {
            <MudIcon Class="play-pause-stop-button" Size="Size.Large" @onclick="PauseTimer" Icon="@Icons.Material.Filled.Pause" Title="@Loc["PauseBtn"]" />
        }
        else
        {
            <MudIcon Class="play-pause-stop-button" Size="Size.Large" @onclick="StartTimer" Icon="@Icons.Material.Filled.PlayArrow" Title="@Loc["PlayBtn"]" />
        }
        <MudIcon Class="play-pause-stop-button" Size="Size.Large" @onclick="StopTimer" Icon="@Icons.Material.Filled.Stop" Title="@Loc["StopBtn"]" />
        <MudItem Style="font-size: large;">@GetDurationAsString()</MudItem>
        @if (CombatLog.IsRecording)
        {
            <MudItem>
                <span class="combat-recording">
                    <span class="combat-recording-dot"></span>
                    @Loc["LogRecording"] @string.Format(Loc["LogRound"], CombatLog.CurrentRound)
                </span>
            </MudItem>
        }
        <MudButton OnClick="OpenCombatLogModal" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Dvr" Color="@Color.Primary">@Loc["LogBtn"]</MudButton>
    </MudStack>
</div>

<GenericModal TContent="CombatLogPopup" @ref="CombatLogModalRef">
    <CombatLogPopup Combat="_combat" />
</GenericModal>


<div style="margin-top:5px;margin-bottom:10px;">
    <MudTextField Sizing="InputSizing.Auto" spellcheck="false" @bind-Value="_combat.Notes" Label="@Loc["NotesTb"]" Class="NotesLabel" Variant="Variant.Outlined"></MudTextField>
</div>

<CascadingValue Value="@BuildDamageSourceContext()" IsFixed="false">
<div id="masonry-layout" class="masonry-layout">
    @foreach (DCCreature creature in _combat.CreaturesList)
    {
        <div class="masonry-item">
            <div class="@(creature.Name == _currentInitiativeCreature.Name ? "current-initiative-creature-border" : "CombatEditorCreatureLayout")"
                style="padding:8px;">
                <div style="background-color:#303030; padding: 4px; border-radius: 5px;">
                    <div id="@creature.Id.ToString()">
                        @if (creature.ImageSheetBas64 != string.Empty)
                        {
                            <h1>@creature.Name</h1>
                            <img src="@creature.ImageSheetBas64" height="500px" />
                        }
                        else if (creature.HtmlSheet != string.Empty)
                        {
                            <div style="color:black" class="@SheetLinkClass(creature)">
                                @((MarkupString)creature.HtmlSheet)
                            </div>
                        }
                        else if (creature.MarkdownSheet != string.Empty)
                        {
                            <div id="markdown-rendered-div" class="markdown-content @SheetLinkClass(creature)">
                                @((MarkupString)creature.GetMarkdownSheetAsHtml())
                            </div>
                        }
                        else if (creature.IsPlayer)
                        {
                            <h1>@creature.Name</h1>
                        }
                        else if (creature.IsManual)
                        {
                            <h1>@creature.Name</h1>
                        }
                        else
                        {
                            <p>Could not render creature sheet</p>
                        }
                    </div>
                    @{
                        // Prepare data for rendering
                        var allInstanceCustomFields = _combat.GetCreatureInstancesCustomFields(creature);
                        var sharedFields = allInstanceCustomFields.First()
                            .Where(x => x.SharedAcrossCreatureInstances)
                            .ToList();
                        var nonSharedFields = allInstanceCustomFields.First()
                            .Where(x => !x.SharedAcrossCreatureInstances)
                            .ToList();
                    }

                    <div style="padding:10px;">
                        @* Render shared fields (once for all instances) *@
                        @if (sharedFields.Any())
                        {
                            <div class="CombatEditorCustomFieldsLayout" style="border-color:#F9F9F9;padding:10px;border-radius:10px;border-width:2px;margin:10px;box-shadow: 0 2px 10px #FFFFFF;">
                                <div class="d-flex flex-wrap gap-2" style="align-items:center;">
                                    @foreach (var field in sharedFields)
                                    {
                                        <div>
                                            <MudPaper Class="d-flex align-center justify-center" Style="padding:5px;">
                                                <CreatureCustomFieldRenderer Field="field" EditionMode="false" OnChange="OnCustomFieldChanged" OnFieldChanged="@(info => OnCustomFieldChanged(creature, 0, info))" />
                                            </MudPaper>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (nonSharedFields.Count > 0)
                        {
                            @* Render non-shared fields for each creature instance *@
                            var creatureInstancesCustomFields = _combat.GetCreatureInstancesCustomFields(creature);

                            @for (int instanceIndex = 0; instanceIndex < creatureInstancesCustomFields.Count; instanceIndex++)
                            {
                                var capturedInstanceIndex = instanceIndex;
                                var instanceCustomFields = creatureInstancesCustomFields[instanceIndex];

                                <div class="CombatEditorCustomFieldsLayout" style="@($"border-color:{instanceCustomFields.Find(x => x is DCCreatureColorField)?.GetValue() ?? "#F9F9F9"};padding:10px;border-radius:10px;border-width:2px;margin:10px;box-shadow: 0 2px 10px {instanceCustomFields.Find(x => x is DCCreatureColorField)?.GetValue() ?? "#FFFFFF"};")">
                                    <div class="d-flex flex-wrap gap-2" style="align-items:center;">
                                        @foreach (DCCreatureCustomField field in instanceCustomFields)
                                        {
                                            if (field.SharedAcrossCreatureInstances == false)
                                            {
                                                <div>
                                                    <MudPaper Class="d-flex align-center justify-center" Style="padding:5px;">
                                                        <CreatureCustomFieldRenderer Field="field"
                                                                                     EditionMode="false"
                                                                                     OnChange="OnCustomFieldChanged"
                                                                                     OnFieldChanged="@(info => OnCustomFieldChanged(creature, capturedInstanceIndex, info))" />
                                                    </MudPaper>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
</CascadingValue>
<div style="height:450px">
    <!--Some margin-->
</div>


@code {
    [Parameter]
    public string CombatGuid { get; set; } = "new";

    private DCCombat _combat = new DCCombat("New combat");

    private List<DCCreature> _initiativeWindowCreatureListCopy = new List<DCCreature>();

    private GenericModal<CreaturesSelector>? CreaturesSelectorModalRef;
    private GenericModal<CombatLogPopup>? CombatLogModalRef;

    private bool _initiativeWindowsMaximized = true;

    private System.Timers.Timer _timer = new System.Timers.Timer(1000);

    private DCCreature _currentInitiativeCreature = new DCCreature("Default");

    protected override void OnInitialized()
    {
        Debug.WriteLine(CombatGuid);
        if (CombatGuid != "new")
        {
            var combat = CombatService.GetCombatList().Find(x => x.Id.ToString() == CombatGuid);
            if (combat != null)
            {
                _combat = combat;
            }
            else
            {
                _combat = new DCCombat("New combat");
            }
        }

        _initiativeWindowCreatureListCopy = _combat.CreaturesList.ToList();

        _ = SortCreaturesInitiativeRankByRoll();

        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JSRuntime.InvokeVoidAsync("initializeMasonry", "#masonry-layout");
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if (firstRender && _combat.CreaturesList.Count == 0)
        {
            // New combat so we directly go to edition mode
            CreaturesSelectorModalRef?.Show();
        }
    }

    private Task OnCustomFieldChanged()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }


    private async Task OnCustomFieldChanged(DCCreature creature, int instanceIndex, CustomFieldChangeInfo info)
    {
        StateHasChanged();

        foreach (var diceEvent in DiceCombats.Automations.CustomFieldEventFactory.CreateCustomFieldEvents(_combat, creature, instanceIndex, info))
        {
            await EventPublisher.PublishAsync(diceEvent);
        }
    }

    private async Task SortCreaturesInitiativeRankByRoll()
    {
        _initiativeWindowCreatureListCopy = _initiativeWindowCreatureListCopy.OrderByDescending(x => x.InitiativeRoll).ToList();

        if (_initiativeWindowCreatureListCopy.Count <= 0)
        {
            return;
        }

        int lastRoll = _initiativeWindowCreatureListCopy[0].InitiativeRoll;
        int currentRank = 1;

        for (int i = 0; i < _initiativeWindowCreatureListCopy.Count(); i++)
        {
            if (_initiativeWindowCreatureListCopy[i].InitiativeRoll < lastRoll)
            {
                currentRank++;
            }
            _initiativeWindowCreatureListCopy[i].InitiativeRank = currentRank;
            lastRoll = _initiativeWindowCreatureListCopy[i].InitiativeRoll;
        }

        _currentInitiativeCreature = _initiativeWindowCreatureListCopy.First();
        await AskToStartCombat();
        await EventPublisher.PublishAsync(new DiceCombats.Automations.DiceEvent
        {
            Type = DiceCombats.Automations.DiceEventTypes.InitiativeSorted,
            Category = "Initiative",
            DisplayName = "Initiative sorted",
            Data = new() { ["combatId"] = _combat.Id, ["combatName"] = _combat.Name }
        });
    }

    private async Task CreaturesInitiativeReset()
    {
        foreach (DCCreature creature in _initiativeWindowCreatureListCopy)
        {
            creature.InitiativeRoll = 0;
            creature.InitiativeRank = 0;
        }
        await EventPublisher.PublishAsync(new DiceCombats.Automations.DiceEvent { Type = DiceCombats.Automations.DiceEventTypes.InitiativeReset, Category = "Initiative", DisplayName = "Initiative reset", Data = new() { ["combatId"] = _combat.Id, ["combatName"] = _combat.Name } });
    }

    private async Task MoveToNextCreatureInInitiative()
    {
        var previous = _currentInitiativeCreature;
        int idx = _initiativeWindowCreatureListCopy.IndexOf(_currentInitiativeCreature);
        if (idx >= 0)
        {
            if (idx < _initiativeWindowCreatureListCopy.Count - 1)
            {
                _currentInitiativeCreature = _initiativeWindowCreatureListCopy[idx + 1];
            }
            else
            {
                _currentInitiativeCreature = _initiativeWindowCreatureListCopy[0];
            }
        }
        await JSRuntime.InvokeVoidAsync("scrollToElementById", _currentInitiativeCreature.Id.ToString());

        var previousIndex = _initiativeWindowCreatureListCopy.IndexOf(previous);
        var currentIndex = _initiativeWindowCreatureListCopy.IndexOf(_currentInitiativeCreature);

        await EventPublisher.PublishAsync(new DiceCombats.Automations.DiceEvent { Type = DiceCombats.Automations.DiceEventTypes.InitiativeNext, Category = "Initiative", DisplayName = "Next creature", Data = new() { ["combatId"] = _combat.Id, ["combatName"] = _combat.Name, ["previousCreatureId"] = previous.Id, ["previousCreatureName"] = previous.Name, ["previousInitiativeIndex"] = previousIndex, ["currentCreatureId"] = _currentInitiativeCreature.Id, ["currentCreatureName"] = _currentInitiativeCreature.Name, ["initiativeIndex"] = currentIndex } });

        if (previous.Id != Guid.Empty)
        {
            await EventPublisher.PublishAsync(new DiceCombats.Automations.DiceEvent { Type = DiceCombats.Automations.DiceEventTypes.CreatureLostInitiative, Category = "Creatures", DisplayName = "Creature lost initiative", Data = new() { ["combatId"] = _combat.Id, ["combatName"] = _combat.Name, ["creatureId"] = previous.Id, ["creatureName"] = previous.Name, ["initiativeIndex"] = previousIndex } });
        }

        await EventPublisher.PublishAsync(new DiceCombats.Automations.DiceEvent { Type = DiceCombats.Automations.DiceEventTypes.CreatureGotInitiative, Category = "Creatures", DisplayName = "Creature got initiative", Data = new() { ["combatId"] = _combat.Id, ["combatName"] = _combat.Name, ["creatureId"] = _currentInitiativeCreature.Id, ["creatureName"] = _currentInitiativeCreature.Name, ["initiativeIndex"] = currentIndex } });
    }

    private void OpenCreaturesSelectorModal()
    {
        CreaturesSelectorModalRef?.Show();
    }

    /// The creature carries the choice, so a sheet keeps behaving the same way
    /// whether it is read from the bestiary or in the middle of a fight.
    private static string SheetLinkClass(DCCreature creature)
    {
        return creature.OpenLinksInApp ? "dc-sheet-inapp" : string.Empty;
    }

    private void OpenCombatLogModal()
    {
        CombatLogModalRef?.Show();
    }

    private void HandleCreaturesSelectorModalClose(bool result)
    {
        _initiativeWindowCreatureListCopy = _combat.CreaturesList.ToList();

        SaveCombat();
    }

    private void SaveCombat()
    {
        var combats = CombatService.GetCombatList();
        var combat = combats.Find(x => x.Id == _combat.Id);
        if (combat != null)
        {
            CombatService.DeleteCombat(combat);
        }

        CombatService.AddCombat(_combat);

        CombatService.SaveCombats();
    }

    private void TimerElapsed(Object? source, ElapsedEventArgs? e)
    {
        if (source is null || e is null)
        {
            throw new ArgumentNullException(nameof(e));
        }

        _combat.DurationCount++;
        InvokeAsync(StateHasChanged);
    }

    /// Everyone in the fight can be credited for damage, and the creature
    /// holding the initiative is the suggestion.
    private DCDamageSourceContext BuildDamageSourceContext()
    {
        // Before the initiative has been sorted there is no current creature, so
        // the top of the list stands in for it.
        string suggested = _combat.CreaturesList.Exists(x => x.Name == _currentInitiativeCreature.Name)
            ? _currentInitiativeCreature.Name
            : _initiativeWindowCreatureListCopy.FirstOrDefault()?.Name ?? string.Empty;

        return new DCDamageSourceContext
        {
            Candidates = _combat.CreaturesList
                .GroupBy(x => x.Name)
                .Select(x => new DCDamageSourceCandidate { Name = x.Key, IsPlayer = x.Any(c => c.IsPlayer) })
                .OrderByDescending(x => x.IsPlayer)
                .ThenBy(x => x.Name, StringComparer.CurrentCulture)
                .ToList(),
            SuggestedSource = suggested
        };
    }

    /// Sorting the initiative is the last thing done before the fight really
    /// begins, so it is the natural place to offer starting the recording.
    private async Task AskToStartCombat()
    {
        if (CombatLog.IsRecording) return;

        bool? confirm = await DialogService.ShowMessageBoxAsync(
            Loc["StartCombatTitle"],
            Loc["StartCombatQuestion"],
            yesText: Loc["StartCombatConfirmBtn"], cancelText: Loc["CancelBtn"]);
        if (confirm != true) return;

        await StartTimer();
    }

    private async Task StartTimer()
    {
        CombatLog.StartSession(_combat);
        _timer.Elapsed -= TimerElapsed;
        _timer.Elapsed += TimerElapsed;
        _timer.Start();
        _timer.Enabled = true;
        await EventPublisher.PublishAsync(new DiceCombats.Automations.DiceEvent { Type = DiceCombats.Automations.DiceEventTypes.TimerStarted, Category = "Timer", DisplayName = "Timer started", Data = new() { ["combatId"] = _combat.Id, ["combatName"] = _combat.Name, ["durationSeconds"] = _combat.DurationCount } });
    }

    private async Task PauseTimer()
    {
        _timer.Enabled = false;
        await EventPublisher.PublishAsync(new DiceCombats.Automations.DiceEvent { Type = DiceCombats.Automations.DiceEventTypes.TimerPaused, Category = "Timer", DisplayName = "Timer paused", Data = new() { ["combatId"] = _combat.Id, ["combatName"] = _combat.Name, ["durationSeconds"] = _combat.DurationCount } });
    }

    private async Task StopTimer()
    {
        _timer.Stop();
        _timer.Enabled = false;
        _timer.Elapsed -= TimerElapsed;
        _combat.DurationCount = 0;
        CombatLog.EndSession();
        await EventPublisher.PublishAsync(new DiceCombats.Automations.DiceEvent { Type = DiceCombats.Automations.DiceEventTypes.TimerStopped, Category = "Timer", DisplayName = "Timer stopped", Data = new() { ["combatId"] = _combat.Id, ["combatName"] = _combat.Name, ["durationSeconds"] = _combat.DurationCount } });
    }

    private string GetDurationAsString()
    {
        TimeSpan ts = TimeSpan.FromSeconds(_combat.DurationCount);
        DateTime dt = new DateTime(ts.Ticks);
        return dt.ToString("HH:mm:ss");
    }

}
