@page "/newcreature/"

@using System.Net
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using HtmlAgilityPack
@using Markdig

@inject DiceCombatsService CombatService
@inject NavigationManager Navigation
@inject IStringLocalizer<Resources.Localization.NewCreature> Loc

<h1 class="dc-h1" style="margin-bottom:14px;">@Loc["Title"]</h1>

<style>
    .markdown-html-preview {
    border-radius: 10px;
    background-color: var(--s5);
    padding:10px;
    margin-top:10px;
    }

    .section-title-name {
    border-radius: 60px;
    padding: 0px 20px 0px 0px;
    margin:10px;
    background-color: var(--a3);
    display: flex;
    align-items: center;
    }

    .markdown-content {
    color: white;
    }

    .markdown-content table,
    .markdown-content th,
    .markdown-content td {
    border: 1px solid white;
    padding: 5px;
    }

    .markdown-content th,
    .markdown-content td {
    background-color: var(--s4);
    }

    .one-column-item {
    display: block;
    width: calc(50% - 1rem); /* Adjust width for 3 items per row */
    margin-bottom: 1rem;
    }

    @@media screen and (max-width: 480px) {
    .one-column-item {
    width: 95%; /* Single column for narrow screens */
    }
    }
</style>

@* The five source kinds, as a row of tiles: the chosen one is the filled
   button, the rest are outlined. That replaces the white glow the old pair of
   .selected-button / .unselected-button rules drew, which was the look
   .dc-panel and the button variants were introduced to retire. *@
<div style="display:flex; flex-wrap:wrap; margin-bottom:20px;">
    <button type="button" class="dc-btn @(ModeClass("Local image"))" style="@ModeStyle"
            title="@Loc["TypeLocalImage"]" @onclick="@(() => {_layoutMode = "Local image";})">
        <DcIcon Name="image" Size="20" />
        <span>@Loc["TypeLocalImage"]</span>
    </button>
    <button type="button" class="dc-btn @(ModeClass("aidedd.org website"))" style="@ModeStyle"
            title="@Loc["TypeAidedd"]" @onclick="@(() => {_layoutMode = "aidedd.org website";})">
        <DcIcon Name="chess-rook" Size="20" />
        <span>@Loc["TypeAidedd"]</span>
    </button>
    <button type="button" class="dc-btn @(ModeClass("Markdown"))" style="@ModeStyle"
            title="@Loc["TypeMarkdown"]" @onclick="@(() => {_layoutMode = "Markdown";})">
        <DcIcon Name="text-snippet" Size="20" />
        <span>@Loc["TypeMarkdown"]</span>
    </button>
    <button type="button" class="dc-btn @(ModeClass("Manual creature"))" style="@ModeStyle"
            title="@Loc["TypeManual"]" @onclick="@(() => {_layoutMode = "Manual creature";})">
        <DcIcon Name="architecture" Size="20" />
        <span>@Loc["TypeManual"]</span>
    </button>
    <button type="button" class="dc-btn @(ModeClass("Player"))" style="@ModeStyle"
            title="@Loc["TypePlayer"]" @onclick="@(() => {_layoutMode = "Player";})">
        <DcIcon Name="person" Size="20" />
        <span>@Loc["TypePlayer"]</span>
    </button>
</div>

<div>
    @if (_layoutMode == "Local image")
    {
        <div>
            @* ActivatorContent is gone; CustomContent hands us the upload instance
               so the button can open the picker itself. *@
            <MudFileUpload T="IBrowserFile" FilesChanged="UploadFiles" MaximumFileCount="1">
                <CustomContent Context="upload">
                    <button type="button" class="dc-btn dc-btn-fill" @onclick="@(() => upload.OpenFilePickerAsync())">
                        <DcIcon Name="image" />
                        @Loc["LoadPictureBtnLabel"]
                    </button>
                </CustomContent>
            </MudFileUpload>
        </div>
        @if (!string.IsNullOrEmpty(_localImageBase64))
        {
            <div style="padding:20px;">
                <img src="@_localImageBase64" height="500px" />
            </div>
            <div class="dc-irow dc-irow-wrap" style="align-items:flex-end;">
                <div class="dc-field" style="flex:0 1 320px; min-width:240px;">
                    <label class="dc-flabel" for="image-creature-name">@Loc["CreatureNameEditLabel"]</label>
                    <input class="dc-inp" id="image-creature-name" type="text" spellcheck="false"
                           @bind="_creatureName" @bind:event="oninput" />
                </div>
                @if (_creatureName != "N/A" && _creatureName != "")
                {
                    <button type="button" class="dc-btn dc-btn-fill" @onclick="_registerNewCreature">
                        @Loc["RegisterCreatureBtn"]
                        <DcIcon Name="add" />
                    </button>
                }
            </div>
        }
    }

    @if (_layoutMode == "aidedd.org website")
    {
        <div>
            <div class="dc-field" style="max-width:520px;">
                @* The URL field fetches the sheet, so the keystroke-to-request
                   debounce MudTextField gave it is kept in C# below rather than
                   dropped: see OnAideDDUrlInput / DebounceAsync. *@
                <label class="dc-flabel" for="aidedd-url">@Loc["AideddURLtfLabel"]</label>
                <input class="dc-inp" id="aidedd-url" type="text" spellcheck="false"
                       value="@_aideDDCreatureUrl" @oninput="OnAideDDUrlInput" />
                @if (CombatService.IsCurrentCulture("fr"))
                {
                    <a class="dc-crumb" href="https://www.aidedd.org/">Se rendre sur aidedd.org</a>
                } else
                {
                    <a class="dc-crumb" href="https://www.aidedd.org/en/">Visit aidedd.org</a>
                }

            </div>
            <div>
                @if (_aideDDCreatureName != "N/A")
                {
                    <div style="padding:10px;">
                        @if (CombatService.IsCurrentCulture("fr"))
                        {
                            <span>Détecté : @_aideDDCreatureName <DcIcon Name="check-circle" Class="dc-i-accent" /></span>
                        } else
                        {
                            <span>Found @_aideDDCreatureName <DcIcon Name="check-circle" Class="dc-i-accent" /></span>
                        }
                    </div>
                }
            </div>
        </div>
        <div style="padding:20px;color:black;">
            @((MarkupString)_aideDDCreatureSheet)
        </div>
        <div class="dc-irow dc-irow-wrap" style="align-items:flex-end;">
            <div class="dc-field" style="flex:0 1 320px; min-width:240px;">
                <label class="dc-flabel" for="aidedd-creature-name">@Loc["OptionalCreatureNameEditLabel"]</label>
                <input class="dc-inp" id="aidedd-creature-name" type="text" spellcheck="false"
                       @bind="_creatureName" @bind:event="oninput" />
            </div>
            @if (_creatureName != "N/A" && _creatureName != "")
            {
                <button type="button" class="dc-btn dc-btn-fill" @onclick="_registerNewCreature">
                    @Loc["RegisterCreatureBtn"]
                    <DcIcon Name="add" />
                </button>
            }
        </div>
    }

    @if (_layoutMode == "Markdown")
    {
        <div class="dc-irow dc-irow-wrap" style="align-items:flex-end;">
            <div class="dc-field" style="flex:0 1 320px; min-width:240px;">
                <label class="dc-flabel" for="md-creature-name">@Loc["CreatureNameEditLabel"]</label>
                <input class="dc-inp" id="md-creature-name" type="text" spellcheck="false"
                       @bind="_creatureName" @bind:event="oninput" />
            </div>
            @if (_creatureName != "N/A" && _creatureName != "")
            {
                <button type="button" class="dc-btn dc-btn-fill" @onclick="_registerNewCreature">
                    @Loc["RegisterCreatureBtn"]
                    <DcIcon Name="add" />
                </button>
            }
        </div>
        <div style="display:flex;flex-wrap:wrap;">
            <div class="one-column-item" style="padding-right:10px;">
                <div class="dc-field" style="width:100%;">
                    <label class="dc-flabel" for="md-source">@Loc["MarkdownLabel"]</label>
                    @* The box keeps what is typed at once; only the render beside
                       it waits out the 500 ms the MudTextField debounced. *@
                    <textarea class="dc-inp" id="md-source" rows="20" spellcheck="false"
                              value="@_markdownSheet" @oninput="OnMarkdownInput"></textarea>
                </div>
            </div>
            <div class="markdown-html-preview one-column-item" style="padding-left:10px;">
                <div class="markdown-content">
                    @((MarkupString)_markdownHtmlPreview)
                </div>
            </div>
        </div>
    }

    @if (_layoutMode == "Manual creature")
    {
        <div class="dc-irow dc-irow-wrap" style="align-items:flex-end;">
            <div class="dc-field" style="flex:0 1 320px; min-width:240px;">
                <label class="dc-flabel" for="manual-creature-name">@Loc["CreatureNameEditLabel"]</label>
                <input class="dc-inp" id="manual-creature-name" type="text" spellcheck="false"
                       @bind="_creatureName" @bind:event="oninput" />
            </div>
            @if (_creatureName != "N/A" && _creatureName != "")
            {
                <button type="button" class="dc-btn dc-btn-fill" @onclick="_registerNewCreature">
                    @Loc["RegisterCreatureBtn"]
                    <DcIcon Name="add" />
                </button>
            }
        </div>
    }

    @if (_layoutMode == "Player")
    {
        <div class="dc-irow dc-irow-wrap" style="align-items:flex-end;">
            <div class="dc-field" style="flex:0 1 320px; min-width:240px;">
                <label class="dc-flabel" for="player-name">@Loc["PlayerNameEditLabel"]</label>
                <input class="dc-inp" id="player-name" type="text" spellcheck="false"
                       @bind="_creatureName" @bind:event="oninput" />
            </div>
            @if (_creatureName != "N/A" && _creatureName != "")
            {
                <button type="button" class="dc-btn dc-btn-fill" @onclick="_registerNewCreature">
                    @Loc["RegisterPlayerBtn"]
                    <DcIcon Name="add" />
                </button>
            }
        </div>
    }
</div>

@code {
    private string _layoutMode { get; set; } = "Local image";
    private string _aideDDCreatureUrl { get; set; } = "";
    private string _markdownSheet { get; set; } = "";

    private string _creatureName = "";

    private string _aideDDCreatureSheet = "";
    private string _aideDDCreatureName = "N/A";

    private string _localImageBase64 = "";

    private string _markdownHtmlPreview = "";

    /// The five source tiles are one choice, so the chosen one is the filled
    /// button and the other four are outlined.
    private const string ModeStyle =
        "flex-direction:column;height:auto;width:130px;padding:10px 6px;margin:5px;white-space:normal;text-align:center;";

    private string ModeClass(string mode) => _layoutMode == mode ? "dc-btn-fill" : "dc-btn-out";

    private CancellationTokenSource? _aideDDDebounce;
    private CancellationTokenSource? _markdownDebounce;

    /// MudTextField's DebounceInterval, kept by hand: the URL field triggers a
    /// web request, so firing it on every keystroke would hammer aidedd.org.
    private void OnAideDDUrlInput(ChangeEventArgs e)
    {
        var url = e.Value?.ToString() ?? string.Empty;
        _aideDDCreatureUrl = url;

        _aideDDDebounce?.Cancel();
        _aideDDDebounce = new CancellationTokenSource();
        _ = DebounceAsync(_aideDDDebounce.Token, async () =>
        {
            await _getAideDDCreatureSheet(url);
            StateHasChanged();
        });
    }

    /// Same debounce for the markdown box: the text itself is kept on every
    /// keystroke so the box never fights the typist, and only the render of the
    /// preview beside it waits.
    private void OnMarkdownInput(ChangeEventArgs e)
    {
        _markdownSheet = e.Value?.ToString() ?? string.Empty;
        var markdown = _markdownSheet;

        _markdownDebounce?.Cancel();
        _markdownDebounce = new CancellationTokenSource();
        _ = DebounceAsync(_markdownDebounce.Token, () => _previewMarkdownSheet(markdown));
    }

    private async Task DebounceAsync(CancellationToken token, Func<Task> action)
    {
        try
        {
            await Task.Delay(500, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (token.IsCancellationRequested) return;

        await InvokeAsync(action);
    }

    private async Task UploadFiles(IBrowserFile file)
    {
        const long maxFileSize = 1024 * 1024 * 15; // 15 MB

        try
        {
            using (var stream = file.OpenReadStream(maxAllowedSize: maxFileSize))
            using (var memoryStream = new MemoryStream())
            {
                await stream.CopyToAsync(memoryStream);
                var bytes = memoryStream.ToArray();
                _localImageBase64 = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
            }
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"Error uploading file: {ex.Message}");
        }

        GC.Collect(); // Force garbage collection to free up memory
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        return base.OnAfterRenderAsync(firstRender);
    }

    private async Task _getAideDDCreatureSheet(string url)
    {
        _aideDDCreatureUrl = url;

        AideDDOrgCreaturSheetExtractor aideDDOrgCreaturSheetExtractor = new AideDDOrgCreaturSheetExtractor(_aideDDCreatureUrl);
        _aideDDCreatureSheet = await aideDDOrgCreaturSheetExtractor.GetSheetAsHtmlString();
        _aideDDCreatureName = aideDDOrgCreaturSheetExtractor.CreatureName;
        _creatureName = _aideDDCreatureName;
    }

    private async Task _previewMarkdownSheet(string markdownSheet)
    {
        var pipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions() // This includes PipeTables and more
            .Build();

        _markdownHtmlPreview = Markdown.ToHtml(markdownSheet, pipeline);
        _markdownSheet = markdownSheet;

        if (_creatureName == "" && markdownSheet.Contains("#"))
        {
            foreach (var line in markdownSheet.Split('\n'))
            {
                if (line.Contains('#'))
                {
                    var potentialName = line.Trim('#').Trim();
                    _creatureName = potentialName;
                    break;
                }
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private void _registerNewCreature()
    {
        DCCreature newCreature = new DCCreature(_creatureName);
        if (_layoutMode == "Local image")
        {
            newCreature.SetImageSheetBase64(_localImageBase64);
        }
        else if (_layoutMode == "Markdown")
        {
            newCreature.SetMarkdownSheet(_markdownSheet);
        }
        else if (_layoutMode == "aidedd.org website")
        {
            newCreature.SetHtmlSheet(_aideDDCreatureSheet);
        }
        else if (_layoutMode == "Manual creature")
        {
            newCreature.IsManual = true;
        }
        else if (_layoutMode == "Player")
        {
            newCreature.IsPlayer = true;
        }
        CombatService.GetCreatureList().Add(newCreature);

        Debug.WriteLine(newCreature.Id.ToString());

        Navigation.NavigateTo($"/creaturemanager/{newCreature.Id.ToString()}");
    }
}

