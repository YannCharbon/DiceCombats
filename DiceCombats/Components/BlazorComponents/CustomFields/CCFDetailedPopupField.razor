@using DiceCombats
@inject DiceCombatsService CombatService
@inject IStringLocalizer<Resources.Localization.CreatureCustomFieldRenderer> Loc

@if (EditionMode)
{
    <GenericModal TContent="DetailedPopupFieldPopup" OnClose="() => {}" @ref="_modal">
        <DetailedPopupFieldPopup DetailedPopupField="Field" EditionMode="true" />
    </GenericModal>

    <button type="button" class="dc-btn dc-btn-out" @onclick="@(() => _modal?.ShowAsync() ?? Task.CompletedTask)">
        <DcIcon Name="edit" Size="17" />@Loc["DetailedPopupEditButton"]
    </button>

    <div class="dc-irow dc-irow-wrap" style="gap:6px;margin-top:10px;">
        @foreach (var c in Field.Contents)
        {
            @if (!string.IsNullOrWhiteSpace(c.Name))
            {
                <span class="dc-tag">@c.Name</span>
            }
            else
            {
                <span class="dc-tag">@c.Kind</span>
            }
        }
    </div>
}
else
{
    <GenericModal TContent="DetailedPopupFieldPopup" OnClose="() => {}" @ref="_modal">
        <DetailedPopupFieldPopup DetailedPopupField="Field" />
    </GenericModal>

    <button type="button" class="dc-btn dc-btn-fill" @onclick="OpenPopup">
        <DcIcon Name="lightbulb" Size="17" />@Field.Title
    </button>
}

@code {
    [Parameter] public DCCreatureDetailedPopupField Field { get; set; } = default!;
    [Parameter] public bool EditionMode { get; set; } = false;
    [Parameter] public EventCallback OnChange { get; set; }
    [Parameter] public EventCallback<CustomFieldChangeInfo> OnFieldChanged { get; set; }

    private GenericModal<DetailedPopupFieldPopup>? _modal;

    private async Task OpenPopup()
    {
        if (_modal is not null)
            await _modal.ShowAsync();

        if (OnFieldChanged.HasDelegate)
        {
            await OnFieldChanged.InvokeAsync(new CustomFieldChangeInfo
            {
                Field = Field,
                Action = "Opened"
            });
        }

        if (OnChange.HasDelegate)
            await OnChange.InvokeAsync();
    }
}
