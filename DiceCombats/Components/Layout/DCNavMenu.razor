@implements IDisposable

@inject NavigationManager Nav
@inject IStringLocalizer<Resources.Localization.DCNavMenu> Loc

<style>
    /* ── Bar (teal/green theme; height + shadow kept as before) ── */
    .dc-bar {
        display: flex;
        height: calc(50px + var(--dc-safe-area-top));
        padding-top: var(--dc-safe-area-top);
        align-items: center;
        gap: 22px; /* space between each capsule and the central logo notch */
        /* Symmetric side padding keeps the bar's own centre on the page centre;
           the right slot doubles as clearance for the absolutely positioned
           utilities (and, above them, the OS caption buttons). */
        padding-left: 60px;
        padding-right: 60px;
        background-image: linear-gradient(-45deg, rgba(85, 197, 109, 0.2), rgba(50, 200, 126, 0.6), rgba(0, 170, 170, 0.9), rgba(35, 170, 128, 1.0));
        position: fixed;
        top: 0;
        width: 100%;
        box-shadow: 0 2px 10px rgba(255, 255, 255, 0.1);
        border-bottom: 1px solid #505050;
        z-index: 10; /* Ensures nav stays above other elements */
    }

    /* ── Side slots ──
       The two capsules are not the same width ("Créatures | Combats" is much
       narrower than "Automatisations | Réglages"). Centring the flex group as
       a whole would therefore push the gem off-centre by half that difference,
       so each side takes an equal share of the leftover space instead and the
       logo lands on the bar's exact centre whatever the labels say. */
    .dc-side {
        flex: 1 1 0;
        min-width: 0;
        display: flex;
        align-items: center;
    }

    .dc-side-left {
        justify-content: flex-end;
    }

    .dc-side-right {
        justify-content: flex-start;
    }

    /* ── Segmented glass capsule (one per pair) ── */
    .dc-seg {
        flex: 0 0 auto; /* never squash the labels to fit the slot */
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        overflow: hidden;
        background: rgba(6, 18, 18, 0.34);
        border: 1px solid rgba(255, 255, 255, 0.18);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: 1; /* below the logo if they overlap */
    }

    .dc-navlink {
        text-decoration: none;
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        white-space: nowrap;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 16px;
        transition: background .16s ease, color .16s ease;
    }

        .dc-navlink + .dc-navlink {
            box-shadow: -1px 0 0 rgba(255, 255, 255, 0.14); /* hairline divider */
        }

        .dc-navlink:hover {
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
        }

        .dc-navlink.active {
            background: rgba(0, 170, 170, 0.45); /* app teal accent */
        }

    /* ── App icon / central logo ── */
    .nav-logo {
        position: relative;
        z-index: 5; /* Ensures the logo is above the nav links */
        flex: 0 0 auto;
        width: 104px; /* reserve the notch the logo occupies */
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

        .nav-logo img {
            width: 100px;
        }

    /* ── Windows: the web page is the title bar ──
       The WebView2 extends to the window's top edge (see WebTitleBar). A 32px
       strip above the bar acts as the draggable title bar; the bar sits below
       it and the gem crowns over both, exactly like DiceAudio: hexagon edge ==
       bar height (50px), upper corners on the bar's top. */
    .dc-titlestrip {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 32px;
        background: #202020;
        z-index: 9; /* under the bar and the gem */
        app-region: drag;
        -webkit-app-region: drag;
    }

    .dc-bar-win {
        top: 32px; /* below the drag strip */
        height: 50px; /* the strip replaces the mobile safe-area inset */
        padding-top: 0;
    }

        .dc-bar-win .nav-logo {
            align-self: stretch; /* span the bar so the img anchors to its top */
        }

            .dc-bar-win .nav-logo img {
                position: absolute;
                left: 50%;
                transform: translateX(-50%);
                width: 101.2px;  /* 81 × (50 / 40.001): hexagon edge = bar height */
                top: -25.6px;    /* upper corners (20.51 × 1.25 into the image) on the bar top */
                app-region: no-drag;
                -webkit-app-region: no-drag;
            }

        .dc-bar-win .dc-util {
            top: 50%; /* the strip is outside the bar, so no inset to split */
        }

    /* ── Right-hand utilities ── */
    .dc-util {
        position: absolute;
        right: 20px;
        top: calc(50% + var(--dc-safe-area-top) / 2);
        transform: translateY(-50%);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        z-index: 6;
    }

    .dc-gear {
        width: 32px;
        height: 32px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(6, 18, 18, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.18);
        color: #fff;
        text-decoration: none;
        cursor: pointer;
        transition: background .16s, border-color .16s;
    }

        .dc-gear:hover {
            background: rgba(6, 18, 18, 0.6);
            border-color: rgba(255, 255, 255, 0.5);
            color: #fff;
        }

    /* ── Narrow windows / phones: labels collapse to icons ──
       Breakpoint is where the two capsules + logo + side padding stop fitting;
       below it the right capsule would otherwise slide under the utilities. */
    @@media (max-width: 1000px) {
        .dc-bar {
            gap: 10px;
            padding-left: 46px; /* stays symmetric, so the gem keeps the centre */
            padding-right: 46px;
        }

        .dc-navlink {
            padding: 8px 12px;
        }

            .dc-navlink span {
                display: none;
            }

        .nav-logo {
            width: 84px;
        }

            .nav-logo img {
                width: 80px;
            }

        .dc-util {
            right: 8px;
        }
    }
</style>

@if (OperatingSystem.IsWindows())
{
    @* The 32px drag strip stands in for the mobile status-bar inset, so the
       page content (.page in app.css, and PopupNotification) shifts down by
       exactly the same 50px + inset arithmetic it already uses. *@
    <style>
        :root {
            --dc-safe-area-top: 32px;
        }
    </style>

    @* Draggable title strip: the OS treats it as caption (drag, double-click
       maximize, right-click system menu) via WebView2 non-client regions. *@
    <div class="dc-titlestrip"></div>
}

<nav class="dc-bar @(OperatingSystem.IsWindows() ? "dc-bar-win" : "")">
    <div class="dc-side dc-side-left">
        <div class="dc-seg">
            <a class="dc-navlink @(IsActive("creaturesexplorer") ? "active" : "")" href="creaturesexplorer">
                <MudIcon Icon="@Icons.Material.Filled.Pets" Color="Color.Inherit" Style="font-size:18px;" />
                <span>@Loc["CreaturesBtn"]</span>
            </a>
            <a class="dc-navlink @(IsActive("combatsexplorer") ? "active" : "")" href="combatsexplorer">
                <MudIcon Icon="@Icons.Material.Filled.Shield" Color="Color.Inherit" Style="font-size:18px;" />
                <span>@Loc["CombatsBtn"]</span>
            </a>
        </div>
    </div>

    <div class="nav-logo" @onclick="GoHome"><img src="dicecombats_logo.svg" /></div>

    <div class="dc-side dc-side-right">
        <div class="dc-seg">
            <a class="dc-navlink @(IsActive("automations") ? "active" : "")" href="automations">
                <MudIcon Icon="@Icons.Material.Filled.AutoMode" Color="Color.Inherit" Style="font-size:18px;" />
                <span>@Loc["AutomationsBtn"]</span>
            </a>
            <a class="dc-navlink @(IsActive("settings") ? "active" : "")" href="settings">
                <MudIcon Icon="@Icons.Material.Filled.Tune" Color="Color.Inherit" Style="font-size:18px;" />
                <span>@Loc["SettingsBtn"]</span>
            </a>
        </div>
    </div>

    <div class="dc-util">
        <a class="dc-gear" href="https://github.com/YannCharbon/DiceCombats" target="_blank" title="GitHub">
            <MudIcon Icon="@Icons.Custom.Brands.GitHub" Style="font-size:18px;color:white;" />
        </a>
    </div>
</nav>

@code {
    protected override void OnInitialized()
    {
        // Re-render so the active nav link tracks navigation.
        Nav.LocationChanged += OnLocationChanged;
    }

    private string CurrentPath =>
        Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();

    private bool IsActive(string route) =>
        CurrentPath.Equals(route, StringComparison.OrdinalIgnoreCase) ||
        CurrentPath.StartsWith(route + "/", StringComparison.OrdinalIgnoreCase);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    private void GoHome() => Nav.NavigateTo("/");

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
