@page "/automations"
@using DiceCombats.Automations
@using DiceCombats.Components.BlazorComponents.Automations
@inject AutomationConfigurationService ConfigService
@inject ILocalPreferences LocalPreferences
@inject IDiceEventPublisher EventPublisher
@inject PopupNotificationService PopupNotificationService
@inject IStringLocalizer<Resources.Localization.Automations> Loc

<style>
    /* .dc-panel, .dc-pill, .assist-box, .assist-grid, .assist-example, .kbd and
       .placeholder-table now come from wwwroot/css/app.css, which is where the
       other pages were each re-declaring their own copy. What is left here is
       this page's two column widths, plus the surface steps of its nesting.

       The nesting is the point: MudBlazor paints every expansion panel from a
       single Surface colour (--s4), and .dc-msec is also --s4, so a whole
       automation — card, trigger block, action rows — landed on one step and
       read as one flat slab. Each level below takes its own step of the --s*
       ramp, and anything operable gets a --ctl edge (3.4:1) rather than a
       decorative --b1 one (2.6:1). */

    /* Both lists are grids that fill the width. The old fixed 30% / 40-50%
       widths left most of the page empty, and an expanded automation - which
       carries a trigger editor and a sequence diagram - was squeezed into half
       a column while the other half stayed blank. */
    .automation-apps,
    .automations-list {
        display: grid;
        gap: 12px;
        align-items: start;
    }

    .automation-apps { grid-template-columns: repeat(auto-fill, minmax(min(330px, 100%), 1fr)); }
    .automations-list { grid-template-columns: repeat(auto-fill, minmax(min(460px, 100%), 1fr)); }

    .automation-app-item,
    .automation-item { min-width: 0; }

    /* An open automation deliberately does NOT take the whole row. Letting it
       span made a trigger picker, a sequence diagram and a handful of short
       text fields stretch across 1300px, which gained nothing and left the eye
       travelling a long way between a label and its control. Confined to its
       column it reads as a form of ordinary width, and the card beside it
       stays put instead of being bumped to the next row. */

    @@media screen and (max-width: 768px) {
        .automation-apps,
        .automations-list { grid-template-columns: minmax(0, 1fr); }
    }

    /* An external app is a card you type into, so its edge is operable. */
    .dc-panel.automation-app-item { border-color: var(--ctl); }

    /* ── one automation ───────────────────────────────────────────────────
       The ramp ALTERNATES rather than climbing. s3→s4 is 5.2 L*, which is
       below what reads as a boundary once a border is also competing for
       attention; s3→s5 is 9.9 L* and unmistakable. So:

         page --s0 → card --s3 → head --s5 → section --s5 → row back to --s3
         → input --s2

       Each boundary is ~10 L* in one direction or the other, instead of four
       nested things all sitting within 5 L* of each other. */
    .automation-item.mud-expansion-panels > .mud-expand-panel {
        background-color: var(--s3);
        border: 1px solid var(--ctl);
        border-radius: var(--r-card);
    }

    /* Sections inside the card (.dc-msec from the trigger and action editors). */
    .automation-item .dc-msec {
        background: var(--s5);
        border-color: var(--ctl);
    }

    /* A row inside a section drops back down, so its edge is a real step. */
    .automation-item .dc-msec .dc-msec,
    .automation-item .as-action,
    .automation-item .dc-mrow,
    .automation-item .dc-opt {
        background: var(--s3);
        border-color: var(--ctl);
    }

    .automation-item .mud-expand-panel-header {
        background: var(--s5);
        border-bottom: 1px solid var(--ctl);
    }

    /* ── the assistance tree ──────────────────────────────────────────────
       card --s3 → its boxes and its nested panels --s4 → the boxes inside
       those --s5 → and the two things that sit on an --s5 box (a kbd chip,
       a code example) stepped off it again. */
    .automations-assist.mud-expansion-panels > .mud-expand-panel {
        background-color: var(--s3);
        border: 1px solid var(--ctl);
        border-radius: var(--r-panel);
    }

    .automations-assist .assist-box { background: var(--s4); }

    .automations-assist.mud-expansion-panels .mud-expansion-panels > .mud-expand-panel {
        background-color: var(--s4);
        border: 1px solid var(--ctl);
        border-radius: var(--r-btn);
        margin-bottom: 6px;
    }

    .automations-assist .mud-expansion-panels .assist-box { background: var(--s5); }
    .automations-assist .mud-expansion-panels .assist-box .kbd { background: var(--s6); }
    .automations-assist .mud-expansion-panels .assist-box .assist-example { background: var(--s3); }
</style>

<div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:18px;">
    <div>
        <h1 class="dc-h1">@Loc["Title"]</h1>
        <p class="dc-sub">@Loc["Subtitle"]</p>
    </div>
    <button type="button" class="dc-btn dc-btn-fill" @onclick="Save">
        <DcIcon Name="save" />
        @Loc["Save"]
    </button>
</div>

<div class="dc-stack">


    <MudExpansionPanels Class="automations-assist">
    <MudExpansionPanel Expanded="@_assistanceExpanded" ExpandedChanged="() => _assistanceExpanded = !_assistanceExpanded">
        <TitleContent>
            <div class="dc-irow" style="gap:10px;">
                <DcIcon Name="help" Size="18" Class="dc-i-accent" />
                <span>@Loc["Assistance"]</span>
            </div>
        </TitleContent>
        <ChildContent>
            <div class="assist-box">
                <h4 style="margin:0 0 6px;">@Loc["AssistanceWhatAutomationsDoTitle"]</h4>
                <p>@Loc["AssistanceWhatAutomationsDoText"]</p>
            </div>

            <div class="assist-grid">
                <div class="assist-box">
                    <h4 style="margin:0 0 6px;">@Loc["AssistanceExternalAppsTitle"]</h4>
                    <p>
                        @Loc["AssistanceExternalAppsText1"]
                        <span class="kbd">http://localhost:5000</span>.
                        @Loc["AssistanceExternalAppsText2"]
                        <span class="kbd">/api/timer/start</span>.
                    </p>
                    <p>@Loc["AssistanceExternalAppsText3"]</p>
                </div>

                <div class="assist-box">
                    <h4 style="margin:0 0 6px;">@Loc["AssistanceAutomationsTitle"]</h4>
                    <p>@Loc["AssistanceAutomationsText"]</p>
                </div>

                <div class="assist-box">
                    <h4 style="margin:0 0 6px;">@Loc["AssistanceActionsTitle"]</h4>
                    <p>
                        @Loc["AssistanceActionsText1"]
                        <span class="kbd">@Loc["ContinueOnFailure"]</span>
                        @Loc["AssistanceActionsText2"]
                    </p>
                </div>

                <div class="assist-box">
                    <h4 style="margin:0 0 6px;">@Loc["AssistanceSaveLogsTitle"]</h4>
                    <p>
                        @Loc["AssistanceSaveLogsText1"]
                        <span class="kbd">@Loc["Save"]</span>
                        @Loc["AssistanceSaveLogsText2"]
                    </p>
                </div>
            </div>

            <MudExpansionPanels MultiExpansion="true" Dense="true" Elevation="0" Class="mt-2">
                <MudExpansionPanel Text="@Loc["PlaceholderCatalogueTitle"]">
                    <div class="assist-box">
                        <p>
                            @Loc["PlaceholderCatalogueIntro1"]
                            <span class="kbd">{{Name}}</span>
                            @Loc["PlaceholderCatalogueIntro2"]
                            <span class="kbd">Data.*</span>
                            @Loc["PlaceholderCatalogueIntro3"]
                        </p>

                        <h5 style="margin:12px 0 4px;">@Loc["PlaceholderMetadataTitle"]</h5>
                        <table class="placeholder-table">
                            <tr>
                                <th>@Loc["PlaceholderColumn"]</th>
                                <th>@Loc["MeaningColumn"]</th>
                            </tr>
                            <tr><td><span class="kbd">{{Id}}</span></td><td>@Loc["PlaceholderMeaningId"]</td></tr>
                            <tr><td><span class="kbd">{{Type}}</span></td><td>@Loc["PlaceholderMeaningType"] <span class="kbd">combat.initiative.next</span>.</td></tr>
                            <tr><td><span class="kbd">{{Category}}</span></td><td>@Loc["PlaceholderMeaningCategory"] <span class="kbd">Initiative</span>, <span class="kbd">Creatures</span>, <span class="kbd">Timer</span>, @Loc["Or"] <span class="kbd">Custom fields</span>.</td></tr>
                            <tr><td><span class="kbd">{{DisplayName}}</span></td><td>@Loc["PlaceholderMeaningDisplayName"]</td></tr>
                            <tr><td><span class="kbd">{{OccurredAt}}</span></td><td>@Loc["PlaceholderMeaningOccurredAt"]</td></tr>
                        </table>
                    </div>

                    <div class="assist-box">
                        <h5 style="margin:12px 0 4px;">@Loc["EventDataPlaceholdersTitle"]</h5>
                        <table class="placeholder-table">
                            <tr>
                                <th>@Loc["WhenAvailableColumn"]</th>
                                <th>@Loc["PlaceholdersColumn"]</th>
                            </tr>
                            <tr>
                                <td>@Loc["PlaceholderWhenMostCombatEvents"]</td>
                                <td><span class="kbd">{{Data.combatId}}</span>, <span class="kbd">{{Data.combatName}}</span></td>
                            </tr>
                            <tr>
                                <td>@Loc["PlaceholderWhenNextCreature"]</td>
                                <td><span class="kbd">{{Data.previousCreatureId}}</span>, <span class="kbd">{{Data.previousCreatureName}}</span>, <span class="kbd">{{Data.previousInitiativeIndex}}</span>, <span class="kbd">{{Data.currentCreatureId}}</span>, <span class="kbd">{{Data.currentCreatureName}}</span>, <span class="kbd">{{Data.initiativeIndex}}</span></td>
                            </tr>
                            <tr>
                                <td>@Loc["PlaceholderWhenCreatureGotLostInitiative"]</td>
                                <td><span class="kbd">{{Data.creatureId}}</span>, <span class="kbd">{{Data.creatureName}}</span>, <span class="kbd">{{Data.initiativeIndex}}</span></td>
                            </tr>
                            <tr>
                                <td>@Loc["PlaceholderWhenCombatTimer"]</td>
                                <td><span class="kbd">{{Data.durationSeconds}}</span></td>
                            </tr>
                            <tr>
                                <td>@Loc["PlaceholderWhenAllCreatureCustomFieldEvents"]</td>
                                <td><span class="kbd">{{Data.creatureId}}</span>, <span class="kbd">{{Data.creatureName}}</span>, <span class="kbd">{{Data.instanceIndex}}</span>, <span class="kbd">{{Data.fieldTitle}}</span>, <span class="kbd">{{Data.fieldType}}</span>, <span class="kbd">{{Data.eventAction}}</span>, <span class="kbd">{{Data.oldValue}}</span>, <span class="kbd">{{Data.newValue}}</span></td>
                            </tr>
                            <tr>
                                <td>@Loc["PlaceholderWhenNumericHpStatsValueChanges"]</td>
                                <td><span class="kbd">{{Data.oldNumericValue}}</span>, <span class="kbd">{{Data.numericValue}}</span>, <span class="kbd">{{Data.delta}}</span>, <span class="kbd">{{Data.changeDirection}}</span></td>
                            </tr>
                            <tr>
                                <td>@Loc["PlaceholderWhenNumericMaximumUnit"]</td>
                                <td><span class="kbd">{{Data.showMaxValue}}</span>, <span class="kbd">{{Data.maximumValue}}</span>, <span class="kbd">{{Data.showUnit}}</span>, <span class="kbd">{{Data.unit}}</span></td>
                            </tr>
                            <tr>
                                <td>@Loc["PlaceholderWhenHitPointsField"]</td>
                                <td><span class="kbd">{{Data.maximumValue}}</span>, <span class="kbd">{{Data.oldPercentage}}</span>, <span class="kbd">{{Data.percentage}}</span></td>
                            </tr>
                            <tr>
                                <td>@Loc["PlaceholderWhenCheckboxConditionOptions"]</td>
                                <td><span class="kbd">{{Data.optionIndex}}</span>, <span class="kbd">{{Data.optionName}}</span>, <span class="kbd">{{Data.textLabel}}</span></td>
                            </tr>
                            <tr>
                                <td>@Loc["PlaceholderWhenGridCells"]</td>
                                <td><span class="kbd">{{Data.rowIndex}}</span>, <span class="kbd">{{Data.rowName}}</span>, <span class="kbd">{{Data.columnIndex}}</span>, <span class="kbd">{{Data.columnName}}</span>, <span class="kbd">{{Data.textLabel}}</span></td>
                            </tr>
                            <tr>
                                <td>@Loc["PlaceholderWhenStatsField"]</td>
                                <td><span class="kbd">{{Data.statIndex}}</span>, <span class="kbd">{{Data.statName}}</span></td>
                            </tr>
                            <tr>
                                <td>@Loc["PlaceholderWhenDamageHealApplied"]</td>
                                <td><span class="kbd">{{Data.creatureName}}</span>, <span class="kbd">{{Data.targetName}}</span>, <span class="kbd">{{Data.targetIsPlayer}}</span>, <span class="kbd">{{Data.sourceName}}</span>, <span class="kbd">{{Data.sourceIsPlayer}}</span>, <span class="kbd">{{Data.sourceInferred}}</span>, <span class="kbd">{{Data.damageKind}}</span>, <span class="kbd">{{Data.ruleName}}</span>, <span class="kbd">{{Data.rawAmount}}</span>, <span class="kbd">{{Data.appliedAmount}}</span>, <span class="kbd">{{Data.intensity}}</span>, <span class="kbd">{{Data.severity}}</span>, <span class="kbd">{{Data.tags}}</span>, <span class="kbd">{{Data.attackId}}</span>, <span class="kbd">{{Data.lineIndex}}</span>, <span class="kbd">{{Data.lineCount}}</span>, <span class="kbd">{{Data.resultHitPoints}}</span>, <span class="kbd">{{Data.maximumHitPoints}}</span></td>
                            </tr>
                            <tr>
                                <td>@Loc["PlaceholderWhenAttackApplied"]</td>
                                <td><span class="kbd">{{Data.damageKinds}}</span>, <span class="kbd">{{Data.damageKindCount}}</span>, <span class="kbd">{{Data.lineCount}}</span>, <span class="kbd">{{Data.rawAmount}}</span>, <span class="kbd">{{Data.appliedAmount}}</span>, <span class="kbd">{{Data.intensity}}</span>, <span class="kbd">{{Data.severity}}</span>, <span class="kbd">{{Data.tags}}</span>, <span class="kbd">{{Data.attackId}}</span></td>
                            </tr>
                            <tr>
                                <td>@Loc["PlaceholderWhenCombatSession"]</td>
                                <td><span class="kbd">{{Data.rounds}}</span>, <span class="kbd">{{Data.entries}}</span></td>
                            </tr>
                            <tr>
                                <td>@Loc["PlaceholderWhenUserCustomFieldSavedRemoved"]</td>
                                <td><span class="kbd">{{Data.fieldTitle}}</span>, <span class="kbd">{{Data.fieldType}}</span>, <span class="kbd">{{Data.isUserCustomField}}</span></td>
                            </tr>
                        </table>
                    </div>
                </MudExpansionPanel>

                <MudExpansionPanel Text="@Loc["ExampleTimerTitle"]">
                    <div class="assist-box">
                        <p>
                            @Loc["ExampleTimerText1"]
                            <span class="kbd">DiceTimer</span>
                            @Loc["ExampleTimerText2"]
                            <span class="kbd">http://localhost:5000</span>.
                            @Loc["ExampleTimerText3"]
                            <span class="kbd">@Loc["TriggerCategory_Initiative"] - @Loc["TriggerDisplay_InitiativeNext"]</span>
                            @Loc["ExampleTimerText4"]
                            <span class="kbd">/api/timer/start</span>.
                        </p>
                        <div class="assist-example">{
  "creature": "{{Data.currentCreatureName}}",
  "combat": "{{Data.combatName}}"
}</div>
                    </div>
                </MudExpansionPanel>

                <MudExpansionPanel Text="@Loc["ExampleNumericMaxTitle"]">
                    <div class="assist-box">
                        <p>
                            @Loc["ExampleNumericMaxText1"]
                            <span class="kbd">@Loc["TriggerCategory_Customfields"] - @Loc["TriggerDisplay_NumericReachedMaxValue"]</span>.
                            @Loc["ExampleNumericMaxText2"]
                        </p>
                    </div>
                </MudExpansionPanel>

                <MudExpansionPanel Text="@Loc["TroubleshootingTitle"]">
                    <div class="assist-box">
                        <p>@Loc["TroubleshootingText"]</p>
                    </div>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </ChildContent>
    </MudExpansionPanel>
    </MudExpansionPanels>

    <ExternalAppsEditor ExternalApps="_config.ExternalApps" OnAdd="AddExternalApp" OnRemove="RemoveExternalApp" />

    <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin:22px 0 4px 0;">
        <h2 class="dc-h2" style="border:0;padding-bottom:0;">@Loc["AutomationsSectionTitle"]</h2>
        <button type="button" class="dc-btn dc-btn-out" @onclick="AddBinding">
            <DcIcon Name="add" />
            @Loc["AddAutomation"]
        </button>
    </div>

    <div class="automations-list">
        @foreach (var binding in _config.Bindings.ToList())
        {
            <AutomationBindingEditor Binding="binding" ExternalApps="_config.ExternalApps" OnRemove="RemoveBinding" />
        }
    </div>
</div>

<DeliveryLogViewer EventPublisher="EventPublisher" />

@code {
    private AutomationConfiguration _config = new();

    private bool _assistanceExpanded
    {
        get => LocalPreferences.Get("AssistanceAutomations", false);
        set => LocalPreferences.Set("AssistanceAutomations", value);
    }

    protected override async Task OnInitializedAsync()
    {
        _config = await ConfigService.GetConfigurationAsync();
    }

    private void AddExternalApp()
    {
        _config.ExternalApps.Add(new ExternalAppDefinition { Name = Loc["NewAppName"].Value });
    }

    private void RemoveExternalApp(ExternalAppDefinition app)
    {
        _config.ExternalApps.Remove(app);

        foreach (var binding in _config.Bindings)
        {
            foreach (var action in binding.Actions.OfType<HttpRequestActionDefinition>())
            {
                if (action.ExternalAppId == app.Id)
                {
                    action.ExternalAppId = null;
                }
            }
        }
    }

    private void AddBinding()
    {
        _config.Bindings.Add(new EventActionBinding
        {
            Name = Loc["NewAutomationName"].Value,
            Trigger = new EventTriggerDefinition { Kind = EventTriggerKinds.InitiativeNext }
        });
    }

    private void RemoveBinding(EventActionBinding binding)
    {
        _config.Bindings.Remove(binding);
    }

    private async Task Save()
    {
        await ConfigService.SaveAsync();
        PopupNotificationService.Show(Loc["SaveSuccessTitle"].Value, Loc["SaveSuccessMessage"].Value, PopupNotificationService.Type.SUCCESS, 2000);
    }
}
