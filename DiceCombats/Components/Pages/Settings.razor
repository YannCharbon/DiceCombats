@page "/settings"

@using System.Globalization
@inject DiceCombatsService CombatService
@inject IStringLocalizer<Resources.Localization.Settings> Loc

@* Read against Home.razor and CreaturesExplorer.razor: a dc-h1 title over a
   dc-sub, sections introduced by a dc-pill, content on dc-panel with its
   nested blocks a step up the surface ramp, secondary lines in dc-meta and
   every button in the dc-btn family. What this page carried instead was bare
   bootstrap h5/h6 headings, a <br /> for spacing and an inline opacity on the
   disabled language button. *@

<h1 class="dc-h1">@Loc["TitleSettings"]</h1>
<p class="dc-sub" style="margin-bottom:18px;">@Loc["SettingsSubtitle"]</p>

<div class="dc-stack">

    <div class="dc-panel">
        <div style="display:flex;">
            <div class="dc-pill">
                <DcIcon Name="public" Size="26" />
                <h3>@Loc["TitleLanguages"]</h3>
            </div>
        </div>

        @* The language of a language button is the point of it, so these two labels
           are deliberately not localised: each one says, in its own language, what
           it switches to. The active one is shown as an inert outlined button —
           app.css has a real .dc-btn:disabled rule, so the class does the dimming. *@
        <div class="dc-irow dc-irow-wrap" style="gap:10px;margin-top:14px;">
            @if (CombatService.IsCurrentCulture("en"))
            {
                <button type="button" class="dc-btn dc-btn-out" disabled>
                    <DcIcon Name="check" />
                    English
                </button>
            }
            else
            {
                <button type="button" class="dc-btn dc-btn-fill"
                        @onclick="@(() => (Application.Current as App)?.SetCultureAndReload("en"))">Switch to English</button>
            }

            @if (CombatService.IsCurrentCulture("fr"))
            {
                <button type="button" class="dc-btn dc-btn-out" disabled>
                    <DcIcon Name="check" />
                    Français
                </button>
            }
            else
            {
                <button type="button" class="dc-btn dc-btn-fill"
                        @onclick="@(() => (Application.Current as App)?.SetCultureAndReload("fr"))">Passer au français</button>
            }
        </div>
    </div>

    <div class="dc-panel">
        <div style="display:flex;">
            <div class="dc-pill">
                <DcIcon Name="sync" Size="26" />
                <h3>@Loc["TitleUpdates"]</h3>
            </div>
        </div>

        @* The release check is a statement about the app, so it reads as a note
           (--s4 on the panel's --s3) rather than as two stray headings. The
           strings stay the hardcoded per-culture pairs they already were. *@
        <div class="dc-note" style="margin-top:14px;">
            @* Three outcomes, not two. The page used to render "up to date" for
               anything that was not a confirmed update, so a refused request -
               which is what GitHub sends once the hourly limit for the IP is
               used up - looked exactly like good news. *@
            @if (_update is { State: DCUpdateCheckState.UpdateAvailable, Release: not null })
            {
                <div class="dc-irow" style="gap:9px;">
                    <DcIcon Name="download" Size="18" Class="dc-i-info" />
                    @if (CombatService.IsCurrentCulture("fr"))
                    {
                        <span>DiceCombats <b>@_update.Release.tag_name</b> est disponible</span>
                    }
                    else
                    {
                        <span>DiceCombats <b>@_update.Release.tag_name</b> is available.</span>
                    }
                </div>
                <div class="dc-meta" style="margin-top:7px;">
                    @if (CombatService.IsCurrentCulture("fr"))
                    {
                        <text>Se rendre sur <a href="@_update.Release.html_url">@_update.Release.html_url</a> pour télécharger la mise à jour.</text>
                    }
                    else
                    {
                        <text>Visit <a href="@_update.Release.html_url">@_update.Release.html_url</a> to download the update.</text>
                    }
                </div>
            }
            else if (_update?.State == DCUpdateCheckState.UpToDate)
            {
                <div class="dc-irow" style="gap:9px;">
                    <DcIcon Name="check-circle" Size="18" Class="dc-i-accent" />
                    @if (CombatService.IsCurrentCulture("fr"))
                    {
                        <span>DiceCombats est à jour.</span>
                    }
                    else
                    {
                        <span>DiceCombats is up to date.</span>
                    }
                </div>
            }
            else if (_update?.State == DCUpdateCheckState.CheckFailed)
            {
                <div class="dc-irow" style="gap:9px;">
                    <DcIcon Name="error" Size="18" Class="dc-i-warn" />
                    @if (CombatService.IsCurrentCulture("fr"))
                    {
                        <span>Impossible de joindre GitHub pour vérifier les mises à jour.</span>
                    }
                    else
                    {
                        <span>Could not reach GitHub to check for updates.</span>
                    }
                </div>
            }
            else
            {
                <div class="dc-irow" style="gap:9px;">
                    <DcIcon Name="access-time" Size="18" Class="dc-i-muted" />
                    @if (CombatService.IsCurrentCulture("fr"))
                    {
                        <span>Recherche de mises à jour…</span>
                    }
                    else
                    {
                        <span>Checking for updates…</span>
                    }
                </div>
            }

            <div class="dc-irow dc-irow-wrap" style="gap:12px;margin-top:10px;">
                <button type="button" class="dc-btn dc-btn-out dc-btn-sm"
                        disabled="@_updateChecking" @onclick="CheckUpdateNow">
                    <DcIcon Name="sync" Size="16" />
                    @if (CombatService.IsCurrentCulture("fr"))
                    {
                        <text>@(_updateChecking ? "Vérification…" : "Vérifier maintenant")</text>
                    }
                    else
                    {
                        <text>@(_updateChecking ? "Checking…" : "Check now")</text>
                    }
                </button>
                @if (_update?.CheckedUtc is DateTime updateCheckedAt)
                {
                    <span class="dc-meta">
                        @(CombatService.IsCurrentCulture("fr") ? "Dernière vérification " : "Last checked ")
                        @updateCheckedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </span>
                }
            </div>
        </div>
    </div>

    <div class="dc-panel" style="margin-bottom:20px;">
        <div style="display:flex;">
            @* "help" read as an FAQ: this panel is the app's identity card —
               version, copyright and the release notes document. *@
            <div class="dc-pill">
                <DcIcon Name="text-snippet" Size="26" />
                <h3>@Loc["TitleAbout"]</h3>
            </div>
        </div>

        <div class="dc-irow dc-irow-wrap" style="gap:13px;margin-top:14px;">
            @* The app's own mark. A generic glyph here said nothing: this line
               names the software and its version, so the identifying image is
               the logo, and it carries no tile because the logo has its own
               colours and shape. *@
            <img src="dicecombats_logo.svg" width="46" height="46" alt="" />
            <div class="dc-strip-body">
                <div class="dc-strip-name">@Loc["CurrentSoftware"] DiceCombats @CombatService.GetVersion()</div>
                <div class="dc-meta">&copy; Copyright Yann Charbon</div>
            </div>
        </div>

        <WelcomeMessage SettingsView="true" NewVersion="true" />
    </div>

</div>

<div>
    <!--Dummy to render space at bottom of page-->
</div>

@code {
    private DCUpdateStatus? _update;
    private bool _updateChecking;

    /// An explicit request always goes to the network; the automatic check
    /// honours the service's interval.
    async Task CheckUpdateNow()
    {
        if (_updateChecking) return;
        _updateChecking = true;
        StateHasChanged();
        try { _update = await CombatService.CheckUpdateAsync(force: true); }
        finally { _updateChecking = false; }
    }

    // firstRender matters: this ends in StateHasChanged, so without the guard
    // the render it causes runs this again - an endless loop that spent the
    // hourly GitHub quota for the IP in seconds, after which every reply is 403
    // and the update it had just found read as "up to date".
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _update = await CombatService.CheckUpdateAsync();
        StateHasChanged();
    }
}
