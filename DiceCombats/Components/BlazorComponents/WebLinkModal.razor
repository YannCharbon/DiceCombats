@implements IAsyncDisposable

@inject IJSRuntime JS
@inject IStringLocalizer<Resources.Localization.CreatureManager> Loc

<style>
    /* Same shell as GenericModal, with a browser strip and a page instead of a
       scrolling body. */
    .weblink-modal {
        position: fixed;
        inset: 0;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 5000;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .weblink-content {
        display: flex;
        flex-direction: column;
        width: 780px;
        max-width: 80%;
        height: 620px;
        max-height: 76vh;
        max-height: 76dvh;
        background-color: #2D2D2D;
        box-shadow: 0 2px 10px rgba(255, 255, 255, 0.2);
        border-radius: 10px;
        overflow: hidden;
    }

    .weblink-head {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border-bottom: 1px solid #444;
        flex: 0 0 auto;
    }

    .weblink-url {
        flex: 1 1 auto;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: #A0A0A0;
        font-size: 0.8rem;
    }

    .weblink-frame {
        flex: 1 1 auto;
        min-height: 0;
        border: none;
        width: 100%;
        background-color: #FFFFFF;
    }

    .weblink-footer {
        display: flex;
        justify-content: flex-end;
        padding: 12px 20px;
        padding-bottom: calc(12px + var(--dc-safe-area-bottom));
        background: #2D2D2D;
        border-top: 1px solid #444;
        flex: 0 0 auto;
    }

    @@media screen and (max-width: 768px) {
        .weblink-content {
            width: 100%;
            max-width: 100%;
            height: 100vh;
            height: 100dvh;
            max-height: 100vh;
            max-height: 100dvh;
            border-radius: 0;
        }

        .weblink-head {
            padding-top: calc(8px + var(--dc-safe-area-top));
        }

        .weblink-footer {
            padding: 10px 16px;
            padding-bottom: calc(10px + var(--dc-safe-area-bottom));
        }
    }
</style>

@if (!string.IsNullOrEmpty(_url))
{
    <div class="weblink-modal" @onclick="Close">
        <div class="weblink-content" @onclick:stopPropagation="true">
            <div class="weblink-head">
                <MudIcon Icon="@Icons.Material.Filled.Public" Style="font-size:18px;color:#00B0B0;" />
                <span class="weblink-url">@_url</span>
                <MudIconButton Icon="@Icons.Material.Filled.OpenInBrowser" Size="Size.Small" Color="Color.Primary"
                               OnClick="OpenExternally" title="@Loc["LinkOpenInBrowser"]" />
            </div>

            <iframe class="weblink-frame" src="@_url"></iframe>

            <div class="weblink-footer">
                <MudButton OnClick="Close" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Check" IconColor="Color.Success" Size="Size.Large">OK</MudButton>
            </div>
        </div>
    </div>
}

@code {
    private DotNetObjectReference<WebLinkModal>? _reference;
    private string _url = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _reference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("dcRegisterSheetLinks", _reference);
    }

    /// Called from the click handler installed on the page, for links that sit
    /// inside a sheet whose creature asks for them to stay in the app.
    [JSInvokable]
    public Task OpenLink(string url)
    {
        _url = url;
        return InvokeAsync(StateHasChanged);
    }

    private void Close()
    {
        _url = string.Empty;
    }

    private async Task OpenExternally()
    {
        string url = _url;
        _url = string.Empty;

        try
        {
            await Launcher.OpenAsync(url);
        }
        catch
        {
            // Nothing to do: the page simply stays closed.
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("dcUnregisterSheetLinks");
        }
        catch
        {
            // The webview may already be gone when the app closes.
        }

        _reference?.Dispose();
    }
}
