@* Only ever shown from the creatures explorer, so it shares that page's
   resources instead of carrying a resx of its own. *@
@inject DiceCombatsService CombatService
@inject IStringLocalizer<Resources.Localization.CreaturesExplorer> Loc

<style>
    .pg-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 6px;
    }

    .pg-players {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 0 12px;
    }

    .pg-hint {
        color: var(--t3);
        font-size: 13px;
    }
</style>

<h3>@Loc["PlayerGroupsTitle"]</h3>
<p class="dc-sub" style="margin-bottom:14px;">@Loc["PlayerGroupsSubtitle"]</p>

<button type="button" class="dc-btn dc-btn-fill" @onclick="AddGroup">
    <DcIcon Name="add" />
    @Loc["NewPlayerGroupBtn"]
</button>

@if (Players.Count == 0)
{
    <p class="pg-hint" style="padding:20px 0;">@Loc["NoPlayers"]</p>
}
else if (CombatService.GetPlayerGroups().Count == 0)
{
    <p class="pg-hint" style="padding:20px 0;">@Loc["NoPlayerGroups"]</p>
}

<MudExpansionPanels MultiExpansion="true" Style="margin-top:14px;">
    @foreach (DCPlayerGroup group in CombatService.GetPlayerGroups())
    {
        var g = group;
        <MudExpansionPanel Expanded="false">
            <TitleContent>
                <div class="dc-irow" style="gap:12px;">
                    <DcIcon Name="groups" Size="18" Class="dc-i-accent" />
                    <span>@(string.IsNullOrWhiteSpace(g.Name) ? Loc["UnnamedPlayerGroup"] : g.Name)</span>
                    <span class="dc-sub" style="margin:0;">@CombatService.GetPlayerGroupMembers(g).Count @Loc["PlayersMeta"]</span>
                </div>
            </TitleContent>
            <ChildContent>
                <div class="pg-row">
                    @* Immediate="true" was the MudTextField behaviour: @oninput renames on
                       every keystroke, where @onchange would only rename on blur. *@
                    <div class="dc-field" style="flex:1 1 240px;">
                        <span class="dc-flabel">@Loc["PlayerGroupName"]</span>
                        <input type="text" class="dc-inp" value="@g.Name"
                               @oninput="@(e => Rename(g, e.Value?.ToString() ?? string.Empty))" />
                    </div>
                    <button type="button" class="dc-ib dc-danger" style="align-self:flex-end;"
                            title="@Loc["DeletePlayerGroupBtn"]" aria-label="@Loc["DeletePlayerGroupBtn"]"
                            @onclick="() => DeleteGroup(g)">
                        <DcIcon Name="delete" />
                    </button>
                </div>
                <div class="pg-players">
                    @foreach (DCCreature player in Players)
                    {
                        var p = player;
                        <label class="dc-chk" style="padding:4px 0;">
                            <input type="checkbox" checked="@g.PlayerIds.Contains(p.Id)"
                                   @onchange="@(e => ToggleMember(g, p, e.Value is bool v && v))" />
                            <span>@p.Name</span>
                        </label>
                    }
                </div>
            </ChildContent>
        </MudExpansionPanel>
    }
</MudExpansionPanels>

@code {
    private List<DCCreature> Players =>
        CombatService.GetCreatureList()
            .Where(x => x.IsPlayer)
            .OrderBy(x => x.Name, StringComparer.CurrentCulture)
            .ToList();

    private void AddGroup()
    {
        CombatService.AddPlayerGroup(new DCPlayerGroup(Loc["NewPlayerGroupName"]));
    }

    private void DeleteGroup(DCPlayerGroup group)
    {
        CombatService.DeletePlayerGroup(group);
    }

    private void Rename(DCPlayerGroup group, string name)
    {
        group.Name = name;
        CombatService.SavePlayerGroups();
    }

    private void ToggleMember(DCPlayerGroup group, DCCreature player, bool selected)
    {
        if (selected)
        {
            if (!group.PlayerIds.Contains(player.Id))
            {
                group.PlayerIds.Add(player.Id);
            }
        }
        else
        {
            group.PlayerIds.Remove(player.Id);
        }

        CombatService.SavePlayerGroups();
    }
}
