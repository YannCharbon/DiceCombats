@*
    Tells the user when a data file could not be read or saved, and how a
    restore ended (the pages are rebuilt after it). Drawn like
    DcConfirm, with a single button: there is nothing to decide, only
    something to know.
*@

@implements IDisposable
@inject StorageNotices Notices
@inject IStringLocalizer<DiceCombats.Resources.Localization.Portability> Loc

@if (_notices.Count > 0)
{
    <div class="dc-confirm-scrim" @onclick="Dismiss">
        <div class="dc-confirm" role="alertdialog" aria-modal="true" @onclick:stopPropagation="true">
            @foreach (var notice in _notices)
            {
                <p class="dc-confirm-msg">@Message(notice)</p>
            }
            <div class="dc-confirm-foot">
                <button type="button" class="dc-btn dc-btn-fill" @onclick="Dismiss">
                    <DcIcon Name="check" />
                    @Loc["AlertCloseBtn"]
                </button>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<StorageNotice> _notices = Array.Empty<StorageNotice>();

    protected override void OnInitialized()
    {
        Notices.Changed += OnChanged;
        _notices = Notices.Pending;
    }

    private string Message(StorageNotice notice) => notice.Kind switch
    {
        StorageNoticeKind.LoadFailed => string.Format(Loc["ErrorLoadFailed"], notice.Detail),
        StorageNoticeKind.SaveFailed => string.Format(Loc["ErrorSaveFailed"], notice.Detail),
        StorageNoticeKind.RestoreDone => Loc["RestoreDone"],
        StorageNoticeKind.RestoreRollbackFailed => string.Format(Loc["RestoreRollbackFailed"], notice.Detail),
        _ => string.Format(Loc["RestoreFailed"], notice.Detail),
    };

    private void OnChanged()
    {
        InvokeAsync(() =>
        {
            _notices = Notices.Pending;
            StateHasChanged();
        });
    }

    private void Dismiss()
    {
        Notices.DismissAll();
    }

    public void Dispose()
    {
        Notices.Changed -= OnChanged;
    }
}
