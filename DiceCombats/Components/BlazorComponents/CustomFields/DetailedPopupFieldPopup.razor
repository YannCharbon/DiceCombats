@using DiceCombats
@using DiceCombats.Rendering
@using DiceCombats.Rendering.Contracts
@inject DiceCombatsService CombatService
@inject RendererRegistry Renderers
@inject IStringLocalizer<Resources.Localization.DetailedPopupFieldPopup> Loc
@inject IFileHandler FileHandler
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService

<style>
    /* Own class names on purpose: this popup is rendered inside a creature card
       of the combat manager's own masonry grid, and Masonry collects items from
       the whole subtree of its container. Sharing '.masonry-item' made the outer
       grid adopt these items and reserve empty rows for them. */
    .dpf-masonry-layout {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .dpf-masonry-item {
        display: block;
        width: calc(50% - 1rem);
        margin-bottom: 1rem;
        /* See the combat manager: a transform here would make this element the
           containing block of the surrounding position:fixed modal. */
        transform: none !important;
    }

    @@media screen and (max-width: 768px) {
        .dpf-masonry-item {
            width: calc(100% - 1rem);
        }
    }

    @@media screen and (max-width: 480px) {
        .dpf-masonry-item {
            width: 100%;
        }
    }

    /* The search box keeps its leading icon inside the well, which a plain
       .dc-inp has no slot for. */
    .dpf-search {
        position: relative;
        display: flex;
        align-items: center;
        flex: 1 1 240px;
        min-width: 0;
    }

    .dpf-search-ico {
        position: absolute;
        left: 9px;
        top: 50%;
        transform: translateY(-50%);
        display: inline-flex;
        color: var(--t3);
        pointer-events: none;
    }

    .dpf-search input {
        padding-left: 32px;
    }

    /* The eight help panels are the one MudBlazor widget left in this popup:
       nothing in the vocabulary expands and collapses. app.css drags
       .mud-expand-panel onto a Verdant surface only inside .dc-fbody /
       .dc-panel, neither of which wraps this block, so the surface is set
       here instead of widening that rule. */
    .dpf-help {
        margin-bottom: 12px;
    }

    .dpf-help .mud-expand-panel {
        background-color: var(--s4);
    }
</style>

<script>
    // Also defined by the combat manager; either component may render first, and this
    // popup is used from the creature manager too, where the other script is absent.
    window.dcMasonrySignature = window.dcMasonrySignature || function (grid, itemSelector) {
        const items = grid.querySelectorAll(itemSelector);
        let sig = grid.clientWidth + ':' + items.length;
        for (let i = 0; i < items.length; i++) {
            sig += '|' + items[i].offsetHeight;
        }
        return sig;
    };

    // Kept separate from the combat manager's initializeMasonry: both scripts are
    // global, so a shared name meant whichever component rendered last defined it.
    // Takes the popup's own root element: one popup exists per creature card, so
    // looking grids up by id picked the wrong one (and only ever the first).
    window.initializeDetailedPopupMasonry = (root) => {
        if (!root) {
            return;
        }
        root.querySelectorAll('.dpf-masonry-layout').forEach(grid => {
            if (grid.dcMasonry) {
                const signature = window.dcMasonrySignature(grid, '.dpf-masonry-item');
                if (signature === grid.dcMasonrySignatureValue) {
                    return;
                }
                grid.dcMasonrySignatureValue = signature;
                grid.dcMasonry.reloadItems();
                grid.dcMasonry.layout();
                return;
            }
            grid.dcMasonry = new Masonry(grid, {
                itemSelector: '.dpf-masonry-item',
                columnWidth: '.dpf-masonry-item',
                percentPosition: true,
                gutter: 10,
                // No animated relayout: the transform Outlayer uses to animate a move
                // would make the item the containing block of this popup's own
                // position:fixed modal. See the note in CombatManager.razor.
                transitionDuration: 0
            });
            grid.dcMasonrySignatureValue = window.dcMasonrySignature(grid, '.dpf-masonry-item');
        });
    };
</script>

@if (!string.IsNullOrWhiteSpace(_combinedCss))
{
    <style>
        @_combinedCss
    </style>
}

<h4 style="text-align:center;margin-bottom:10px;">@DetailedPopupField.Title</h4>

@if (EditionMode)
{
    <div class="dc-irow" style="margin-bottom:10px;">
        <label class="dc-chk">
            <input type="checkbox" @bind="_showEditorHelp" />
            @Loc["DetailedPopupShowEditorHelp"]
        </label>
    </div>

    @if (_showEditorHelp)
    {
        <div class="dpf-help">
            <MudExpansionPanels MultiExpansion="true" Dense="true" Elevation="0">
                <MudExpansionPanel Text="@Loc["DetailedPopupOverviewTitle"]">
                    <div class="dc-note">
                        @((MarkupString)Loc["DetailedPopupOverviewBody"].Value)
                    </div>
                </MudExpansionPanel>

                <MudExpansionPanel Text="@Loc["DetailedPopupTextTitle"]">
                    <div class="dc-note">
                        @((MarkupString)Loc["DetailedPopupTextBody"].Value)
                    </div>
                </MudExpansionPanel>

                <MudExpansionPanel Text="@Loc["DetailedPopupMarkdownTitle"]">
                    <div class="dc-note">
                        @((MarkupString)Loc["DetailedPopupMarkdownBody"].Value)
                    </div>
                </MudExpansionPanel>

                <MudExpansionPanel Text="@Loc["DetailedPopupPdfTitle"]">
                    <div class="dc-note">
                        @((MarkupString)Loc["DetailedPopupPdfBody"].Value)
                    </div>
                </MudExpansionPanel>

                <MudExpansionPanel Text="@Loc["DetailedPopupHtmlHowItWorksTitle"]">
                    <div class="dc-note">
                        @((MarkupString)Loc["DetailedPopupHtmlHowItWorksBody"].Value)
                    </div>
                </MudExpansionPanel>

                <MudExpansionPanel Text="@Loc["DetailedPopupHtmlTipsTitle"]">
                    <div class="dc-note">
                        @((MarkupString)Loc["DetailedPopupHtmlTipsBody"].Value)
                    </div>
                </MudExpansionPanel>

                <MudExpansionPanel Text="@Loc["DetailedPopupHtmlQuickStartTitle"]">
                    <div class="dc-note">
                        @((MarkupString)Loc["DetailedPopupHtmlQuickStartBody"].Value)
                    </div>
                </MudExpansionPanel>

                <MudExpansionPanel Text="@Loc["DetailedPopupTroubleshootingTitle"]">
                    <div class="dc-note">
                        @((MarkupString)Loc["DetailedPopupTroubleshootingBody"].Value)
                    </div>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </div>
    }

    <hr />
}

@if (EditionMode)
{
    @foreach (var entry in DetailedPopupField.Contents)
    {
        <div class="dc-msec" style="margin-bottom:12px;">
            <div class="dc-msec-head">
                <div class="dc-field" style="flex:1 1 200px;min-width:160px;">
                    <span class="dc-flabel">@Loc["DetailedPopupContentNameLabel"]</span>
                    <input class="dc-inp" type="text" value="@entry.Name" @onchange="@((ChangeEventArgs e) => entry.Name = e.Value?.ToString() ?? string.Empty)" />
                </div>
                <div class="dc-field" style="width:170px;">
                    <span class="dc-flabel">@Loc["DetailedPopupKindLabel"]</span>
                    <select class="dc-inp" @bind="entry.Kind">
                        <option value="text">@Loc["DetailedPopupKindTextLabel"]</option>
                        <option value="markdown">@Loc["DetailedPopupKindMarkdownLabel"]</option>
                        <option value="html">@Loc["DetailedPopupKindHtmlLabel"]</option>
                        <option value="pdf">@Loc["DetailedPopupKindPdfLabel"]</option>
                    </select>
                </div>
                <button type="button" class="dc-btn dc-btn-danger" style="margin-left:auto;"
                        disabled="@entry.ReadOnly"
                        title="@Loc["DetailedPopupDeleteTooltip"]"
                        @onclick="() => DeleteContent(entry)">
                    <DcIcon Name="delete" Size="16" />@Loc["DetailedPopupDeleteButton"]
                </button>
            </div>

            @* === TEXT === *@
            @if (entry.Kind == "text")
            {
                <div class="dc-field">
                    <span class="dc-flabel">@Loc["DetailedPopupTextContentLabel"]</span>
                    <textarea class="dc-inp" rows="8" @bind="entry.Inline"></textarea>
                </div>
            }
            @* === MARKDOWN === *@
            else if (entry.Kind == "markdown")
            {
                <div class="dc-field">
                    <span class="dc-flabel">@Loc["DetailedPopupMarkdownContentLabel"]</span>
                    <textarea class="dc-inp" rows="10" @bind="entry.Inline"></textarea>
                </div>
            }
            @* === HTML (templated) === *@
            else if (entry.Kind == "html")
            {
                @* Inline help for this entry only *@
                @if (_showEditorHelp)
                {
                    <div class="dc-note" style="margin-bottom:10px;">
                        @((MarkupString)Loc["DetailedPopupInlineHelpHtml"].Value)
                    </div>
                }

                var selector = GetMeta(entry, "selector");
                var template = GetMeta(entry, "template");
                var css = GetMeta(entry, "css");
                var mapJson = GetMeta(entry, "map.json");
                var source = GetHtmlSource(entry);

                <div class="dc-dgrid" style="margin-top:4px;align-items:end;">
                    <div class="dc-field">
                        <span class="dc-flabel">@Loc["DetailedPopupSelectorLabel"]</span>
                        <input class="dc-inp" type="text" spellcheck="false" value="@selector"
                               @onchange="@((ChangeEventArgs e) => SetMeta(entry, "selector", e.Value?.ToString()))" />
                    </div>

                    @* Two chips rather than two radio buttons: the same two states
                       through the same handler, and the vocabulary has a toggle but
                       no radio. *@
                    <div class="dc-irow" style="gap:6px;">
                        <button type="button" class="dc-tog @(source == "inline" ? "dc-on" : "")"
                                @onclick="@(() => OnHtmlSourceChanged(entry, "inline"))">
                            @Loc["DetailedPopupHtmlSourceInlineLabel"]
                        </button>
                        <button type="button" class="dc-tog @(source == "file" ? "dc-on" : "")"
                                @onclick="@(() => OnHtmlSourceChanged(entry, "file"))">
                            @Loc["DetailedPopupHtmlSourceFileLabel"]
                        </button>
                    </div>
                </div>

                <div class="dc-field" style="margin-top:10px;">
                    <span class="dc-flabel">@Loc["DetailedPopupTemplateLabel"]</span>
                    <textarea class="dc-inp" rows="10" value="@template"
                              @onchange="@((ChangeEventArgs e) => SetMeta(entry, "template", e.Value?.ToString()))"></textarea>
                </div>

                <div class="dc-field" style="margin-top:10px;">
                    <span class="dc-flabel">@Loc["DetailedPopupCssLabel"]</span>
                    <textarea class="dc-inp" rows="8" value="@css"
                              @onchange="@((ChangeEventArgs e) => SetMeta(entry, "css", e.Value?.ToString()))"></textarea>
                </div>

                <div class="dc-field" style="margin-top:10px;">
                    <span class="dc-flabel">@Loc["DetailedPopupMapJsonLabel"]</span>
                    <textarea class="dc-inp" rows="8" value="@mapJson"
                              @onchange="@((ChangeEventArgs e) => SetMeta(entry, "map.json", e.Value?.ToString()))"></textarea>
                </div>

                @if (source == "inline")
                {
                    <div class="dc-field" style="margin-top:10px;">
                        <span class="dc-flabel">@Loc["DetailedPopupHtmlContentLabel"]</span>
                        <textarea class="dc-inp" rows="12" @bind="entry.Inline"></textarea>
                    </div>
                }
                else
                {
                    <div class="dc-irow dc-irow-wrap" style="margin-top:10px;align-items:flex-end;">
                        <div class="dc-field" style="flex:1 1 260px;min-width:180px;">
                            <span class="dc-flabel">@Loc["DetailedPopupFilePathLabel"]</span>
                            <input class="dc-inp" type="text" readonly value="@entry.FilePath" />
                        </div>
                        <div class="dc-field">
                            <button type="button" class="dc-btn dc-btn-fill" @onclick="() => PickFileAsync(entry)">
                                <DcIcon Name="upload-file" Size="16" />@Loc["DetailedPopupPickFileButton"]
                            </button>
                            @if (entry.Blob is { Length: > 0 })
                            {
                                <span class="dc-flabel">
                                    @string.Format(Loc["DetailedPopupLoadedBytesCaption"], entry.Blob.Length)
                                </span>
                            }
                        </div>
                    </div>
                }
            }
            @* === PDF === *@
            else if (entry.Kind == "pdf")
            {
                @if (_showEditorHelp)
                {
                    <div class="dc-note" style="margin-bottom:10px;">
                        @((MarkupString)Loc["DetailedPopupPdfInlineHelp"].Value)
                    </div>
                }

                <div class="dc-irow dc-irow-wrap" style="margin-top:4px;align-items:flex-end;">
                    <div class="dc-field" style="flex:1 1 260px;min-width:180px;">
                        <span class="dc-flabel">@Loc["DetailedPopupFilePathLabel"]</span>
                        <input class="dc-inp" type="text" readonly value="@entry.FilePath" />
                    </div>
                    <button type="button" class="dc-btn dc-btn-fill" @onclick="() => PickFileAsync(entry)">
                        <DcIcon Name="upload-file" Size="16" />@Loc["DetailedPopupPickFileButton"]
                    </button>
                    @if (entry.Blob is { Length: > 0 })
                    {
                        <span class="dc-flabel">
                            @string.Format(Loc["DetailedPopupLoadedBytesCaption"], entry.Blob.Length)
                        </span>
                    }
                </div>
            }
        </div>
    }

    <button type="button" class="dc-btn dc-btn-fill" @onclick="() => DetailedPopupField.AddNewContent()">
        <DcIcon Name="add" Size="16" />@Loc["DetailedPopupAddNewContentButton"]
    </button>
}
else
{
    <div class="dc-irow dc-irow-wrap" style="margin-bottom:10px;gap:10px;">
        @* Three presentations, one switch. Bound to DisplayMode: its setter is what
           keeps the legacy RenderModeGridEnabled flag in step. *@
        <div class="dc-irow" style="gap:6px;flex:none;" title="@Loc["DetailedPopupToggleGridTooltip"]">
            <button type="button" class="dc-tog @(Mode == DCDetailedPopupDisplayMode.Tabs ? "dc-on" : "")"
                    @onclick="@(() => SetDisplayMode(DCDetailedPopupDisplayMode.Tabs))">
                <DcIcon Name="tab" Size="14" />
            </button>
            <button type="button" class="dc-tog @(Mode == DCDetailedPopupDisplayMode.List ? "dc-on" : "")"
                    @onclick="@(() => SetDisplayMode(DCDetailedPopupDisplayMode.List))">
                <DcIcon Name="list" Size="14" />
            </button>
            <button type="button" class="dc-tog @(Mode == DCDetailedPopupDisplayMode.Grid ? "dc-on" : "")"
                    @onclick="@(() => SetDisplayMode(DCDetailedPopupDisplayMode.Grid))">
                <DcIcon Name="grid-view" Size="14" />
            </button>
        </div>
        <div class="dpf-search">
            <span class="dpf-search-ico"><DcIcon Name="search" Size="16" /></span>
            <input class="dc-inp" type="text" placeholder="@Loc["DetailedPopupSearchPlaceholder"]"
                   value="@_queryDraft" @oninput="OnQueryInput" />
        </div>
    </div>

    @* Wrapper so the initializer can reach this popup's grids without ids: there
       is one html/pdf grid per group, and one popup per creature card. *@
    <div @ref="_gridsRoot">
    @if (Mode == DCDetailedPopupDisplayMode.Grid)
    {
        @foreach (var g in _visibleGroups.Where(g => g.Kind == "html" || g.Kind == "pdf"))
        {
            <div style="margin:14px 6px 6px;"><span class="dc-msec-title">@g.Title</span></div>
            <div class="dpf-masonry-layout" data-kind="@g.Kind">
                @foreach (var p in g.Pieces)
                {
                    <div class="dpf-masonry-item">
                        <div class="dc-msec">
                            @if (!string.IsNullOrWhiteSpace(p.ParentName))
                            {
                                <hr />
                            }
                            @p.UI
                        </div>
                    </div>
                }
            </div>
        }

        var tmGroups = _visibleGroups.Where(g => g.Kind != "html" && g.Kind != "pdf").ToList();

        @if (tmGroups.Count > 0)
        {
            <div class="dpf-masonry-layout" data-kind="text-markdown">

                @foreach (var g in tmGroups)
                {
                    <div class="dpf-masonry-item">
                        <div style="margin:14px 6px 6px;"><span class="dc-msec-title">@g.Title</span></div>

                        @foreach (var p in g.Pieces)
                        {
                            <div class="dc-msec" style="margin-bottom:10px;">
                                @if (!string.IsNullOrWhiteSpace(p.ParentName))
                                {
                                    <hr />
                                }
                                @p.UI
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
    else if (Mode == DCDetailedPopupDisplayMode.Tabs)
    {
        @* One group at a time. The chips are the group titles, and the pick falls
           back to the first group whenever the filter drops the chosen one. *@
        <div class="dc-irow dc-irow-wrap" style="gap:6px;margin-bottom:11px;">
            @foreach (var g in _visibleGroups)
            {
                var grp = g;
                <button type="button" class="dc-tog @(GroupKey(grp) == ActiveTabKey ? "dc-on" : "")"
                        @onclick="@(() => SelectTab(grp))">
                    @grp.Title
                </button>
            }
        </div>

        var active = ActiveGroup;

        @if (active != null)
        {
            <div class="dc-dstack">
                @foreach (var p in active.Pieces)
                {
                    <div class="dc-msec">
                        @p.UI
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="dc-dstack">
            @foreach (var g in _visibleGroups)
            {
                <div style="margin:14px 6px 6px;"><span class="dc-msec-title">@g.Title</span></div>
                @foreach (var p in g.Pieces)
                {
                    <div class="dc-msec">
                        @p.UI
                    </div>
                }
            }
        </div>
    }
    </div>
}

@code {
    [Parameter] public DCCreatureDetailedPopupField DetailedPopupField { get; set; } = default!;
    [Parameter] public bool EditionMode { get; set; } = false;

    private ElementReference _gridsRoot;

    private record PieceVM(string? ParentName, string Kind, RenderFragment UI, IIndexedText Index, string? Key);
    private record GroupVM(string Title, string Kind, List<PieceVM> Pieces);

    private readonly List<PieceVM> _allPieces = new();
    private List<GroupVM> _allGroups = new();
    private List<GroupVM> _visibleGroups = new();

    private string _query = string.Empty;
    private string _queryDraft = string.Empty;
    private System.Threading.CancellationTokenSource? _searchDebounce;
    private string _combinedCss = string.Empty;
    private bool _showEditorHelp = false;

    // Which group the tabs mode is showing, as "<kind>||<title>".
    private string? _activeTabKey;

    private DCDetailedPopupDisplayMode Mode => DetailedPopupField.DisplayMode;

    private string Query
    {
        get => _query;
        set
        {
            var v = value ?? string.Empty;
            if (_query == v) return;
            _query = v;
            _visibleGroups = FilterGroups(_allGroups, _query);
            EnsureActiveTab();
            StateHasChanged();
        }
    }

    /// <summary>
    /// The presentation is written to <see cref="DCCreatureDetailedPopupField.DisplayMode"/>
    /// and never to the legacy boolean: the enum's setter is what keeps that flag in step.
    /// </summary>
    private void SetDisplayMode(DCDetailedPopupDisplayMode mode)
    {
        DetailedPopupField.DisplayMode = mode;
        EnsureActiveTab();
        StateHasChanged();
    }

    private static string GroupKey(GroupVM group) => $"{group.Kind}||{group.Title}";

    private string? ActiveTabKey => ActiveGroup is null ? null : GroupKey(ActiveGroup);

    private GroupVM? ActiveGroup
        => _visibleGroups.FirstOrDefault(g => GroupKey(g) == _activeTabKey) ?? _visibleGroups.FirstOrDefault();

    private void SelectTab(GroupVM group)
    {
        _activeTabKey = GroupKey(group);
        StateHasChanged();
    }

    /// Opens on the first group, and falls back to it when a re-filter drops the
    /// one that was selected.
    private void EnsureActiveTab()
    {
        if (_visibleGroups.Count == 0)
        {
            _activeTabKey = null;
            return;
        }

        if (_activeTabKey is null || !_visibleGroups.Any(g => GroupKey(g) == _activeTabKey))
            _activeTabKey = GroupKey(_visibleGroups[0]);
    }

    /// The box types freely and the filter runs a second later: rebuilding every
    /// group on each keystroke is what the debounce was there to avoid.
    private async Task OnQueryInput(ChangeEventArgs e)
    {
        _queryDraft = e.Value?.ToString() ?? string.Empty;

        _searchDebounce?.Cancel();
        var cts = new System.Threading.CancellationTokenSource();
        _searchDebounce = cts;

        try
        {
            await Task.Delay(1000, cts.Token);
        }
        catch (OperationCanceledException)
        {
            // A later keystroke took over.
            return;
        }

        if (cts.IsCancellationRequested) return;

        Query = _queryDraft;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The wrapper only exists outside edition mode.
        if (EditionMode) return;

        await JSRuntime.InvokeVoidAsync("initializeDetailedPopupMasonry", _gridsRoot);
    }

    protected override void OnParametersSet()
    {
        if (EditionMode) return;

        _allPieces.Clear();
        _allGroups.Clear();
        _combinedCss = BuildCombinedCss(DetailedPopupField.Contents);

        // Build pieces
        foreach (var e in DetailedPopupField.Contents)
        {
            var item = ToContentItem(e);
            var pieces = Renderers.RenderMany(item);
            foreach (var piece in pieces)
            {
                _allPieces.Add(new PieceVM(
                    ParentName: string.IsNullOrWhiteSpace(e.Name) ? null : e.Name,
                    Kind: e.Kind ?? string.Empty,
                    UI: piece.UI,
                    Index: piece.Index,
                    Key: piece.Key
                ));
            }
        }

        // Group by (Kind + ParentName) for clear delimitation
        var groupMap = new Dictionary<string, GroupVM>();
        foreach (var p in _allPieces)
        {
            var groupTitle = !string.IsNullOrWhiteSpace(p.ParentName)
                ? $"{p.ParentName}"
                : p.Kind.ToUpperInvariant();

            var key = $"{p.Kind}||{p.ParentName}";
            if (!groupMap.TryGetValue(key, out var g))
            {
                g = new GroupVM(groupTitle, p.Kind, new List<PieceVM>());
                groupMap[key] = g;
            }
            g.Pieces.Add(p);
        }
        _allGroups = groupMap.Values.ToList();

        _visibleGroups = FilterGroups(_allGroups, _query);
        EnsureActiveTab();
    }

    private static DiceCombats.Rendering.BasicContentItem ToContentItem(DCCreatureDetailedPopupField.ContentEntry e)
    {
        var meta = e.Meta as IReadOnlyDictionary<string, string>;
        return new DiceCombats.Rendering.BasicContentItem(
            e.Kind, e.Name, e.Blob, e.Inline, e.FilePath, meta ?? new Dictionary<string, string>());
    }

    private static string BuildCombinedCss(IEnumerable<DCCreatureDetailedPopupField.ContentEntry> contents)
    {
        var sb = new System.Text.StringBuilder();
        foreach (var c in contents)
        {
            if (!"html".Equals(c.Kind, System.StringComparison.OrdinalIgnoreCase)) continue;
            if (c.Meta.TryGetValue("css", out var css) && !string.IsNullOrWhiteSpace(css))
                sb.AppendLine(css);
        }
        return sb.ToString();
    }

    private static List<GroupVM> FilterGroups(List<GroupVM> groups, string q)
    {
        if (string.IsNullOrWhiteSpace(q)) return groups;

        var n = Normalize(q);
        var outList = new List<GroupVM>();
        foreach (var g in groups)
        {
            var keepPieces = new List<PieceVM>();

            // Match the group title itself
            if (Normalize(g.Title).Contains(n))
            {
                keepPieces.AddRange(g.Pieces);
            }
            else
            {
                foreach (var p in g.Pieces)
                {
                    // Match parent name / key
                    if ((!string.IsNullOrWhiteSpace(p.ParentName) && Normalize(p.ParentName).Contains(n)) ||
                        (!string.IsNullOrWhiteSpace(p.Key) && Normalize(p.Key).Contains(n)))
                    {
                        keepPieces.Add(p);
                        continue;
                    }

                    // Search in indexed texts
                    foreach (var (_, text) in p.Index.EnumerateDocuments())
                    {
                        if (Normalize(text).Contains(n))
                        {
                            keepPieces.Add(p);
                            break;
                        }
                    }
                }
            }

            if (keepPieces.Count > 0)
                outList.Add(new GroupVM(g.Title, g.Kind, keepPieces));
        }
        return outList;
    }

    private static string Normalize(string s)
    {
        if (string.IsNullOrEmpty(s)) return string.Empty;
        var form = s.Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder(form.Length);
        foreach (var ch in form)
        {
            var cat = System.Globalization.CharUnicodeInfo.GetUnicodeCategory(ch);
            if (cat != System.Globalization.UnicodeCategory.NonSpacingMark)
                sb.Append(ch);
        }
        return sb.ToString().Normalize(System.Text.NormalizationForm.FormC).ToLowerInvariant();
    }

    private static string GetMeta(DCCreatureDetailedPopupField.ContentEntry entry, string key)
        => entry.Meta.TryGetValue(key, out var v) ? v ?? string.Empty : string.Empty;

    private static void SetMeta(DCCreatureDetailedPopupField.ContentEntry entry, string key, string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            if (entry.Meta.ContainsKey(key)) entry.Meta.Remove(key);
        }
        else
        {
            entry.Meta[key] = value;
        }
    }

    private void OnHtmlSourceChanged(DCCreatureDetailedPopupField.ContentEntry entry, string v)
    {
        SetMeta(entry, "source", string.IsNullOrWhiteSpace(v) ? "inline" : v);
        StateHasChanged();
    }

    private static string GetHtmlSource(DCCreatureDetailedPopupField.ContentEntry entry)
    {
        var v = GetMeta(entry, "source");
        return (v == "file" || v == "inline") ? v : "inline";
    }

    private async Task PickFileAsync(DCCreatureDetailedPopupField.ContentEntry entry)
    {
        try
        {
            var (path, bytes) = await FileHandler.PickFileAsync();
            if (!string.IsNullOrWhiteSpace(path)) entry.FilePath = path;
            if (bytes is { Length: > 0 }) entry.Blob = bytes;
        }
        catch
        {
            // ignore
        }
    }

    private async Task DeleteContent(DCCreatureDetailedPopupField.ContentEntry entry)
    {
        if (entry is null) return;

        var opts = new DialogOptions
            {
                CloseOnEscapeKey = true,
                MaxWidth = MaxWidth.ExtraSmall,
                FullWidth = true,
            };

        var confirm = await DialogService.ShowMessageBoxAsync(
            title: Loc["DetailedPopupDeleteDialogTitle"],
            markupMessage: (MarkupString)Loc["DetailedPopupDeleteDialogMessage"].Value,
            yesText: Loc["DetailedPopupDeleteDialogYes"],
            cancelText: Loc["DetailedPopupDeleteDialogCancel"],
            options: opts
        );

        if (confirm == true)
        {
            DetailedPopupField.Contents.Remove(entry);
            StateHasChanged();
        }
    }
}
