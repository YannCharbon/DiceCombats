@using DiceCombats
@inject IStringLocalizer<Resources.Localization.CreatureCustomFieldRenderer> Loc

<style>
    /* The kinds list scrolls (.dc-mscroll), and .dc-pop is position:absolute, so
       a floating palette would be clipped by that scroller. These two pickers
       open in flow under their own row instead. */
    .hp-inline-pop {
        position: static;
        width: auto;
        max-width: none;
        margin: -1px 0 6px;
    }

    /* The 24 icons, six to a row, so the icon picker is as wide as .dc-palette. */
    .hp-icon-grid {
        display: grid;
        grid-template-columns: repeat(6, 32px);
        gap: 4px;
    }

    /* SortableList's drag handle. It stays a plain element and never a button,
       so a drag started on it is not swallowed by a click target. */
    .hp-drag {
        display: inline-flex;
        cursor: move;
        color: var(--t3);
        flex: none;
    }
</style>

<h4 style="text-align:center;margin-bottom:10px;">@Field.Title</h4>

<div class="dc-msec" style="margin-bottom:12px;">
    <div class="dc-msec-head">
        <span class="dc-msec-title">@Loc["HPGeneralTitle"]</span>
        @* Temporary hit points and the maximum reduction are effects applied
           during play, so they live in the damage popup, not here. *@
        <div class="dc-field">
            <span class="dc-flabel">@Loc["MaxHPLabel"]</span>
            <div class="dc-step">
                <button type="button" @onclick="@(() => StepMaximumHp(-1))">&minus;</button>
                <input type="number" class="dc-num" min="0" value="@Field.MaximumHP" @onchange="OnMaximumHpInput" />
                <button type="button" @onclick="@(() => StepMaximumHp(1))">+</button>
            </div>
        </div>
        <label class="dc-chk">
            <input type="checkbox" @bind="Field.AllowNegative" />
            @Loc["HPAllowNegative"]
        </label>
    </div>
</div>


<div class="dc-mgrid">
    <div class="dc-msec">
        <div class="dc-msec-head">
            <span class="dc-msec-title">@Loc["HPKindsTitle"]</span>
            <button type="button" class="dc-btn dc-btn-fill" @onclick="@(() => Field.AddDamageKind())">
                <DcIcon Name="add" Size="16" />@Loc["HPAddKind"]
            </button>
        </div>
        <p class="dc-msec-help">@Loc["HPKindsHelp"]</p>

        @* Bounded height for long lists. Dragging uses the handle so the text
           fields stay usable. *@
        <div class="dc-mscroll">
            <SortableList Id="hpKindsSortable" Items="Field.DamageKinds" OnUpdate="@SortKinds" Handle=".hp-drag" Context="kind">
                <SortableItemTemplate>
                    <div>
                        <div class="dc-mrow dc-irow-wrap">
                            <span class="hp-drag" title="@Loc["HPReorderKind"]"><DcIcon Name="drag" Size="18" /></span>
                            <div class="dc-field" style="width:144px;">
                                <span class="dc-flabel">@Loc["HPKind"]</span>
                                <input class="dc-inp" type="text" spellcheck="false" value="@kind.Name"
                                       @oninput="@((ChangeEventArgs e) => RenameKind(kind, e.Value?.ToString() ?? string.Empty))" />
                            </div>
                            <div class="dc-field">
                                <span class="dc-flabel">@Loc["HPKindColor"]</span>
                                <button type="button" class="dc-swbtn" style="@($"background-color:{kind.Color};")"
                                        title="@Loc["HPKindColor"]" aria-label="@Loc["HPKindColor"]" @onclick="@(() => ToggleColorPicker(kind))"></button>
                            </div>
                            <div class="dc-field">
                                <span class="dc-flabel">@Loc["HPKindIcon"]</span>
                                <button type="button" class="dc-ib" title="@Loc["HPKindIcon"]" aria-label="@Loc["HPKindIcon"]" @onclick="@(() => ToggleIconPicker(kind))">
                                    <DcIcon Name="@kind.Icon" Size="18" />
                                </button>
                            </div>
                            <span class="dc-kchip dc-static" style="@($"background-color:{kind.Color};color:{kind.TextColor};")">
                                <DcIcon Name="@kind.Icon" Size="16" />
                                @kind.Name
                            </span>
                            <button type="button" class="dc-ib dc-danger" style="margin-left:auto;"
                                    title="@Loc["HPRemoveKind"]" aria-label="@Loc["HPRemoveKind"]" @onclick="@(() => Field.RemoveDamageKind(kind))">
                                <DcIcon Name="delete" Size="16" />
                            </button>
                        </div>

                        @if (ReferenceEquals(_colorPickerFor, kind))
                        {
                            <div class="dc-pop hp-inline-pop">
                                <h5>@Loc["HPKindColor"]</h5>
                                <div class="dc-palette">
                                    @foreach (string swatch in _palette)
                                    {
                                        var c = swatch;
                                        <button type="button" style="@($"background-color:{c};")" title="@c"
                                                @onclick="@(() => SetKindColor(kind, c))"></button>
                                    }
                                </div>
                                @* Still free-form, as the picker's text box was. *@
                                <input class="dc-inp" type="text" spellcheck="false" style="margin-top:8px;" value="@kind.Color" placeholder="#RRGGBB"
                                       @oninput="@((ChangeEventArgs e) => kind.Color = e.Value?.ToString() ?? string.Empty)" />
                            </div>
                        }

                        @if (ReferenceEquals(_iconPickerFor, kind))
                        {
                            <div class="dc-pop hp-inline-pop">
                                <h5>@Loc["HPKindIcon"]</h5>
                                <div class="hp-icon-grid">
                                    @foreach (string icon in DCHitPointsIcons.Names)
                                    {
                                        var ic = icon;
                                        <button type="button" class="dc-ib" title="@ic" @onclick="@(() => SetKindIcon(kind, ic))">
                                            <DcIcon Name="@ic" Size="18" />
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </SortableItemTemplate>
            </SortableList>
        </div>
    </div>

    <div class="dc-msec">
        <div class="dc-msec-head">
            <span class="dc-msec-title">@Loc["HPTagsTitle"]</span>
            <button type="button" class="dc-btn dc-btn-fill" @onclick="@(() => Field.AddTag())">
                <DcIcon Name="add" Size="16" />@Loc["HPAddTag"]
            </button>
        </div>
        <p class="dc-msec-help">@Loc["HPTagsHelp"]</p>

        @foreach (int i in Enumerable.Range(0, Field.Tags.Count))
        {
            var index = i;
            <div class="dc-mrow dc-irow-wrap">
                <div class="dc-field" style="width:200px;">
                    <span class="dc-flabel">@Loc["HPTag"]</span>
                    <input class="dc-inp" type="text" spellcheck="false" value="@Field.Tags[index]"
                           @oninput="@((ChangeEventArgs e) => RenameTag(index, e.Value?.ToString() ?? string.Empty))" />
                </div>
                <button type="button" class="dc-ib dc-danger" style="margin-left:auto;"
                        title="@Loc["HPRemoveTag"]" aria-label="@Loc["HPRemoveTag"]" @onclick="@(() => Field.RemoveTag(Field.Tags[index]))">
                    <DcIcon Name="delete" Size="16" />
                </button>
            </div>
        }
    </div>

    <div class="dc-msec">
        <div class="dc-msec-head">
            <span class="dc-msec-title">@Loc["HPRulesTitle"]</span>
            <button type="button" class="dc-btn dc-btn-fill" @onclick="@(() => Field.AddMitigationRule())">
                <DcIcon Name="add" Size="16" />@Loc["HPAddRule"]
            </button>
            @if (Field.MitigationRules.Count == 0)
            {
                <button type="button" class="dc-btn dc-btn-out" @onclick="@(() => Field.AddDefaultMitigationRules())">
                    <DcIcon Name="auto-mode" Size="16" />@Loc["HPAddDefaultRules"]
                </button>
            }
        </div>
        <p class="dc-msec-help">@Loc["HPRulesHelp"]</p>

        @foreach (var rule in Field.MitigationRules)
        {
            var r = rule;
            <div class="dc-mrow dc-irow-wrap">
                <div class="dc-field" style="width:124px;">
                    <span class="dc-flabel">@Loc["HPRuleName"]</span>
                    <input class="dc-inp" type="text" spellcheck="false" value="@r.Name"
                           @oninput="@((ChangeEventArgs e) => RenameRule(r, e.Value?.ToString() ?? string.Empty))" />
                </div>
                <div class="dc-field">
                    <span class="dc-flabel">@Loc["HPRuleFactor"]</span>
                    <div class="dc-step">
                        <button type="button" @onclick="@(() => StepFactor(r, -0.1))">&minus;</button>
                        <input type="number" class="dc-num" step="0.1" @bind="r.Factor" />
                        <button type="button" @onclick="@(() => StepFactor(r, 0.1))">+</button>
                    </div>
                </div>
                <div class="dc-field">
                    <span class="dc-flabel">@Loc["HPRuleFlat"]</span>
                    <div class="dc-step">
                        <button type="button" @onclick="@(() => StepFlat(r, -1))">&minus;</button>
                        <input type="number" class="dc-num" @bind="r.FlatReduction" />
                        <button type="button" @onclick="@(() => StepFlat(r, 1))">+</button>
                    </div>
                </div>
                <div class="dc-field" style="width:112px;">
                    <span class="dc-flabel">@Loc["HPRuleRounding"]</span>
                    <select class="dc-inp" @bind="r.Rounding">
                        <option value="Down">@Loc["HPRoundDown"]</option>
                        <option value="Up">@Loc["HPRoundUp"]</option>
                        <option value="Nearest">@Loc["HPRoundNearest"]</option>
                    </select>
                </div>
                <button type="button" class="dc-ib dc-danger" style="margin-left:auto;"
                        title="@Loc["HPRemoveRule"]" aria-label="@Loc["HPRemoveRule"]" @onclick="@(() => Field.RemoveMitigationRule(r))">
                    <DcIcon Name="delete" Size="16" />
                </button>
            </div>
        }
    </div>

    <div class="dc-msec">
        <div class="dc-msec-head">
            <span class="dc-msec-title">@Loc["HPMitigationsTitle"]</span>
            <button type="button" class="dc-btn dc-btn-fill" @onclick="@(() => Field.AddMitigation())"
                    disabled="@(Field.DamageKinds.Count == 0 || Field.MitigationRules.Count == 0)">
                <DcIcon Name="add" Size="16" />@Loc["HPAddMitigation"]
            </button>
        </div>
        <p class="dc-msec-help">@Loc["HPMitigationsHelp"]</p>

        @foreach (var mitigation in Field.Mitigations)
        {
            var m = mitigation;
            <div class="dc-mrow dc-irow-wrap">
                <div class="dc-field" style="width:124px;">
                    <span class="dc-flabel">@Loc["HPKind"]</span>
                    <select class="dc-inp" @bind="m.Kind">
                        @foreach (var kind in Field.DamageKinds)
                        {
                            <option value="@kind.Name">@kind.Name</option>
                        }
                    </select>
                </div>
                <div class="dc-field" style="width:124px;">
                    <span class="dc-flabel">@Loc["HPRuleName"]</span>
                    <select class="dc-inp" @bind="m.RuleName">
                        @foreach (var rule in Field.MitigationRules)
                        {
                            <option value="@rule.Name">@rule.Name</option>
                        }
                    </select>
                </div>

                @if (Field.Tags.Count > 0)
                {
                    <div class="dc-field" style="width:124px;">
                        <span class="dc-flabel">@Loc["HPRequiredTag"]</span>
                        <select class="dc-inp" @bind="m.RequiredTag">
                            <option value="">@Loc["HPAnyAttack"]</option>
                            @foreach (string tag in Field.Tags)
                            {
                                <option value="@tag">@tag</option>
                            }
                        </select>
                    </div>

                    @if (!string.IsNullOrEmpty(m.RequiredTag))
                    {
                        <div class="dc-field" style="width:124px;">
                            <span class="dc-flabel">@Loc["HPTagCondition"]</span>
                            <select class="dc-inp" @bind="m.TagMustBePresent">
                                <option value="true">@Loc["HPTagPresent"]</option>
                                <option value="false">@Loc["HPTagAbsent"]</option>
                            </select>
                        </div>
                    }
                }

                <button type="button" class="dc-ib dc-danger" style="margin-left:auto;"
                        title="@Loc["HPRemoveMitigation"]" aria-label="@Loc["HPRemoveMitigation"]" @onclick="@(() => Field.RemoveMitigation(m))">
                    <DcIcon Name="delete" Size="16" />
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public DCCreatureHitPointsField Field { get; set; } = default!;

    /// Palette spanning the whole colour wheel, greens included.
    private readonly string[] _palette = new string[]
    {
        "#e53935", "#f4511e", "#fb8c00", "#ffb300",
        "#fdd835", "#c0ca33", "#7cb342", "#43a047",
        "#00897b", "#00acc1", "#039be5", "#1e88e5",
        "#3949ab", "#5e35b1", "#8e24aa", "#d81b60",
        "#6d4c41", "#546e7a", "#757575", "#212121",
        "#9ccc65", "#26a69a", "#ef9a9a", "#ffffff"
    };

    // Which row, if any, has its colour or its icon picker open. One of each at
    // most, so the list never grows two panels deep.
    private DCHitPointsDamageKind? _colorPickerFor;
    private DCHitPointsDamageKind? _iconPickerFor;

    private void ToggleColorPicker(DCHitPointsDamageKind kind)
    {
        _iconPickerFor = null;
        _colorPickerFor = ReferenceEquals(_colorPickerFor, kind) ? null : kind;
    }

    private void ToggleIconPicker(DCHitPointsDamageKind kind)
    {
        _colorPickerFor = null;
        _iconPickerFor = ReferenceEquals(_iconPickerFor, kind) ? null : kind;
    }

    private void SetKindColor(DCHitPointsDamageKind kind, string color)
    {
        kind.Color = color;
        _colorPickerFor = null;
    }

    private void SetKindIcon(DCHitPointsDamageKind kind, string icon)
    {
        kind.Icon = icon;
        _iconPickerFor = null;
    }

    private void OnMaximumHpChanged(uint value)
    {
        Field.SetMaximumHP(value);
    }

    private void OnMaximumHpInput(ChangeEventArgs e)
    {
        // An empty box is not a maximum of zero: it is a half-typed number.
        if (uint.TryParse(e.Value?.ToString(), out uint value))
            OnMaximumHpChanged(value);
    }

    private void StepMaximumHp(int delta)
    {
        long next = (long)Field.MaximumHP + delta;
        OnMaximumHpChanged((uint)Math.Max(0, next));
    }

    /// Steps of a tenth, rounded back to two decimals: 0.1 added three times to a
    /// double otherwise shows up as 0.30000000000000004 in the box.
    private static void StepFactor(DCHitPointsMitigationRule rule, double delta)
    {
        rule.Factor = Math.Round(rule.Factor + delta, 2);
    }

    private static void StepFlat(DCHitPointsMitigationRule rule, int delta)
    {
        rule.FlatReduction += delta;
    }

    private void SortKinds((int oldIndex, int newIndex) indices)
    {
        var (oldIndex, newIndex) = indices;
        var kind = Field.DamageKinds[oldIndex];
        Field.DamageKinds.RemoveAt(oldIndex);
        Field.DamageKinds.Insert(newIndex, kind);
        StateHasChanged();
    }

    /// Renaming has to follow through to whatever already points at the old name,
    /// otherwise the mitigations silently stop matching.
    private void RenameKind(DCHitPointsDamageKind kind, string newName)
    {
        string oldName = kind.Name;
        kind.Name = newName;

        foreach (var mitigation in Field.Mitigations.FindAll(x => x.Kind == oldName))
        {
            mitigation.Kind = newName;
        }
    }

    private void RenameTag(int index, string newName)
    {
        string oldName = Field.Tags[index];
        Field.Tags[index] = newName;

        foreach (var mitigation in Field.Mitigations.FindAll(x => x.RequiredTag == oldName))
        {
            mitigation.RequiredTag = newName;
        }
    }

    private void RenameRule(DCHitPointsMitigationRule rule, string newName)
    {
        string oldName = rule.Name;
        rule.Name = newName;

        foreach (var mitigation in Field.Mitigations.FindAll(x => x.RuleName == oldName))
        {
            mitigation.RuleName = newName;
        }
    }
}
