@using DiceCombats
@inject DiceCombatsService CombatService
@inject IStringLocalizer<Resources.Localization.CreatureCustomFieldRenderer> Loc

@* The quick-damage chips keep their own rule: a chip is painted with the kind
   colour the GM chose, and its ink comes from kind.TextColor, which the model
   computes by luminance. White on a pale yellow kind is unreadable. *@
<style>
    /* The menu is a chip strip, not a list: a creature with a dozen kinds has
       to fit next to the card it belongs to, so the width is capped and the
       chips wrap instead of each one claiming a row of its own. */
    .hp-qmenu {
        width: max-content;
        max-width: min(340px, 86vw);
        max-height: min(70vh, 460px);
        overflow-y: auto;
        padding: 8px 10px;
        box-sizing: border-box;
    }

    .hp-qhead {
        margin: 0 0 5px;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: .07em;
        text-transform: uppercase;
        color: var(--t3);
        line-height: 1;
    }

    .hp-qrow + .hp-qhead { margin-top: 9px; }
    .hp-qrow { display: flex; flex-wrap: wrap; gap: 5px; }
    .hp-qrow .dc-kchip { cursor: pointer; }

    /* MudMenuItem keeps the click that closes the menu; what it does not keep
       is its 8px of padding plus 4px of text margin around a 24px chip. */
    .hp-qrow .mud-menu-item,
    .hp-qfoot .mud-menu-item {
        width: auto;
        min-height: 0;
        padding: 0;
        border-radius: var(--r-pill);
    }

    .hp-qrow .mud-menu-item .mud-menu-item-text,
    .hp-qfoot .mud-menu-item .mud-menu-item-text {
        flex: 0 0 auto;
        margin: 0;
        margin-inline-start: 0;
        margin-inline-end: 0;
    }

    .hp-qfoot { display: flex; justify-content: flex-end; margin-top: 8px; }
    .hp-qfoot .mud-menu-item { padding: 3px 8px; border-radius: var(--r-btn); }
    .hp-qcancel { font-size: 12px; font-weight: 600; color: var(--t3); }

    .hp-quick-tag {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        height: 24px;
        padding: 0 9px;
        border-radius: var(--r-pill);
        color: #FFFFFF;
        background-color: #4A5A7A;
        font-size: 11.5px;
        font-weight: 700;
        line-height: 1;
        white-space: nowrap;
        cursor: pointer;
        opacity: .45;
    }

    .hp-quick-tag.dc-on { opacity: 1; }
</style>

@if (EditionMode)
{
    <GenericModal TContent="HitPointsConfigPopup" OnClose="() => {}" @ref="_configModal">
        <HitPointsConfigPopup Field="Field" />
    </GenericModal>

    <div class="dc-fbody">
        <div class="dc-field">
            <span class="dc-flabel">@Loc["MaxHPLabel"]</span>
            <span class="dc-step">
                <button type="button" @onclick="@(() => OnMaximumHpChanged(Field.MaximumHP > 0 ? Field.MaximumHP - 1 : 0))" aria-label="@Loc["MaxHPLabel"]">&minus;</button>
                <input class="dc-num" type="number" min="0" value="@Field.MaximumHP"
                       @onchange="@(e => OnMaximumHpChanged(ParseMax(e.Value)))" aria-label="@Loc["MaxHPLabel"]" />
                <button type="button" @onclick="@(() => OnMaximumHpChanged(Field.MaximumHP + 1))" aria-label="@Loc["MaxHPLabel"]">+</button>
            </span>
        </div>

        <button type="button" class="dc-btn dc-btn-out" @onclick="@(() => _configModal?.ShowAsync() ?? Task.CompletedTask)">
            <DcIcon Name="edit" />
            @Loc["HPConfigureButton"]
        </button>
    </div>

    @* One chip per rule of this creature, so a kind carrying both a general and
       a tag restricted rule shows both. Inside the body, so it keeps the same
       padding as the controls above it. *@
    <div class="dc-fbody" style="padding-top:0;">
        <div class="dc-irow dc-irow-wrap">
        @foreach (var mitigation in ResistedMitigations)
        {
            var m = mitigation;
            var kind = Field.GetKind(m.Kind);
            <span class="dc-kchip dc-static" style="@($"background-color:{kind!.Color};color:{kind.TextColor};")">
                <DcIcon Name="@kind.Icon" Size="16" />
                @kind.Name
                <span style="opacity:0.75;font-weight:normal;">@m.RuleName</span>
                @if (!string.IsNullOrEmpty(m.RequiredTag))
                {
                    <span style="opacity:0.75;font-weight:normal;font-style:italic;">
                        @(m.TagMustBePresent ? Loc["HPTagWhen"] : Loc["HPTagUnless"]) @m.RequiredTag
                    </span>
                }
            </span>
        }
        </div>
    </div>
}
else
{
    <GenericModal TContent="HitPointsApplyPopup" OnClose="OnApplyModalClose" @ref="_applyModal">
        <HitPointsApplyPopup Field="Field" OnApplied="OnApplied" @ref="_applyPopup" />
    </GenericModal>

    <div class="dc-fgrp dc-fgrp-hp">
        <span class="dc-flabel">@Field.Title</span>

        <div class="dc-hpbar">
            <div class="dc-hpfill @FillTone" style="width:@(FillPercentage)%;"></div>
            <div class="dc-hptxt">
                @Field.CurrentHP / @Field.EffectiveMaximumHP @Loc["HP"]
                @if (Field.TemporaryHP > 0)
                {
                    <span class="dc-hptemp">+@Field.TemporaryHP</span>
                }
            </div>
        </div>

        <span class="dc-step">
            <button type="button" @onclick="@(() => _quickAmount = Math.Max(0, _quickAmount - 1))" aria-label="@Loc["HPDamage"]">&minus;</button>
            <input class="dc-num" type="number" min="0" @bind="_quickAmount" @bind:event="oninput" aria-label="@Loc["HPAmount"]" />
            <button type="button" @onclick="@(() => _quickAmount = _quickAmount + 1)" aria-label="@Loc["HPHeal"]">+</button>
        </span>

        @if (Field.Mitigations.Count == 0)
        {
            @* Nothing could change the amount, so do not ask. *@
            <button type="button" class="dc-ib dc-danger" style="color:var(--danger);"
                    title="@Loc["HPDamage"]" aria-label="@Loc["HPDamage"]"
                    @onclick="() => QuickDamage(string.Empty)">
                <DcIcon Name="remove" />
            </button>
        }
        else
        {
            @* MudMenu stays — nothing cheap replaces a popover — but it no longer
               draws its own Material button: the activator is a Verdant icon
               button that calls the menu context itself. *@
            <MudMenu>
                <ActivatorContent>
                    <button type="button" class="dc-ib dc-danger" style="color:var(--danger);"
                            title="@Loc["HPDamage"]" aria-label="@Loc["HPDamage"]"
                            @onclick="@(args => context.ToggleAsync(args))" @onclick:stopPropagation="true">
                        <DcIcon Name="remove" />
                    </button>
                </ActivatorContent>
                <ChildContent>
                    <div class="hp-qmenu">
                        @* Plain spans, not menu items: clicking a menu item closes the
                           menu, and a tag has to stay togglable before picking a kind. *@
                        @if (Field.Tags.Count > 0)
                        {
                            <div class="hp-qhead">@Loc["HPTagsTitle"]</div>
                            <div class="hp-qrow">
                                @foreach (string tag in Field.Tags)
                                {
                                    var t = tag;
                                    <span class="hp-quick-tag @(_quickTags.Contains(t) ? "dc-on" : "")"
                                          @onclick="() => ToggleQuickTag(t)">
                                        @t
                                    </span>
                                }
                            </div>
                        }
                        <div class="hp-qhead">@Loc["HPPickKind"]</div>
                        @* The kinds stay MudMenuItems — that click is what closes the
                           menu — but they are laid out as one wrapping strip, and the
                           item's own padding is stripped locally. *@
                        <div class="hp-qrow">
                            @foreach (var kind in Field.DamageKinds)
                            {
                                var k = kind;
                                <MudMenuItem OnClick="() => QuickDamage(k.Name)">
                                    <span class="dc-kchip dc-static" style="@($"background-color:{k.Color};color:{k.TextColor};")">
                                        <DcIcon Name="@k.Icon" Size="16" />
                                        @k.Name
                                    </span>
                                </MudMenuItem>
                            }
                            <MudMenuItem OnClick="() => QuickDamage(string.Empty)">
                                <span class="dc-kchip dc-static" style="background-color:var(--b2);color:var(--t1);">@Loc["HPNoKind"]</span>
                            </MudMenuItem>
                        </div>
                        <div class="hp-qfoot">
                            <MudMenuItem>
                                <span class="hp-qcancel">@Loc["CancelBtn"]</span>
                            </MudMenuItem>
                        </div>
                    </div>
                </ChildContent>
            </MudMenu>
        }

        <button type="button" class="dc-ib" style="color:var(--a1);"
                title="@Loc["HPHeal"]" aria-label="@Loc["HPHeal"]" @onclick="QuickHeal">
            <DcIcon Name="add" />
        </button>

        <button type="button" class="dc-btn dc-btn-fill" @onclick="OpenApplyModal" title="@Loc["HPApplyButton"]">
            <DcIcon Name="calculate" />
            @Loc["HPApplyShort"]
        </button>

        @if (Field.CanUndo)
        {
            <button type="button" class="dc-ib" style="color:var(--warn);"
                    title="@Loc["HPUndo"]" aria-label="@Loc["HPUndo"]" @onclick="UndoLast">
                <DcIcon Name="restore" />
            </button>
        }
    </div>
}

@code {
    [Parameter] public DCCreatureHitPointsField Field { get; set; } = default!;
    [Parameter] public bool EditionMode { get; set; } = false;
    [Parameter] public EventCallback OnChange { get; set; }
    [Parameter] public EventCallback<CustomFieldChangeInfo> OnFieldChanged { get; set; }
    [CascadingParameter] public DCDamageSourceContext? SourceContext { get; set; }

    private GenericModal<HitPointsConfigPopup>? _configModal;
    private GenericModal<HitPointsApplyPopup>? _applyModal;
    private HitPointsApplyPopup? _applyPopup;

    private int _quickAmount = 0;
    private List<string> _quickTags = new List<string>();

    private void ToggleQuickTag(string tag)
    {
        if (!_quickTags.Remove(tag)) _quickTags.Add(tag);
    }

    /// The rules this creature has, ordered like the system list of kinds.
    private List<DCHitPointsMitigation> ResistedMitigations =>
        Field.Mitigations
            .FindAll(m => Field.GetKind(m.Kind) != null)
            .OrderBy(m => Field.DamageKinds.FindIndex(k => k.Name == m.Kind))
            .ToList();

    private int FillPercentage
    {
        get
        {
            if (Field.EffectiveMaximumHP <= 0) return 0;
            int percentage = Field.CurrentHP * 100 / Field.EffectiveMaximumHP;
            return Math.Clamp(percentage, 0, 100);
        }
    }

    /// Wounded and critical read as colour as well as length, so the state of a
    /// creature is legible at a glance down a column of cards rather than only
    /// by reading the numbers.
    private string FillTone => FillPercentage <= 25 ? "dc-crit"
                             : FillPercentage <= 50 ? "dc-low"
                             : string.Empty;

    /// The maximum is a uint and the box hands back whatever was typed, so a
    /// blank or a negative lands on 0 rather than throwing.
    private static uint ParseMax(object? value)
    {
        return uint.TryParse(value?.ToString(), out uint parsed) ? parsed : 0u;
    }

    /// The quick box covers the common single hit. The kind comes from the small
    /// menu when the creature has rules, and is empty otherwise.
    private async Task QuickDamage(string kind)
    {
        if (_quickAmount <= 0) return;

        int oldValue = Field.CurrentHP;
        Field.SaveUndo();

        int raw = _quickAmount;
        int amount = raw;
        var rule = string.IsNullOrEmpty(kind) ? null : Field.ResolveRule(kind, _quickTags);
        if (rule != null) amount = rule.Apply(amount);

        uint absorbed = Field.ApplyDamage(amount);
        var tags = new List<string>(_quickTags);
        _quickAmount = 0;
        _quickTags.Clear();

        var line = new DCDamageLineInfo
        {
            Kind = kind,
            RuleName = rule?.Name ?? string.Empty,
            RawAmount = raw,
            AppliedAmount = amount,
            Tags = tags
        };

        await NotifyChanged(oldValue, "CurrentChanged", kind, raw, amount, 0, (int)absorbed, line);
    }

    private async Task QuickHeal()
    {
        if (_quickAmount <= 0) return;

        int oldValue = Field.CurrentHP;
        Field.SaveUndo();

        int amount = _quickAmount;
        Field.ApplyHeal(amount);
        _quickAmount = 0;

        await NotifyChanged(oldValue, "CurrentChanged", null, 0, 0, amount, 0);
    }

    private async Task UndoLast()
    {
        int oldValue = Field.CurrentHP;
        Field.Undo();
        await NotifyChanged(oldValue, "Undone", null, 0, 0, 0, 0);
    }

    private async Task OnMaximumHpChanged(uint value)
    {
        var oldValue = Field.MaximumHP;
        Field.SetMaximumHP(value);

        if (OnFieldChanged.HasDelegate)
        {
            await OnFieldChanged.InvokeAsync(new CustomFieldChangeInfo
            {
                Field = Field,
                OldValue = oldValue,
                NewValue = value,
                Action = "MaximumChanged",
                ChangeDirection = value > oldValue ? "Increased" : (value < oldValue ? "Decreased" : "Unchanged")
            });
        }

        if (OnChange.HasDelegate)
            await OnChange.InvokeAsync();
    }

    /// The popup lives with the card rather than being created on each open, so
    /// it is put back to a clean state on the way in.
    private async Task OpenApplyModal()
    {
        _applyPopup?.Reset();

        if (_applyModal != null)
        {
            await _applyModal.ShowAsync();
        }
    }

    /// The modal's OK button is what commits the staged lines.
    private async Task OnApplyModalClose(bool result)
    {
        if (result && _applyPopup != null)
        {
            await _applyPopup.ApplyAsync();
        }
    }

    private async Task OnApplied(CustomFieldChangeInfo info)
    {
        if (OnFieldChanged.HasDelegate)
            await OnFieldChanged.InvokeAsync(info);

        if (OnChange.HasDelegate)
            await OnChange.InvokeAsync();
    }

    private async Task NotifyChanged(int oldValue, string action, string? kind, int rawDamage, int appliedDamage, int appliedHeal, int temporaryAbsorbed, DCDamageLineInfo? line = null)
    {
        var info = new CustomFieldChangeInfo
        {
            Field = Field,
            OldValue = oldValue,
            NewValue = Field.CurrentHP,
            Action = action,
            ChangeDirection = Field.CurrentHP > oldValue ? "Increased" : (Field.CurrentHP < oldValue ? "Decreased" : "Unchanged"),
            // Nobody was asked here, so the source is whoever holds the
            // initiative and the entry is flagged as a guess.
            SourceName = SourceContext?.SuggestedSource ?? string.Empty,
            SourceInferred = true,
            SourceIsPlayer = SourceContext?.IsPlayer(SourceContext.SuggestedSource) ?? false
        };
        if (line != null) info.DamageLines.Add(line);
        info.Data["damageKinds"] = string.IsNullOrEmpty(kind) ? null : kind;
        info.Data["rawDamage"] = rawDamage;
        info.Data["appliedDamage"] = appliedDamage;
        info.Data["appliedHeal"] = appliedHeal;
        info.Data["temporaryAbsorbed"] = temporaryAbsorbed;

        if (OnFieldChanged.HasDelegate)
            await OnFieldChanged.InvokeAsync(info);

        if (OnChange.HasDelegate)
            await OnChange.InvokeAsync();
    }
}
