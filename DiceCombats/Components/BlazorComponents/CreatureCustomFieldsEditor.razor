@using DiceCombats
@using System.Collections.Generic
@using Microsoft.AspNetCore.Components
@inject DiceCombatsService CombatService
@inject IStringLocalizer<Resources.Localization.CreatureCustomFieldsEditor> Loc

@inject IJSRuntime JS

<style>
    @@keyframes ImageFadeIn {
        from {
            opacity: 0;
            transform: scale(0.95);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .image-reveal {
        max-width: 350px;
        animation: ImageFadeIn 1s ease-out;
        position: relative;
        padding-bottom: 10px;
    }
</style>

<div>
    @if (EditionMode)
    {
        <h3>@Loc["AddAdditionalFieldsTitle"]</h3>

        @* dc-assist keeps the panel off the field wall below it: without it the
           two touch and read as one broken block. *@
        <div class="dc-assist">
            <MudExpansionPanel Expanded="false">
                <TitleContent>
                    <div class="dc-irow" style="gap:10px;">
                        <span style="display:inline-flex;color:var(--a1);"><DcIcon Name="help" Size="18" /></span>
                        <span>Assistance</span>
                    </div>
                </TitleContent>
                <ChildContent>
                    <div class="dc-note">
                        @Loc["AssitanceGeneral1"]
                    </div>
                    <h4>@Loc["AssistanceGeneralSharedFieldsTitle"]</h4>
                    <label class="dc-chk">
                        <input type="checkbox" />
                        @Loc["SharedField"]
                    </label>
                    <div class="dc-note">
                        @((MarkupString)Loc["AssistanceGeneralSharedFieldsDesc"].Value)
                    </div>
                    <h4>@Loc["AssistanceUserCustomFieldTitle"]</h4>
                    <button type="button" class="dc-btn dc-btn-fill">
                        <DcIcon Name="person-add" />
                        @Loc["CustomFieldBtn"]
                    </button>
                    <div class="dc-note">
                        @((MarkupString)Loc["AssistanceUserCustomFieldDesc"].Value)
                    </div>
                    <h4>@Loc["AssistanceGeneralExamplesTitle"]</h4>
                    <div class="dc-note">
                        @((MarkupString)Loc["AssistanceGeneralExamplesDesc"].Value)
                    </div>
                    <div style="display:flex;flex-wrap:wrap;">
                        <img class="image-reveal" style="width:300px;padding:5px;" src="img/creatures_examples/aidedd_example_1.png" />
                        <img class="image-reveal" style="width:300px;padding:5px;" src="img/creatures_examples/manual_creature_example_2.png" />
                    </div>
                </ChildContent>
            </MudExpansionPanel>
        </div>
    }

    @*
      The field wall. In edition mode a card is reordered by dragging the handle
      in its header. SortableList's JS filter leaves inputs, buttons and selects
      usable inside a card, so the handle has to stay a non-button element (the
      DcIcon <svg>).
      Play mode keeps the plain flowing wall: there is no handle to grab there.
    *@
    <div class="dc-fgrid">
        @if (EditionMode)
        {
            <SortableList T="DCCreatureCustomField"
                          Id="creatureFieldsSortable"
                          Class="dc-fgrid"
                          Handle=".dc-field-drag"
                          Items="Fields"
                          OnUpdate="OnFieldsReordered"
                          Context="field">
                <SortableItemTemplate>
                    <div @key="field" class="dc-fcard" style="@FieldCardStyle(field)">
                        @* Reordering is the drag handle's job and deleting is the
                           head's, so the card has no tray under it any more. *@
                        <CreatureCustomFieldRenderer Field="field" EditionMode="true"
                                                     OnRemove="() => RemoveField(field)" />
                    </div>
                </SortableItemTemplate>
            </SortableList>
        }
        else
        {
            @foreach (var field in Fields)
            {
                <div @key="field">
                    <CreatureCustomFieldRenderer Field="field" EditionMode="false" />
                </div>
            }
        }

        @if (EditionMode)
        {
            <div style="display:flex; flex-wrap:wrap; max-width:900px;">
                <div style="padding:10px;">
                    <div class="dc-irow dc-irow-wrap" style="align-items:flex-end;">
                        @* A native select on the Verdant input well. The saved user
                           fields keep their own group instead of a per-item icon. *@
                        <div class="dc-field" style="min-width:220px;">
                            <span class="dc-flabel">@Loc["FieldType"]</span>
                            <select class="dc-inp" aria-label="@Loc["FieldType"]" @bind="newFieldType">
                                <option value="Hit Points">Hit Points</option>
                                <option value="Numeric">Numeric</option>
                                <option value="Checkbox">Checkbox</option>
                                <option value="Checkbox Grid">Checkbox Grid</option>
                                <option value="Text Grid">Text Grid</option>
                                <option value="Text">Text</option>
                                <option value="Color">Color</option>
                                <option value="Conditions">Conditions</option>
                                <option value="Stats">Stats</option>
                                <option value="DetailedPopup">DetailedPopup</option>
                                @{
                                    var userFields = CombatService.GetUserCreatureCustomFields();
                                }
                                @if (userFields.Count > 0)
                                {
                                    <optgroup label="@Loc["AssistanceUserCustomFieldTitle"]">
                                        @foreach (DCCreatureCustomField customField in userFields)
                                        {
                                            <option value="@customField.Title">@customField.Title</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>
                        <button type="button" class="dc-btn dc-btn-fill" @onclick="AddField">
                            <DcIcon Name="add" />
                            @Loc["AddField"]
                        </button>
                    </div>
                </div>

                @* The per-kind help panel gets the same breathing room as the
                   assistance panel above the wall. *@
                <div class="dc-assist" style="flex:1 1 500px;">
                    <MudExpansionPanel Expanded="@_fieldHelpExpanded" ExpandedChanged="() => _fieldHelpExpanded = !_fieldHelpExpanded">
                        <TitleContent>
                            <div class="dc-irow" style="gap:10px;">
                                <span style="display:inline-flex;color:var(--a1);"><DcIcon Name="help" Size="18" /></span>
                                <span>@newFieldType @Loc["AssistanceFieldTitle"]</span>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            @switch (newFieldType)
                            {
                                case "Hit Points":
                                    <div class="dc-note">@Loc["AssistanceHitPointsField"]</div>
                                    <img class="image-reveal" style="width:150px;" src="img/fields_examples/hitpointsfield_example_1.png" />
                                    break;

                                case "Numeric":
                                    <div class="dc-note">@Loc["AssistanceNumericField"]</div>
                                    <img class="image-reveal" style="width:200px;" src="img/fields_examples/numericfield_example_1.png" />
                                    break;

                                case "Checkbox":
                                    <div class="dc-note">@Loc["AssistanceCheckboxField"]</div>
                                    <div class="dc-note">@Loc["AssistanceCheckboxField2"]</div>
                                    <img class="image-reveal" style="width:200px;" src="img/fields_examples/checkboxfield_example_2.png" />
                                    <div class="dc-note">@Loc["AssistanceCheckboxField3"]</div>
                                    <img class="image-reveal" style="width:350px;" src="img/fields_examples/checkboxfield_example_1.png" />
                                    break;

                                case "Checkbox Grid":
                                    <div class="dc-note">@Loc["AssistanceCheckboxGridField"]</div>
                                    <img class="image-reveal" style="width:250px;" src="img/fields_examples/checkboxgridfield_example_1.png" />
                                    <div class="dc-note">@Loc["AssistanceCheckboxGridField2"]</div>
                                    <img class="image-reveal" style="width:250px;" src="img/fields_examples/checkboxgridfield_example_2.png" />
                                    break;

                                case "Text Grid":
                                    <div class="dc-note">@Loc["AssistanceTextGridField"]</div>
                                    <img class="image-reveal" style="width:300px;" src="img/fields_examples/textgridfield_example_1.png" />
                                    break;

                                case "Text":
                                    <div class="dc-note">@Loc["AssistanceTextField"]</div>
                                    <img class="image-reveal" style="width:300px;" src="img/fields_examples/textfield_example_1.png" />
                                    break;

                                case "Color":
                                    <div class="dc-note">@Loc["AssistanceColorField"]</div>
                                    <img class="image-reveal" style="width:350px;" src="img/fields_examples/colorfield_example_1.png" />
                                    break;

                                case "Conditions":
                                    <div class="dc-note">@Loc["AssistanceConditionsField"]</div>
                                    <img class="image-reveal" style="width:350px;" src="img/fields_examples/conditions_example_2.png" />
                                    <div class="dc-note">@Loc["AssistanceConditionsField2"]</div>
                                    <img class="image-reveal" style="width:200px;" src="img/fields_examples/conditions_example_1.png" />
                                    break;

                                case "Stats":
                                    <div class="dc-note">@Loc["AssistanceStatsField"]</div>
                                    <img class="image-reveal" style="width:200px;" src="img/fields_examples/statsfield_example_1.png" />
                                    <div class="dc-note">@Loc["AssistanceStatsField2"]</div>
                                    <img class="image-reveal" style="width:150px;" src="img/fields_examples/statsfield_example_2.png" />
                                    break;

                                case "DetailedPopup":
                                    <div class="dc-note">
                                        @((MarkupString)Loc["AssistanceDetailedPopupField"].Value)
                                    </div>
                                    break;

                                default:
                                    break;
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public List<DCCreatureCustomField> Fields { get; set; } = new List<DCCreatureCustomField>();
    [Parameter]
    public bool EditionMode { get; set; } = true;

    private string newFieldType = "Hit Points";

    private bool _fieldHelpExpanded
    {
        get => Preferences.Get("AssistanceField", true);
        set => Preferences.Set("AssistanceField", value);
    }

    // Each kind asks for the width it actually needs, so a Colour field never
    // takes a full row to say one thing.
    private static string FieldCardStyle(DCCreatureCustomField field) => field.FieldType switch
    {
        "HitPoints" => "--dc-fb:560px;--dc-fm:720px",
        "Color" => "--dc-fb:320px;--dc-fm:380px",
        "Checkbox" => "--dc-fb:400px;--dc-fm:500px",
        "Text" => "--dc-fb:290px;--dc-fm:360px",
        "Numeric" => "--dc-fb:420px;--dc-fm:520px",
        "Stats" => "--dc-fb:560px;--dc-fm:700px",
        "DnDConditions" => "--dc-fb:700px;--dc-fm:100%",
        "CheckboxGrid" => "--dc-fb:640px;--dc-fm:100%",
        "TextGrid" => "--dc-fb:700px;--dc-fm:100%",
        "DetailedPopup" => "--dc-fb:400px;--dc-fm:520px",
        _ => "--dc-fb:420px;--dc-fm:520px",
    };

    private void AddField()
    {
        DCCreatureCustomField? newField = null;
        switch (newFieldType)
        {
            case "Hit Points": newField = new DCCreatureHitPointsField { Title = "Hit points" }; break;
            case "Numeric": newField = new DCCreatureNumericField { Title = "Numeric Field" }; break;
            case "Checkbox": newField = new DCCreatureCheckboxField { Title = "Checkbox Field" }; break;
            case "Checkbox Grid": newField = new DCCreatureCheckboxGridField { Title = "Checkbox Grid Field" }; break;
            case "Text": newField = new DCCreatureTextField { Title = "Text Field" }; break;
            case "Text Grid": newField = new DCCreatureTextGridField { Title = "Text Grid Field" }; break;
            case "Color": newField = new DCCreatureColorField { Title = "Color Field" }; break;
            case "Conditions": newField = new DCCreatureConditionsField { Title = "Conditions" }; break;
            case "Stats": newField = new DCCreatureStatsField { Title = "Stats" }; break;
            case "DetailedPopup": newField = new DCCreatureDetailedPopupField { Title = "DetailedPopup" }; break;
            default: newField = CombatService.GetUserCreatureCustomFieldByName(newFieldType)?.Clone(); break;
        }
        if (newField != null) Fields.Add(newField);
    }

    private void RemoveField(DCCreatureCustomField field) => Fields.Remove(field);

    // Dragging a card's handle lands here. It is the only way to reorder now.
    private void OnFieldsReordered((int oldIndex, int newIndex) indices)
    {
        if (indices.oldIndex < 0 || indices.oldIndex >= Fields.Count) return;
        if (indices.newIndex < 0 || indices.newIndex >= Fields.Count) return;

        var field = Fields[indices.oldIndex];
        Fields.RemoveAt(indices.oldIndex);
        Fields.Insert(indices.newIndex, field);
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) JS.InvokeVoidAsync("scrollToBottom");
        return base.OnAfterRenderAsync(firstRender);
    }
}
