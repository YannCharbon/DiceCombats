@using DiceCombats
@inject DiceCombatsService CombatService
@inject IStringLocalizer<Resources.Localization.CreatureCustomFieldRenderer> Loc

@if (EditionMode)
{
    <div class="dc-fbody">
        <div class="dc-field">
            <span class="dc-flabel">@Field.Title</span>
            <div class="dc-step">
                <button type="button" @onclick="@(() => OnValueChanged(Field.Value - 1))">&minus;</button>
                <input class="dc-num" type="number" value="@Field.Value"
                       @onchange="@(e => OnValueChanged(ParseInt(e.Value, Field.Value)))" />
                <button type="button" @onclick="@(() => OnValueChanged(Field.Value + 1))">+</button>
            </div>
        </div>

        <label class="dc-chk">
            <input type="checkbox" @bind="Field.ShowMaxValue" />
            Show max value
        </label>

        @if (Field.ShowMaxValue == true)
        {
            <div class="dc-field">
                <span class="dc-flabel">Max value</span>
                <div class="dc-step">
                    <button type="button" @onclick="@(() => Field.MaxValue--)">&minus;</button>
                    <input class="dc-num" type="number" @bind="Field.MaxValue" />
                    <button type="button" @onclick="@(() => Field.MaxValue++)">+</button>
                </div>
            </div>
        }

        <label class="dc-chk">
            <input type="checkbox" @bind="Field.ShowUnit" />
            Show unit
        </label>

        @if (Field.ShowUnit == true)
        {
            <div class="dc-field">
                <span class="dc-flabel">Unit</span>
                <input class="dc-inp" type="text" spellcheck="false" style="width:110px;" @bind="Field.Unit" />
            </div>
        }
    </div>
}
else
{
    <div class="dc-fgrp">
        <span class="dc-flabel">@Field.Title</span>
        <div class="dc-step">
            <button type="button" @onclick="@(() => OnValueChanged(Field.Value - 1))">&minus;</button>
            <input class="dc-num" type="number" value="@Field.Value"
                   @onchange="@(e => OnValueChanged(ParseInt(e.Value, Field.Value)))" />
            <button type="button" @onclick="@(() => OnValueChanged(Field.Value + 1))">+</button>
        </div>
        @if (Field.ShowMaxValue)
        {
            @* Same text the end adornment carried: " / max" plus the unit when asked. *@
            <span class="dc-flabel dc-num">@(" / " + Field.MaxValue.ToString() + (Field.ShowUnit == true ? (" " + Field.Unit) : ""))</span>
        }
    </div>
}

@code {
    [Parameter] public DCCreatureNumericField Field { get; set; } = default!;
    [Parameter] public bool EditionMode { get; set; } = false;
    [Parameter] public EventCallback OnChange { get; set; }
    [Parameter] public EventCallback<CustomFieldChangeInfo> OnFieldChanged { get; set; }

    private static int ParseInt(object? raw, int fallback)
        => int.TryParse(raw?.ToString(), out var parsed) ? parsed : fallback;

    private async Task OnValueChanged(int value)
    {
        var oldValue = Field.Value;
        Field.Value = value;
        await RaiseChanged(oldValue, value);
    }

    private async Task RaiseChanged(int oldValue, int newValue)
    {
        if (OnFieldChanged.HasDelegate)
        {
            await OnFieldChanged.InvokeAsync(new CustomFieldChangeInfo
            {
                Field = Field,
                OldValue = oldValue,
                NewValue = newValue,
                Action = "Changed",
                ChangeDirection = GetChangeDirection(oldValue, newValue),
                Data = new Dictionary<string, object?>
                {
                    ["showMaxValue"] = Field.ShowMaxValue,
                    ["maximumValue"] = Field.ShowMaxValue ? Field.MaxValue : null,
                    ["showUnit"] = Field.ShowUnit,
                    ["unit"] = Field.ShowUnit ? Field.Unit : null
                }
            });
        }

        if (OnChange.HasDelegate)
            await OnChange.InvokeAsync();
    }

    private static string GetChangeDirection(int oldValue, int newValue)
    {
        if (newValue > oldValue) return "Increased";
        if (newValue < oldValue) return "Decreased";
        return "Unchanged";
    }
}
