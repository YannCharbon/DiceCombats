@inject DiceCombatsService CombatService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject PopupNotificationService PopupNotificationService
@inject IStringLocalizer<Resources.Localization.CreatureSelector> Loc

<style>
    .CombatEditorCreatureBox {
        background-color: var(--s3);
        box-shadow: 0 2px 10px rgba(255, 255, 255, 0.1);
        border: 1px solid var(--b1);
        border-radius: 10px;
        /* Column flex so the creature list below the search/quick-add controls
           takes exactly the leftover height instead of a hardcoded one, which
           overflowed the box as soon as a control was added above it. */
        display: flex;
        flex-direction: column;
        vertical-align: top;
        white-space: normal;
        padding: 10px;
        margin: 10px;
        /* No width:100% - the box is a grid item and already stretches to its
           track. Asking for the FULL track and then adding a margin put it
           10px past the track on each side, so the dialog carried a horizontal
           scrollbar at every window size. width:auto stretches to the track
           minus the margins, which is what the margins were for. */
        height: 500px;
        min-width: 350px;
        box-sizing: border-box;
    }

    .CombatEditorCreatureList {
        flex: 1 1 auto;
        min-height: 0; /* required for the child to scroll instead of growing */
        overflow-y: auto;
        overflow-x: hidden;
    }

    /* Phones: the two panels stack, so cap them against the viewport instead of
       a fixed 500px, and drop the min width that overflows a narrow screen. */
    @@media screen and (max-width: 768px) {
        .CombatEditorCreatureBox {
            height: 60vh;
            height: 60dvh;
            min-width: 0;
            margin: 5px;
        }
    }
</style>

@* align-items:center: without it the row stretches the buttons to the height of
   the tallest field, which made them look bulky next to the campaign picker. *@
<div class="dc-irow dc-irow-wrap" style="padding-bottom:20px;align-items:flex-end;">
    <div class="dc-field" style="min-width:200px;">
        <label class="dc-flabel" for="combat-name">@Loc["CombatNameLabel"]</label>
        <input class="dc-inp" id="combat-name" type="text" spellcheck="false" @bind="Combat.Name" />
    </div>

    @* Free text with suggestions: picking an existing campaign or typing a brand
       new one both just set the combat's Campaign, and clearing it takes the
       combat back out. A datalist gives the suggestions without MudAutocomplete. *@
    <div class="dc-field" style="min-width:220px;position:relative;">
        <label class="dc-flabel" for="combat-campaign">@Loc["Campaign"]</label>
        <input class="dc-inp" id="combat-campaign" type="text" list="dc-campaigns" spellcheck="false"
               placeholder="@Loc["CampaignHelper"]" value="@Combat.Campaign"
               @onchange="@(e => SetCampaign(e.Value?.ToString() ?? string.Empty))" />
        <datalist id="dc-campaigns">
            @foreach (var c in CombatService.GetCampaigns())
            {
                <option value="@c"></option>
            }
        </datalist>
    </div>

    <button type="button" class="dc-btn dc-btn-out" @onclick="SyncCreatures" title="@Loc["UpdateCreaturesBtnTitle"]">
        <DcIcon Name="sync" /> @Loc["UpdateCreatureBtn"]
    </button>
    <button type="button" class="dc-btn dc-btn-danger" @onclick="DeleteCombat">
        <DcIcon Name="delete" /> @Loc["DeleteCombatBtn"]
    </button>
</div>

<div class="dc-selgrid">
    <div class="CombatEditorCreatureBox">
        <h2 class="dc-h2">@Loc["Title"]</h2>

        <div class="dc-field" style="padding-bottom:10px;">
            <label class="dc-flabel" for="creature-search">@Loc["SearchCreature"]</label>
            <span style="position:relative;display:block;">
                <input class="dc-inp" id="creature-search" type="text" spellcheck="false"
                       style="padding-right:32px;"
                       @oninput="@(e => UpdateCreatureSearchList(e.Value?.ToString() ?? string.Empty))" />
                <span style="position:absolute;right:9px;top:50%;transform:translateY(-50%);color:var(--t3);pointer-events:none;">
                    <DcIcon Name="search" />
                </span>
            </span>
        </div>

        @* Quick add: drop a whole party in at once instead of ticking players one by one.
           Up to three parties read as chips, which is one click each. Past that the
           chips would wrap into several rows and eat the creature list below them, so
           they collapse into a picker whose height never changes however many groups
           exist — and a native select brings its own scrolling and typeahead. *@
        @{
            var playerGroups = CombatService.GetPlayerGroups();
        }
        @if (playerGroups.Count > 0)
        {
            <div class="dc-irow dc-irow-wrap" style="padding-bottom:10px;">
                <span class="dc-flabel"><DcIcon Name="group-add" /> @Loc["QuickAddGroupBtn"]</span>
                @if (playerGroups.Count <= 3)
                {
                    @foreach (DCPlayerGroup group in playerGroups)
                    {
                        var g = group;
                        var members = CombatService.GetPlayerGroupMembers(g);
                        <button type="button" class="dc-tog" @onclick="() => AddPlayerGroup(g)">
                            @(string.IsNullOrWhiteSpace(g.Name) ? Loc["UnnamedPlayerGroup"] : g.Name) (@members.Count)
                        </button>
                    }
                }
                else
                {
                    <select class="dc-inp" style="width:auto;flex:1 1 150px;min-width:0;max-width:240px;"
                            aria-label="@Loc["QuickAddGroupBtn"]" @bind="_quickGroupId">
                        <option value="">&#8212;</option>
                        @foreach (DCPlayerGroup group in playerGroups)
                        {
                            var g = group;
                            var members = CombatService.GetPlayerGroupMembers(g);
                            <option value="@g.Id">@(string.IsNullOrWhiteSpace(g.Name) ? Loc["UnnamedPlayerGroup"] : g.Name) (@members.Count)</option>
                        }
                    </select>
                    <button type="button" class="dc-btn dc-btn-fill" style="min-height:32px;padding:0 12px;"
                            disabled="@(_quickGroupId.Length == 0)" @onclick="AddSelectedPlayerGroup">
                        <DcIcon Name="add" /> @Loc["Add"]
                    </button>
                }
            </div>
        }

        <div class="CombatEditorCreatureList">
            @foreach (DCCreature creature in creatureSearchList.OrderBy(x => x.IsPlayer ? 0 : 1).ThenBy(x => x.Name))
            {
                var c = creature;
                var inCombat = Combat.FindEntryFor(c, CombatService.GetCreatureList()) != null;
                <div class="dc-selrow">
                    <span class="dc-selname">
                        @if (c.IsPlayer)
                        {
                            <span title="@Loc["Player"]" style="color:var(--a2);display:inline-flex;"><DcIcon Name="person" /></span>
                        }
                        @c.Name
                    </span>

                    @if (!inCombat)
                    {
                        <button type="button" class="dc-btn dc-btn-fill" @onclick="() => AddCreature(c)">
                            <DcIcon Name="add" /> @Loc["Add"]
                        </button>
                    }
                    else
                    {
                        <span class="dc-tag" style="color:var(--a1);border-color:var(--a1);">
                            <DcIcon Name="check-circle" /> @Loc["Added"]
                        </span>
                        <button type="button" class="dc-btn dc-btn-danger" @onclick="() => RemoveCreature(c)">
                            <DcIcon Name="remove" /> @Loc["Remove"]
                        </button>
                    }
                </div>
            }
        </div>
    </div>

    <div class="CombatEditorCreatureBox" style="overflow-y:auto; overflow-x:hidden;">
        @* The whole row is the drag handle here, so the arrows stay: they are the
           click and keyboard path to the same reorder. *@
        <SortableList Id="creaturesSortable" Items="Combat.CreaturesList" OnUpdate="@SortCreaturesList" Context="creature">
            <SortableItemTemplate>
                <div class="dc-selorder">
                    <span class="dc-irow" style="gap:2px;">
                        <button type="button" class="dc-ib" title="@Loc["MoveUp"]" aria-label="@Loc["MoveUp"]"
                                @onclick="() => Combat.MoveCreature(creature, true)"><DcIcon Name="circle-up" /></button>
                        <button type="button" class="dc-ib" title="@Loc["MoveDown"]" aria-label="@Loc["MoveDown"]"
                                @onclick="() => Combat.MoveCreature(creature, false)"><DcIcon Name="circle-down" /></button>
                    </span>

                    <span class="dc-selname">@creature.Name</span>

                    <span class="dc-step" title="@Loc["Instances"]">
                        <button type="button" aria-label="@Loc["Instances"]"
                                @onclick="() => Combat.UpdateInstanceCount(creature.InCombatInstanceCount > 1 ? creature.InCombatInstanceCount - 1 : 1, creature)">&minus;</button>
                        <input class="dc-num" type="number" min="1" value="@creature.InCombatInstanceCount"
                               aria-label="@Loc["Instances"]"
                               @onchange="@(e => Combat.UpdateInstanceCount(ParseCount(e.Value), creature))" />
                        <button type="button" aria-label="@Loc["Instances"]"
                                @onclick="() => Combat.UpdateInstanceCount(creature.InCombatInstanceCount + 1, creature)">+</button>
                    </span>
                </div>
            </SortableItemTemplate>
        </SortableList>
    </div>
</div>

@code {
    [Parameter] public DCCombat Combat { get; set; } = default!;

    /// Told, after an update from the library, which entries took a new GUID
    /// (old GUID to new GUID), so that the page can follow the acting creature.
    [Parameter] public Action<IReadOnlyDictionary<Guid, Guid>>? OnEntriesReplaced { get; set; }

    private List<DCCreature> creatureSearchList = new List<DCCreature>();

    /// The group picked in the collapsed quick-add row, held as the raw option
    /// value so the empty placeholder is representable.
    private string _quickGroupId = string.Empty;

    protected override void OnInitialized()
    {
        creatureSearchList = CombatService.GetCreatureList();

        base.OnInitialized();
    }

    private void SaveCombat()
    {
        var combats = CombatService.GetCombatList();
        var combat = combats.Find(x => x.Id == Combat.Id);
        if (combat != null)
        {
            CombatService.DeleteCombat(combat);
        }

        CombatService.AddCombat(Combat);

        CombatService.SaveCombats();
    }

    private void DeleteCombat()
    {
        var combats = CombatService.GetCombatList();
        var combat = combats.Find(x => x.Id == Combat.Id);
        if (combat != null)
        {
            CombatService.DeleteCombat(combat);
        }

        CombatService.SaveCombats();

        Navigation.NavigateTo("/combatsexplorer");
    }

    private void SetCampaign(string campaign)
    {
        // Saved with the rest of the combat when the selector modal closes.
        Combat.Campaign = (campaign ?? string.Empty).Trim();
    }

    /// The instance box hands back raw text; a blank or a zero lands on 1,
    /// which is what MudNumericField Min="1" used to enforce.
    private static uint ParseCount(object? value)
    {
        return uint.TryParse(value?.ToString(), out uint parsed) && parsed >= 1 ? parsed : 1u;
    }
    /// Resolves the picked option back to its group, then clears the box: the
    /// party is in the list below now, so a selection left standing would read
    /// like something is still pending.
    private void AddSelectedPlayerGroup()
    {
        if (!Guid.TryParse(_quickGroupId, out Guid id)) return;

        DCPlayerGroup? group = CombatService.GetPlayerGroups().Find(x => x.Id == id);
        if (group != null)
        {
            AddPlayerGroup(group);
        }

        _quickGroupId = string.Empty;
    }

    private void AddPlayerGroup(DCPlayerGroup group)
    {
        foreach (DCCreature player in CombatService.GetPlayerGroupMembers(group))
        {
            AddCreature(player);
        }
    }

    private void AddCreature(DCCreature creature)
    {
        // The combat holds copies, which keep the GUID of their library
        // creature: two creatures with the same name are still two creatures.
        if (Combat.FindEntryFor(creature, CombatService.GetCreatureList()) == null)
        {
            Combat.AddCreature((DCCreature)creature.Clone());
        }
    }

    private void RemoveCreature(DCCreature creature)
    {
        DCCreature? entry = Combat.FindEntryFor(creature, CombatService.GetCreatureList());
        if (entry != null)
        {
            Combat.RemoveCreature(entry);
        }
    }

    private void SortCreaturesList((int oldIndex, int newIndex) indices)
    {
        var (oldIndex, newIndex) = indices;

        var creatures = Combat.CreaturesList;
        var creatureToMove = creatures[oldIndex];

        Combat.MoveCreature(creatureToMove, newIndex);

        StateHasChanged();
    }

    private void SyncCreatures()
    {
        // In place, by GUID: the order of the fight is kept, the library is not
        // touched, and a creature that is no longer in the library stays as it is.
        var replacedIds = new Dictionary<Guid, Guid>();
        var notFound = Combat.SyncWithLibrary(CombatService.GetCreatureList(), replacedIds);
        if (replacedIds.Count > 0)
        {
            OnEntriesReplaced?.Invoke(replacedIds);
        }

        string message = notFound.Count == 0
            ? Loc["SyncDoneText"]
            : string.Format(Loc["SyncDoneNotFoundText"], string.Join(", ", notFound.Select(x => x.Name)));
        PopupNotificationService.Show(Loc["SyncDoneTitle"], message, PopupNotificationService.Type.SUCCESS, notFound.Count == 0 ? 4000 : 8000);
    }

    private void UpdateCreatureSearchList(string arg)
    {
        var tmp = CombatService.GetCreatureList().FindAll(x => x.Name.ToLower().Contains(arg.ToLower()));
        creatureSearchList = tmp;
    }
}