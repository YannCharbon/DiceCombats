@*
    The import of a DiceCombats file (spec §3.2, §7.1), whichever button
    started it. A file with nothing in conflict gets a summary and a single
    confirmation; otherwise every part of the file is listed with what will
    happen to it, the suggested choice already selected. Lives in MainLayout
    and follows DCImportFlow.
*@

@using DiceCombats.Portability
@implements IDisposable
@inject DCImportFlow Flow
@inject IStringLocalizer<DiceCombats.Resources.Localization.Portability> Loc

@if (Flow.Stage != DCImportStage.Idle)
{
    <div class="dc-confirm-scrim">
        <div class="dc-confirm @(Flow.Stage == DCImportStage.Wizard ? "dc-import" : "")" role="dialog" aria-modal="true">
            @switch (Flow.Stage)
            {
                case DCImportStage.Refused:
                    <h3 class="dc-confirm-title">@Loc["WizardTitle"]</h3>
                    <p class="dc-confirm-msg">@DCBundleMessages.ReadError(Loc, (DCBundleReadException)Flow.Error!, Flow.FileSizeBytes)</p>
                    <div class="dc-confirm-foot">
                        <button type="button" class="dc-btn dc-btn-fill" @onclick="Flow.Close"><DcIcon Name="check" /> @Loc["AlertCloseBtn"]</button>
                    </div>
                    break;

                case DCImportStage.Summary:
                    @if (!Plan.AllItems.Any(i => i.Inserts))
                    {
                        @* Nothing is imported, so the export's warnings do not matter. *@
                        <h3 class="dc-confirm-title">@Loc["ImportNothingTitle"]</h3>
                        <p class="dc-confirm-msg">@Loc["ImportNothingToDo"]</p>
                        <div class="dc-confirm-foot">
                            <button type="button" class="dc-btn dc-btn-fill" @onclick="Flow.Close"><DcIcon Name="check" /> @Loc["AlertCloseBtn"]</button>
                        </div>
                    }
                    else
                    {
                        <h3 class="dc-confirm-title">@Loc["ImportSummaryTitle"]</h3>
                        <p class="dc-confirm-msg">@Loc["ImportSummaryText"]</p>
                        <div class="dc-import-item dc-stack" style="gap:4px;margin-bottom:12px;">
                            @foreach (var group in Plan.Items.Where(i => i.Inserts).GroupBy(i => i.Kind).OrderBy(g => g.Key))
                            {
                                <div class="dc-meta"><b>@KindLabel(group.Key)</b> &middot; @group.Count()</div>
                            }
                        </div>
                        @Warnings()
                        <p class="dc-meta" style="margin:10px 0 14px;">@Loc["ImportBackupNote"]</p>
                        <div class="dc-confirm-foot">
                            <button type="button" class="dc-btn" @onclick="Flow.Close">@Loc["WizardCancelBtn"]</button>
                            <button type="button" class="dc-btn dc-btn-fill" @onclick="Flow.ConfirmAsync"><DcIcon Name="check" /> @Loc["WizardConfirmBtn"]</button>
                        </div>
                    }
                    break;

                case DCImportStage.Wizard:
                    <h3 class="dc-confirm-title">@Loc["WizardTitle"]</h3>
                    <p class="dc-confirm-msg">@Loc["WizardIntro"]</p>
                    @if (Plan.AllItems.Any(i => i.NeedsNewName))
                    {
                        <div class="dc-import-item" style="margin-bottom:10px;">
                            <div class="dc-import-affixes">
                                <span class="dc-import-name" style="flex:0 0 auto;">@Loc["NameAffixLabel"]</span>
                                <input class="dc-inp" value="@Planner.NamePrefix" aria-label="@Loc["NameAffixBefore"]" title="@Loc["NameAffixBefore"]"
                                       @oninput="e => Planner.SetNameAffixes(Plan, e.Value?.ToString(), Planner.NameSuffix)" />
                                <span class="dc-meta">@Loc["NameAffixName"]</span>
                                <input class="dc-inp" value="@Planner.NameSuffix" aria-label="@Loc["NameAffixAfter"]" title="@Loc["NameAffixAfter"]"
                                       @oninput="e => Planner.SetNameAffixes(Plan, Planner.NamePrefix, e.Value?.ToString())" />
                            </div>
                            <div class="dc-meta" style="margin-top:4px;">@Loc["NameAffixHelp"]</div>
                        </div>
                    }
                    <div class="dc-import-body">
                        @Warnings()
                        @foreach (var group in Plan.Items.GroupBy(i => i.Kind).OrderBy(g => g.Key))
                        {
                            <div class="dc-strip-name" style="margin:14px 0 6px;">@KindLabel(group.Key)</div>
                            <div class="dc-stack" style="gap:8px;">
                                @foreach (var item in group.OrderBy(i => StatusOrder(i.Status)))
                                {
                                    @ItemRow(item)
                                }
                            </div>
                        }
                    </div>
                    <p class="dc-meta" style="margin:12px 0 14px;">@Loc["ImportBackupNote"]</p>
                    <div class="dc-confirm-foot">
                        <button type="button" class="dc-btn" @onclick="Flow.Close">@Loc["WizardCancelBtn"]</button>
                        <button type="button" class="dc-btn dc-btn-fill" disabled="@(!AllNamesValid)" @onclick="Flow.ConfirmAsync">
                            <DcIcon Name="check" /> @Loc["WizardConfirmBtn"]
                        </button>
                    </div>
                    break;

                case DCImportStage.Applying:
                    <h3 class="dc-confirm-title">@Loc["WizardTitle"]</h3>
                    <p class="dc-confirm-msg">@Loc["ImportInProgress"]</p>
                    break;

                case DCImportStage.Report:
                    <h3 class="dc-confirm-title">@Loc["ImportReportTitle"]</h3>
                    <div class="dc-import-item dc-stack" style="gap:4px;margin-bottom:12px;">
                        @foreach (var line in ReportLines())
                        {
                            <div class="dc-meta">@line</div>
                        }
                    </div>
                    @Warnings()
                    <div class="dc-confirm-foot" style="margin-top:14px;">
                        <button type="button" class="dc-btn dc-btn-fill" @onclick="Flow.Close"><DcIcon Name="check" /> @Loc["AlertCloseBtn"]</button>
                    </div>
                    break;

                case DCImportStage.Failed:
                    <h3 class="dc-confirm-title">@Loc["WizardTitle"]</h3>
                    <p class="dc-confirm-msg">@FailureText(Flow.Error)</p>
                    <div class="dc-confirm-foot">
                        <button type="button" class="dc-btn dc-btn-fill" @onclick="CloseAfterFailure"><DcIcon Name="check" /> @Loc["AlertCloseBtn"]</button>
                    </div>
                    break;
            }
        </div>
    </div>
}

<style>
    .dc-import { width: min(880px, 100%); max-height: 90vh; display: flex; flex-direction: column; }
    .dc-import-body { overflow-y: auto; min-height: 0; padding-right: 4px; }
    .dc-import-item { background: var(--s4); border: 1px solid var(--b1); border-radius: var(--r-btn); padding: 10px 12px; }
    .dc-import-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .dc-import-name { font-weight: 700; color: var(--t1); flex: 1 1 200px; min-width: 0; overflow-wrap: anywhere; }
    .dc-import-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-top: 8px; }
    .dc-import-row .dc-inp { flex: 1 1 220px; min-width: 0; }
    .dc-import-affixes { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .dc-import-affixes .dc-inp { flex: 0 1 160px; min-width: 80px; }
    .dc-import-bad { color: var(--danger); font-size: 12.5px; margin-top: 4px; }
</style>

@code {
    private ImportPlan<DCAssetKind> Plan => Flow.Session!.Plan;
    private ConflictPlanner Planner => Flow.Session!.Planner;

    protected override void OnInitialized()
    {
        Flow.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Flow.Changed -= OnChanged;
    }

    private RenderFragment ItemRow(ImportItem<DCAssetKind> item) => __builder =>
    {
        var i = item;
        <div class="dc-import-item">
            <div class="dc-import-head">
                <span class="dc-import-name">@i.IncomingName</span>
                <span class="dc-tag">@StatusLabel(i.Status)</span>
            </div>

            @if (i.Status is ImportStatus.Differs or ImportStatus.NameUsed)
            {
                <div class="dc-meta" style="margin-top:4px;">
                    <b>@Loc["WizardInFile"]</b> @i.IncomingName &middot; <b>@Loc["WizardInLibrary"]</b> @ConflictPlanner.NameOf(i.Local)
                </div>
            }

            @if (i.AllowedChoices.Count > 1)
            {
                <div class="dc-import-row">
                    <select class="dc-inp" style="flex:0 1 300px;" value="@i.Choice" @onchange="e => Choose(i, e.Value)">
                        @foreach (var choice in i.AllowedChoices)
                        {
                            <option value="@choice">@ChoiceLabel(choice)</option>
                        }
                    </select>
                    @if (ConflictPlanner.SameKindAndStatus(Plan, i).Count is var same && same > 1)
                    {
                        <button type="button" class="dc-btn dc-btn-out dc-btn-sm" @onclick="() => Planner.ApplyToAllOfKind(Plan, i.Kind, i.Status, i.Choice)">
                            @string.Format(Loc["SameChoiceFor" + i.Kind], same, StatusLabel(i.Status))
                        </button>
                    }
                </div>
                <div class="dc-meta" style="margin-top:4px;">@ChoiceHelp(i.Choice)</div>
            }

            @if (i.NeedsNewName)
            {
                <div class="dc-import-row">
                    <label class="dc-meta">@Loc["WizardNewName"]</label>
                    <input class="dc-inp" value="@i.NewName" @oninput="e => Planner.SetNewName(i, e.Value?.ToString())" />
                </div>
                @if (NameProblem(i) is string problem)
                {
                    <div class="dc-import-bad">@problem</div>
                }
            }

            @if (i.Choice == ImportChoice.Skip && Planner.DependentsOf(Plan, i) is { Count: > 0 } dependents)
            {
                <div class="dc-note" style="margin-top:8px;">
                    <b>@Loc["WizardSkipWarningTitle"]</b><br />
                    @string.Format(Loc["WizardSkipWarning"], i.IncomingName, string.Join(", ", dependents.Select(d => d.IncomingName)))
                </div>
            }
        </div>
    };

    private RenderFragment Warnings() => __builder =>
    {
        var lines = Flow.Session?.Plan.Warnings.Select(WarningText).Where(t => t != null).Distinct().ToList() ?? new List<string?>();
        if (lines.Count > 0)
        {
            <div class="dc-note" style="margin-bottom:8px;">
                @foreach (var line in lines)
                {
                    <div>@line</div>
                }
            </div>
        }
    };

    private void Choose(ImportItem<DCAssetKind> item, object? value)
    {
        if (Enum.TryParse<ImportChoice>(value?.ToString(), out var choice))
        {
            Planner.SetChoice(Plan, item, choice);
        }
    }

    private string? NameProblem(ImportItem<DCAssetKind> item)
    {
        if (string.IsNullOrWhiteSpace(item.NewName)) return Loc["WizardNameEmpty"];
        return Planner.IsNameAvailable(Plan, item, item.NewName) ? null : Loc["WizardNameTaken"].Value;
    }

    private bool AllNamesValid => Planner.InvalidNewNames(Plan).Count == 0;

    private static int StatusOrder(ImportStatus status) => status switch
    {
        ImportStatus.Differs => 0,
        ImportStatus.NameUsed => 1,
        ImportStatus.New => 2,
        _ => 3,
    };

    private string KindLabel(DCAssetKind kind) => Loc["Kind" + kind];
    private string StatusLabel(ImportStatus status) => Loc["Status" + status];
    private string ChoiceLabel(ImportChoice choice) => Loc["Choice" + choice];
    private string ChoiceHelp(ImportChoice choice) => choice == ImportChoice.Nothing ? "" : Loc["Choice" + choice + "Help"];

    private string? WarningText(BundleWarning warning) => warning.Code switch
    {
        DCBundleWarningCodes.LegacyFormat => Flow.FromUnsavedCopy ? Loc["WarningUnsavedCopy"] : Loc["WarningLegacyFormat"],
        DCBundleWarningCodes.CreatureNotInLibrary => string.Format(Loc["WarningCreatureNotInLibrary"], warning.Detail),
        DCBundleWarningCodes.TokenRemoved => string.Format(Loc["WarningTokenRemoved"], warning.Detail),
        DCBundleWarningCodes.BodyKeptAsIs => string.Format(Loc["WarningBodyKeptAsIs"], warning.Detail),
        DCBundleWarningCodes.BrokenReferences => string.Format(Loc["WarningBrokenReferences"], warning.Detail),
        _ => null,
    };

    private IEnumerable<string> ReportLines()
    {
        var report = Flow.Report!;
        if (report.Added > 0) yield return string.Format(Loc["ReportAdded"], report.Added);
        if (report.Replaced > 0) yield return string.Format(Loc["ReportReplaced"], report.Replaced);
        if (report.KeptLocal > 0) yield return string.Format(Loc["ReportKeptLocal"], report.KeptLocal);
        if (report.Skipped > 0) yield return string.Format(Loc["ReportSkipped"], report.Skipped);
        if (report.UpToDate > 0) yield return string.Format(Loc["ReportUpToDate"], report.UpToDate);
    }

    private string FailureText(Exception? error) => error switch
    {
        ImportBlockedException blocked => string.Format(Loc["ErrorLoadFailed"], blocked.FileName),
        ImportNameException => Loc["WizardNameTaken"],
        DiceCombats.Storage.BackupSafetyFailedException backup => string.Format(Loc["BackupFailed"], backup.Message),
        ImportRollbackFailedException rollback => string.Format(Loc["ImportRollbackFailed"], rollback.BackupFileName),
        _ => string.Format(Loc["ImportFailed"], error?.Message),
    };

    // After a failure the data was read again from the backup, so no page may
    // keep an object from before.
    private void CloseAfterFailure()
    {
        bool reload = Flow.Error is ImportFailedException;
        Flow.Close();
        if (reload)
        {
            (Application.Current as App)?.ReloadPages();
        }
    }
}
