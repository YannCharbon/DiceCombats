@using DiceCombats
@using DiceCombats.Automations
@inject DiceCombatsService CombatService
@inject IDiceEventPublisher EventPublisher
@inject IStringLocalizer<Resources.Localization.CreatureCustomFieldRenderer> Loc

@*
 * The five field-renderer classes this file used to declare now live in
 * wwwroot/css/app.css, so every field renderer shares one copy of them.
*@

@if (EditionMode)
{
    <div class="dc-fhead">
        @* The drag handle must stay a non-button element: SortableList's JS
           filter is 'input, button, select, textarea, .no-drag'. An <svg> is fine. *@
        <DcIcon Name="drag" Size="18" Class="dc-grab dc-field-drag" />
        <span class="dc-ftype">@Field.FieldType</span>
        @* The kind pill carries the kind now, so the name box only needs the
           field-name label for assistive technology and on hover. *@
        <input class="dc-inp" type="text" aria-label="@Loc["FieldNameLabel"]" title="@Loc["FieldNameLabel"]"
               @bind="Field.Title" @bind:event="oninput" />
        @* Saving a field to the library and deleting it from this creature are
           the two things you do TO a field rather than inside it, so they sit
           together at the end of its head rather than in a tray underneath.
           A bookmark says "library" far better than the person glyph did. *@
        @if (CombatService.GetUserCreatureCustomFieldByName(Field.Title) == null)
        {
            <button type="button" class="dc-ib dc-fhead-sep" title="@Loc["LibraryAddBtn"]" aria-label="@Loc["LibraryAddBtn"]"
                    @onclick="SaveUserCustomField">
                <DcIcon Name="bookmark" />
            </button>
        }
        else
        {
            <button type="button" class="dc-ib dc-fhead-sep" style="color:var(--a1);" title="@Loc["LibraryRemoveBtn"]" aria-label="@Loc["LibraryRemoveBtn"]"
                    @onclick="RemoveUserCustomField">
                <DcIcon Name="bookmark" Filled="true" />
            </button>
        }

        @if (OnRemove.HasDelegate)
        {
            <button type="button" class="dc-ib dc-danger" title="@Loc["FieldRemoveBtn"]" aria-label="@Loc["FieldRemoveBtn"]"
                    @onclick="OnRemove">
                <DcIcon Name="delete" />
            </button>
        }
    </div>
    <div class="dc-fsub">
        <label class="dc-chk">
            <input type="checkbox" @bind="Field.SharedAcrossCreatureInstances" />
            @Loc["SharedField"]
        </label>
    </div>
}

@if (Field is DCCreatureHitPointsField hitPointsField)
{
    <CCFHitPointsField Field="hitPointsField" EditionMode="EditionMode" OnChange="NotifyParentOnChange" OnFieldChanged="NotifyParentOnFieldChanged" />
}
else if (Field is DCCreatureNumericField numericField)
{
    <CCFNumericField Field="numericField" EditionMode="EditionMode" OnChange="NotifyParentOnChange" OnFieldChanged="NotifyParentOnFieldChanged" />
}
else if (Field is DCCreatureTextField textField)
{
    <CCFTextField Field="textField" EditionMode="EditionMode" OnChange="NotifyParentOnChange" OnFieldChanged="NotifyParentOnFieldChanged" />
}
else if (Field is DCCreatureTextGridField textGridField)
{
    <CCFTextGridField Field="textGridField" EditionMode="EditionMode" OnChange="NotifyParentOnChange" OnFieldChanged="NotifyParentOnFieldChanged" />
}
else if (Field is DCCreatureCheckboxField checkBoxField)
{
    <CCFCheckboxField Field="checkBoxField" EditionMode="EditionMode" OnChange="NotifyParentOnChange" OnFieldChanged="NotifyParentOnFieldChanged" />
}
else if (Field is DCCreatureCheckboxGridField checkboxGridField)
{
    <CCFCheckboxGridField Field="checkboxGridField" EditionMode="EditionMode" OnChange="NotifyParentOnChange" OnFieldChanged="NotifyParentOnFieldChanged" />
}
else if (Field is DCCreatureColorField colorField)
{
    <CCFColorField Field="colorField" EditionMode="EditionMode" OnChange="NotifyParentOnChange" OnFieldChanged="NotifyParentOnFieldChanged" />
}
else if (Field is DCCreatureConditionsField dndConditionsField)
{
    <CCFConditionsField Field="dndConditionsField" EditionMode="EditionMode" OnChange="NotifyParentOnChange" OnFieldChanged="NotifyParentOnFieldChanged" />
}
else if (Field is DCCreatureStatsField statsField)
{
    <CCFStatsField Field="statsField" EditionMode="EditionMode" OnChange="NotifyParentOnChange" OnFieldChanged="NotifyParentOnFieldChanged" />
}
else if (Field is DCCreatureDetailedPopupField detailedPopupField)
{
    <CCFDetailedPopupField Field="detailedPopupField" EditionMode="EditionMode" OnChange="NotifyParentOnChange" OnFieldChanged="NotifyParentOnFieldChanged" />
}

@code {
    [Parameter]
    public DCCreatureCustomField Field { get; set; } = default!;
    [Parameter]
    public bool EditionMode { get; set; } = false;
    [Parameter]
    public EventCallback OnChange { get; set; }
    [Parameter]
    public EventCallback<CustomFieldChangeInfo> OnFieldChanged { get; set; }

    /// Supplied only by the field editor. On a combat card there is nothing to
    /// delete a field from, so the head draws no delete button at all.
    [Parameter]
    public EventCallback OnRemove { get; set; }

    private async Task NotifyParentOnChange()
    {
        if (OnChange.HasDelegate)
        {
            await OnChange.InvokeAsync();
        }
    }

    private async Task NotifyParentOnFieldChanged(CustomFieldChangeInfo info)
    {
        if (OnFieldChanged.HasDelegate)
        {
            await OnFieldChanged.InvokeAsync(info);
        }
    }

    private async Task SaveUserCustomField()
    {
        if (CombatService.AddUserCreatureCustomField(Field.CloneAsTemplate()))
        {
            await EventPublisher.PublishAsync(new DiceEvent
            {
                Type = DiceEventTypes.UserCustomFieldSaved,
                Category = "Custom fields",
                DisplayName = "User custom field saved",
                Data = new()
                {
                    ["fieldTitle"] = Field.Title,
                    ["fieldType"] = Field.FieldType,
                    ["isUserCustomField"] = true
                }
            });
        }
    }

    private async Task RemoveUserCustomField()
    {
        CombatService.RemoveUserCreatureCustomFieldByName(Field.Title);

        await EventPublisher.PublishAsync(new DiceEvent
        {
            Type = DiceEventTypes.UserCustomFieldRemoved,
            Category = "Custom fields",
            DisplayName = "User custom field removed",
            Data = new()
            {
                ["fieldTitle"] = Field.Title,
                ["fieldType"] = Field.FieldType,
                ["isUserCustomField"] = true
            }
        });
    }
}
