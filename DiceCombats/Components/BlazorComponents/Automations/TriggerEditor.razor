@using DiceCombats.Automations
@inject DiceCombatsService CombatService
@inject IStringLocalizer<Resources.Localization.Automations> Loc
@inject IJSRuntime JS

@{
    var triggerEntry = GetTriggerEntry(Trigger);
}

<style>
    /* Surfaces. The trigger block is a .dc-msec, which is --s4, and it sits on
       an automation card that Automations.razor puts on --s3 — so the block
       itself already steps. What did not step is everything inside it: the
       option cells are --s4 too, and MudBlazor paints the variables panel from
       the same --s4 Surface. Each one takes its own step here, and the blocks
       you operate carry a --ctl edge (3.4:1) rather than --b1's 2.6:1. */

    /* The whole block is controls, so its edge is an operable one. */
    .trigger-sec { border-color: var(--ctl); }

    .trigger-variables {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-bottom: 8px;
    }

    /* A chip you click to copy: operable edge, and a step above the --s5 panel
       it is laid out on. */
    .trigger-variable {
        cursor: pointer;
        background: var(--s6);
        border-color: var(--ctl);
        /* A placeholder can be longer than a phone is wide. Breaking it is
           scoped to this chip rather than to .kbd: `anywhere` counts towards
           min-content, so on .kbd it would also re-measure the placeholder
           table's columns on a desktop window. */
        max-width: 100%;
        overflow-wrap: anywhere;
    }

        .trigger-variable:hover {
            border-color: var(--a1);
        }

        .trigger-variable.copied {
            border-color: var(--a1);
            color: var(--a1);
        }

    /* The creature / source filters are multi-selection, so they are a wall of
       tick boxes rather than a listbox: nothing has to be opened to see what is
       selected, and the selection stays readable while the trigger is edited.
       The wall is a well (--s2) a step below the block, which is what makes the
       scroll region and its edge visible; the cells sit on top of it at --s5. */
    .trigger-names {
        max-height: 168px;
        overflow-y: auto;
        padding: 6px;
        background: var(--s2);
        border: 1px solid var(--b1);
        border-radius: var(--r-btn);
    }

    .trigger-names .dc-opt {
        background: var(--s5);
        border-color: var(--ctl);
    }

    /* MudBlazor has one Surface colour, so this panel arrived at --s4 — the
       exact step of the block it is nested in. --s5, and an operable edge
       because the whole point of it is to be opened. */
    .trigger-fields {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
        gap: 12px;
        align-items: end;
    }

    .trigger-fields > .tg-span { grid-column: 1 / -1; }
    .trigger-fields > .tg-inline { align-self: center; min-height: 32px; }

    .trigger-vars.mud-expansion-panels > .mud-expand-panel {
        background-color: var(--s5);
        border: 1px solid var(--ctl);
        border-radius: var(--r-btn);
    }
</style>


<div class="dc-msec trigger-sec" style="margin:10px 0;">
    <div class="dc-msec-head">
        <span class="dc-msec-title">@Loc["When"]</span>
    </div>

    @* The same field wall as an action editor: a comparison or a stat picker
       does not need the full card width to itself. The two name filters do,
       because they are grids of tick boxes. *@
    <div class="trigger-fields">
    <div class="dc-field tg-span">
        <span class="dc-flabel">@Loc["Trigger"]</span>
        <select class="dc-inp" value="@Trigger.Kind"
                @onchange="@(e => SetTriggerKind(e.Value?.ToString() ?? string.Empty))">
            @foreach (var ev in EventTriggerCatalog.Entries)
            {
                <option value="@ev.Kind">@GetTriggerSelectText(ev)</option>
            }
        </select>
    </div>

    @if (triggerEntry.SupportsCreatureFilter)
    {
        <div class="dc-field tg-span">
            <span class="dc-flabel">@Loc["CreaturesEmptyAnyCreature"]</span>
            <div class="dc-opt-grid trigger-names">
                @foreach (var creatureName in GetCreatureNames())
                {
                    var n = creatureName;
                    <label class="dc-opt dc-chk">
                        <input type="checkbox" checked="@Trigger.CreatureNames.Contains(n)"
                               @onchange="@(e => ToggleName(Trigger.CreatureNames, n, e.Value is bool v && v))" />
                        <span>@n</span>
                    </label>
                }
            </div>
        </div>
    }

    @if (triggerEntry.SupportsSourceFilter)
    {
        <div class="dc-field tg-span">
            <span class="dc-flabel">@Loc["SourcesEmptyAnySource"]</span>
            <div class="dc-opt-grid trigger-names">
                @foreach (var creatureName in GetCreatureNames())
                {
                    var n = creatureName;
                    <label class="dc-opt dc-chk">
                        <input type="checkbox" checked="@Trigger.SourceNames.Contains(n)"
                               @onchange="@(e => ToggleName(Trigger.SourceNames, n, e.Value is bool v && v))" />
                        <span>@n</span>
                    </label>
                }
            </div>
        </div>
    }

    @if (triggerEntry.SupportsDamageKindFilter)
    {
        <div class="dc-field">
            <span class="dc-flabel">@Loc["DamageKindEmptyAnyKind"]</span>
            <select class="dc-inp" @bind="Trigger.DamageKind">
                <option value=""></option>
                @foreach (var kindName in GetDamageKindNames())
                {
                    <option value="@kindName">@kindName</option>
                }
            </select>
        </div>
    }

    @if (triggerEntry.NeedsField)
    {
        <div class="dc-field">
            <span class="dc-flabel">@Loc["CustomFieldEmptyAnyMatchingField"]</span>
            <select class="dc-inp" @bind="Trigger.FieldTitle">
                <option value=""></option>
                @foreach (var field in GetFieldChoices(triggerEntry))
                {
                    <option value="@field.Title">@GetFieldChoiceDisplayName(field)</option>
                }
            </select>
        </div>
    }

    @if (triggerEntry.NeedsOption)
    {
        <div class="dc-field">
            <span class="dc-flabel">@Loc["OptionEmptyAnyOption"]</span>
            <select class="dc-inp" @bind="Trigger.OptionName">
                <option value=""></option>
                @foreach (var optionName in GetOptionNames(triggerEntry.FieldType, Trigger.FieldTitle))
                {
                    <option value="@optionName">@optionName</option>
                }
            </select>
        </div>
    }

    @if (triggerEntry.NeedsStat)
    {
        <div class="dc-field">
            <span class="dc-flabel">@Loc["StatEmptyAnyStat"]</span>
            <select class="dc-inp" @bind="Trigger.StatName">
                <option value=""></option>
                @foreach (var statName in GetStatNames(Trigger.FieldTitle))
                {
                    <option value="@statName">@statName</option>
                }
            </select>
        </div>
    }

    @if (triggerEntry.NeedsThreshold)
    {
        <div class="dc-field">
            <span class="dc-flabel">@Loc["Comparison"]</span>
            <select class="dc-inp" @bind="Trigger.ThresholdOperator">
                @foreach (var op in _thresholdOperators)
                {
                    <option value="@op">@GetThresholdOperatorDisplay(op)</option>
                }
            </select>
        </div>
        <div class="dc-field">
            <span class="dc-flabel">@GetThresholdLabel(triggerEntry)</span>
            <div class="dc-step">
                <button type="button" @onclick="@(() => StepThreshold(-1))">&minus;</button>
                <input type="number" class="dc-num" step="any" @bind="Trigger.ThresholdValue" />
                <button type="button" @onclick="@(() => StepThreshold(1))">+</button>
            </div>
        </div>
        <label class="dc-chk tg-inline">
            <input type="checkbox" @bind="Trigger.TriggerOnlyOnCrossing" />
            <span>@Loc["OnlyWhenValueCrossesThreshold"]</span>
        </label>
    }
    </div>

    <p class="dc-msec-help" style="margin:10px 0 0;">@GetTriggerSummary(Trigger)</p>

    @* Collapsed by default: the list is long and only needed while writing a
       body or a condition. MudExpansionPanels stays — app.css restyles it. *@
    <MudExpansionPanels Class="trigger-vars mt-2">
        <MudExpansionPanel Text="@Loc["AvailableVariables", GetPlaceholders(triggerEntry).Count]">
            <div class="trigger-variables">
                @foreach (var placeholder in GetPlaceholders(triggerEntry))
                {
                    var p = placeholder;
                    <span class="kbd trigger-variable @(_copiedPlaceholder == p ? "copied" : "")" @onclick="() => CopyPlaceholder(p)">
                        @AsPlaceholder(p)
                    </span>
                }
            </div>
            <p class="dc-msec-help" style="margin:8px 0 0;">@Loc["AvailableVariablesHint"]</p>
        </MudExpansionPanel>
    </MudExpansionPanels>
</div>

@code {
    [Parameter] public EventTriggerDefinition Trigger { get; set; } = new();

    private readonly List<string> _thresholdOperators = ["Below", "BelowOrEqual", "Above", "AboveOrEqual"];
    private string _copiedPlaceholder = string.Empty;

    /// What the selected trigger delivers, plus the event itself.
    private static IReadOnlyList<string> GetPlaceholders(EventTriggerCatalogEntry entry)
    {
        return EventPayloadCatalog.ForEventType(entry.EventType)
            .Concat(EventPayloadCatalog.EventPlaceholders)
            .ToList();
    }

    private static string AsPlaceholder(string path)
    {
        return "{{" + path + "}}";
    }

    private async Task CopyPlaceholder(string path)
    {
        _copiedPlaceholder = path;
        await JS.InvokeVoidAsync("dcCopyText", AsPlaceholder(path));
    }

    /// The MudSelect these replaced handed back a fresh collection; a tick box
    /// toggles one name, so the bound list is edited in place instead.
    private static void ToggleName(List<string> names, string name, bool selected)
    {
        if (selected)
        {
            if (!names.Contains(name))
            {
                names.Add(name);
            }
        }
        else
        {
            names.Remove(name);
        }
    }

    private void StepThreshold(double delta)
    {
        Trigger.ThresholdValue = (Trigger.ThresholdValue ?? 0) + delta;
    }

    private void SetTriggerKind(string kind)
    {
        Trigger.Kind = kind;
        Trigger.FieldTitle = string.Empty;
        Trigger.OptionName = string.Empty;
        Trigger.StatName = string.Empty;
        Trigger.DamageKind = string.Empty;
        Trigger.ThresholdValue = null;
    }

    private static EventTriggerCatalogEntry GetTriggerEntry(EventTriggerDefinition trigger)
    {
        return EventTriggerCatalog.Get(trigger.Kind) ?? EventTriggerCatalog.Entries.First();
    }

    private IReadOnlyList<string> GetCreatureNames()
    {
        return CombatService.GetCreatureList()
            .Select(x => x.Name)
            .Concat(CombatService.GetCombatList().SelectMany(x => x.CreaturesList).Select(x => x.Name))
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();
    }

    private IReadOnlyList<string> GetDamageKindNames()
    {
        return GetKnownCustomFields()
            .OfType<DCCreatureHitPointsField>()
            .SelectMany(x => x.DamageKinds)
            .Select(x => x.Name)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();
    }

    private IReadOnlyList<CustomFieldChoice> GetFieldChoices(EventTriggerCatalogEntry triggerEntry)
    {
        return GetKnownCustomFields()
            .Where(x => IsFieldChoiceCompatible(x, triggerEntry))
            .GroupBy(x => new { x.Title, x.FieldType })
            .Select(x => new CustomFieldChoice(x.Key.Title, x.Key.FieldType))
            .OrderBy(x => x.Title)
            .ThenBy(x => x.FieldType)
            .ToList();
    }

    private static bool IsFieldChoiceCompatible(DCCreatureCustomField field, EventTriggerCatalogEntry triggerEntry)
    {
        if (!string.IsNullOrWhiteSpace(triggerEntry.FieldType) && !string.Equals(field.FieldType, triggerEntry.FieldType, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return triggerEntry.Kind != EventTriggerKinds.NumericReachedMaxValue || field is DCCreatureNumericField { ShowMaxValue: true };
    }

    private IReadOnlyList<string> GetOptionNames(string fieldType, string fieldTitle)
    {
        return GetKnownCustomFields()
            .Where(x => string.IsNullOrWhiteSpace(fieldTitle) || string.Equals(x.Title, fieldTitle, StringComparison.OrdinalIgnoreCase))
            .Where(x => string.IsNullOrWhiteSpace(fieldType) || string.Equals(x.FieldType, fieldType, StringComparison.OrdinalIgnoreCase))
            .SelectMany(field => field switch
            {
                DCCreatureCheckboxField checkbox => checkbox.Labels,
                DCCreatureConditionsField conditions => conditions.Labels,
                _ => Enumerable.Empty<string>()
            })
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();
    }

    private IReadOnlyList<string> GetStatNames(string fieldTitle)
    {
        return GetKnownCustomFields()
            .OfType<DCCreatureStatsField>()
            .Where(x => string.IsNullOrWhiteSpace(fieldTitle) || string.Equals(x.Title, fieldTitle, StringComparison.OrdinalIgnoreCase))
            .SelectMany(x => x.StatsLabels)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .ToList();
    }

    private IEnumerable<DCCreatureCustomField> GetKnownCustomFields()
    {
        foreach (var field in CombatService.GetUserCreatureCustomFields())
            yield return field;

        foreach (var creature in CombatService.GetCreatureList())
            foreach (var field in creature.CustomFields)
                yield return field;

        foreach (var combat in CombatService.GetCombatList())
        {
            foreach (var creature in combat.CreaturesList)
                foreach (var field in creature.CustomFields)
                    yield return field;

            foreach (var creatureFields in combat.InCombatCustomFieldsInstances)
                foreach (var instanceFields in creatureFields)
                    foreach (var field in instanceFields)
                        yield return field;
        }
    }

    private string GetTriggerSummary(EventTriggerDefinition trigger)
    {
        var entry = GetTriggerEntry(trigger);
        var creatureText = trigger.CreatureNames.Count == 0 ? Loc["TriggerSummaryAnyCreature"].Value : string.Join(", ", trigger.CreatureNames);
        var fieldText = string.IsNullOrWhiteSpace(trigger.FieldTitle) ? Loc["TriggerSummaryAnyMatchingField"].Value : Loc["TriggerSummaryField", trigger.FieldTitle].Value;
        var optionText = string.IsNullOrWhiteSpace(trigger.OptionName) ? Loc["TriggerSummaryAnyOption"].Value : Loc["TriggerSummaryOption", trigger.OptionName].Value;
        var statText = string.IsNullOrWhiteSpace(trigger.StatName) ? Loc["TriggerSummaryAnyStat"].Value : Loc["TriggerSummaryStat", trigger.StatName].Value;

        if (trigger.Kind == EventTriggerKinds.NumericReachedMaxValue) return Loc["TriggerSummaryNumericReachedMaxValue", fieldText, creatureText].Value;
        if (entry.NeedsThreshold) return Loc["TriggerSummaryThreshold", fieldText, creatureText, GetThresholdOperatorDisplay(trigger.ThresholdOperator), trigger.ThresholdValue?.ToString() ?? string.Empty].Value;
        if (entry.NeedsStat) return Loc["TriggerSummaryStatChanged", statText, fieldText, creatureText].Value;
        if (entry.NeedsOption) return Loc["TriggerSummaryOptionChanged", optionText, fieldText, creatureText].Value;
        if (entry.NeedsField) return Loc["TriggerSummaryFieldChanged", fieldText, creatureText].Value;
        if (entry.SupportsSourceFilter)
        {
            var sourceText = trigger.SourceNames.Count == 0 ? Loc["TriggerSummaryAnySource"].Value : string.Join(", ", trigger.SourceNames);
            if (!entry.SupportsDamageKindFilter) return Loc["TriggerSummarySource", sourceText, creatureText].Value;

            var kindText = string.IsNullOrWhiteSpace(trigger.DamageKind) ? Loc["TriggerSummaryAnyDamageKind"].Value : trigger.DamageKind;
            return Loc["TriggerSummaryDamage", sourceText, kindText, creatureText].Value;
        }

        if (entry.SupportsCreatureFilter) return Loc["TriggerSummaryCreatureFilter", creatureText].Value;
        return Loc["TriggerSummaryDefault", GetTriggerDisplayName(entry)].Value;
    }

    private string GetTriggerSelectText(EventTriggerCatalogEntry entry)
    {
        return $"{GetTriggerCategory(entry)} - {GetTriggerDisplayName(entry)}";
    }

    private string GetTriggerCategory(EventTriggerCatalogEntry entry)
    {
        return Loc[$"TriggerCategory_{entry.Category.Replace(" ", "")}"].Value;
    }

    private string GetTriggerDisplayName(EventTriggerCatalogEntry entry)
    {
        return Loc[$"TriggerDisplay_{entry.Kind}"].Value;
    }

    private string GetThresholdLabel(EventTriggerCatalogEntry entry)
    {
        return Loc[$"ThresholdLabel_{entry.Kind}"].ResourceNotFound ? Loc["ThresholdLabel_Value"].Value : Loc[$"ThresholdLabel_{entry.Kind}"].Value;
    }

    private string GetThresholdOperatorDisplay(string op)
    {
        return Loc[$"ThresholdOperator_{op}"].Value;
    }

    private string GetFieldChoiceDisplayName(CustomFieldChoice field)
    {
        var fieldType = Loc[$"FieldType_{field.FieldType}"].ResourceNotFound ? field.FieldType : Loc[$"FieldType_{field.FieldType}"].Value;
        return string.IsNullOrWhiteSpace(fieldType) ? field.Title : $"{field.Title} ({fieldType})";
    }

    private sealed record CustomFieldChoice(string Title, string FieldType);
}
