@*
    Shown instead of the app when the data folder cannot be used at startup
    (spec §3.4, §7.1): missing (a drive or a share that is not there), not
    usable, or open on another computer (dice.lock, spec §5.5). Nothing has
    been read; nothing is ever created in the missing folder. The user tries
    again, picks the folder where it is now, uses the data on this computer
    for this session only, opens it anyway (lock), or quits.
*@

@using DiceCombats.Storage
@inject DataFolderService DataFolder
@inject IFileHandler FileHandler
@inject AppSettings Settings
@inject IStringLocalizer<DiceCombats.Resources.Localization.Portability> Loc

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px 16px;">
    <div class="dc-panel" style="width:min(640px,100%);">
        @if (Location.State == DataLocationState.OpenElsewhere && Location.OtherLock is DataFolderLockInfo other)
        {
            <h2 class="dc-h1" style="font-size:22px;margin:0 0 10px;">@Loc["LockTitle"]</h2>
            <p class="dc-meta" style="font-size:14px;line-height:1.55;">
                @(string.Equals(other.Machine, Location.MachineName, StringComparison.OrdinalIgnoreCase)
                    ? string.Format(Loc["LockSameComputerText"], Since(other))
                    : string.Format(Loc["LockText"], other.Machine, Since(other)))
            </p>
            <div class="dc-stack" style="gap:12px;margin-top:16px;">
                <div>
                    <button type="button" class="dc-btn dc-btn-fill" disabled="@_busy" @onclick="OpenAnyway">
                        <DcIcon Name="folder-open" /> @Loc["LockOpenAnywayBtn"]
                    </button>
                </div>
                <div>
                    <button type="button" class="dc-btn dc-btn-out" @onclick="Quit">
                        <DcIcon Name="close" /> @Loc["StartupQuitBtn"]
                    </button>
                    <div class="dc-meta" style="margin-top:4px;">@Loc["StartupQuitHelp"]</div>
                </div>
            </div>
        }
        else
        {
        <h2 class="dc-h1" style="font-size:22px;margin:0 0 10px;">
            @(Location.State == DataLocationState.Missing ? Loc["StartupMissingTitle"] : Loc["StartupInvalidTitle"])
        </h2>
        <p class="dc-meta" style="font-size:14px;line-height:1.55;">
            @(Location.State == DataLocationState.Missing
                ? string.Format(Loc["StartupMissingText"], Location.Root)
                : string.Format(Loc["StartupInvalidText"], Location.Root))
        </p>

        @if (_chosenProblem != null)
        {
            <p class="dc-note" style="margin:10px 0;">@_chosenProblem</p>
        }

        @* One option per line, each with what it does, as in the dialog for a
           folder that already holds data. *@
        <div class="dc-stack" style="gap:12px;margin-top:16px;">
            <div>
                <button type="button" class="dc-btn dc-btn-fill" disabled="@_busy" @onclick="TryAgain">
                    <DcIcon Name="sync" /> @Loc["StartupTryAgainBtn"]
                </button>
                <div class="dc-meta" style="margin-top:4px;">@Loc["StartupTryAgainHelp"]</div>
            </div>
            @if (OperatingSystem.IsWindows())
            {
                <div>
                    <button type="button" class="dc-btn dc-btn-out" disabled="@_busy" @onclick="ChooseFolder">
                        <DcIcon Name="folder-open" /> @Loc["StartupChooseFolderBtn"]
                    </button>
                    <div class="dc-meta" style="margin-top:4px;">@Loc["StartupChooseFolderHelp"]</div>
                </div>
            }
            <div>
                <button type="button" class="dc-btn dc-btn-out" disabled="@_busy" @onclick="UseLocal">
                    <DcIcon Name="save" /> @Loc["StartupUseLocalBtn"]
                </button>
                <div class="dc-meta" style="margin-top:4px;">@Loc["StartupUseLocalHelp"]</div>
            </div>
            <div>
                <button type="button" class="dc-btn dc-btn-out" @onclick="Quit">
                    <DcIcon Name="close" /> @Loc["StartupQuitBtn"]
                </button>
                <div class="dc-meta" style="margin-top:4px;">@Loc["StartupQuitHelp"]</div>
            </div>
        </div>
        }
    </div>
</div>

@code {
    private bool _busy;
    private string? _chosenProblem;

    private DataLocation Location => DataFolder.Location;

    private static string Since(DataFolderLockInfo info) => info.StartedUtc.ToLocalTime().ToString("g");

    private async Task TryAgain()
    {
        _chosenProblem = null;
        if (Location.Evaluate() == DataLocationState.Ok)
        {
            await LoadAsync();
        }
    }

    // The folder where the data is now: one that holds DiceCombats data.
    // Anything else is refused here; a new folder is chosen from Settings.
    private async Task ChooseFolder()
    {
        _chosenProblem = null;
        string? folder = await FileHandler.PickFolderAsync();
        if (folder == null) return;

        DataFolderMarker? marker = null;
        try { marker = DataFolderMarker.Read(folder); }
        catch (InvalidDataException) { }
        if (marker == null || marker.App != Location.AppName || marker.Version > DataFolderMarker.CurrentVersion)
        {
            _chosenProblem = string.Format(Loc["StartupInvalidText"], folder);
            return;
        }

        Location.SetPointer(DataFolder.IsDefault(folder) ? null : folder);
        var state = Location.UsePointerNow();
        if (state == DataLocationState.Ok)
        {
            await LoadAsync();
        }
        else if (state != DataLocationState.OpenElsewhere)
        {
            _chosenProblem = string.Format(Loc["StartupInvalidText"], folder);
        }
    }

    private async Task UseLocal()
    {
        _chosenProblem = null;
        Location.UseDefaultForThisSession();
        if (Location.State == DataLocationState.Ok)
        {
            await LoadAsync();
        }
    }

    // "Open anyway": this session writes its own lock over the other one.
    private async Task OpenAnyway()
    {
        if (Location.AcceptOtherLock() == DataLocationState.Ok)
        {
            await LoadAsync();
        }
    }

    // Once loaded, the language of the data folder's settings applies: the
    // screen spoke the language kept on this computer.
    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            await DataFolder.LoadAsync();
            string language = Settings.Get("Language", CultureInfo.CurrentUICulture.Name);
            if (!string.Equals(language, CultureInfo.CurrentUICulture.Name, StringComparison.OrdinalIgnoreCase))
            {
                (Application.Current as App)?.SetCultureAndReload(language);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void Quit()
    {
        Application.Current?.Quit();
    }
}
