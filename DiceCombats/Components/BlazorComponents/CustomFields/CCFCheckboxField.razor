@using DiceCombats
@inject DiceCombatsService CombatService
@inject IStringLocalizer<Resources.Localization.CreatureCustomFieldRenderer> Loc

@if (EditionMode)
{
    <div class="dc-fbody dc-fbody-col">
        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:11px;">
            <button type="button" class="dc-btn dc-btn-fill" @onclick="@(() => Field.AddOption())">
                <DcIcon Name="add" />
                @Loc["CBFieldAddOption"]
            </button>
            <label class="dc-chk">
                <input type="checkbox" @bind="Field.ShowFieldName" />
                @Loc["CBFieldShowFieldName"]
            </label>
            <label class="dc-chk">
                <input type="checkbox" @bind="Field.ShowTextFields" />
                @Loc["CBFieldShowTextFields"]
            </label>
            @* New: a ticked option may light its whole cell in play mode. *@
            <label class="dc-chk">
                <input type="checkbox" @bind="Field.HighlightWhenChecked" />
                @Loc["CBFieldHighlightWhenChecked"]
            </label>
        </div>

        <div class="dc-opt-grid" style="width:100%;">
            @foreach (int i in Enumerable.Range(0, Field.Labels.Count))
            {
                <div class="dc-opt" style="flex-wrap:wrap;">
                    <div class="dc-field" style="flex:1 1 90px;">
                        <span class="dc-flabel">Name</span>
                        <input class="dc-inp" type="text" @bind="Field.Labels[i]" @bind:event="oninput" />
                    </div>
                    <label class="dc-chk">
                        <input type="checkbox" @bind="Field.SelectedOptions[i]" />
                        @Field.Labels[i]
                    </label>
                    @if (Field.ShowTextFields == true)
                    {
                        <div class="dc-field" style="flex:1 1 90px;">
                            <span class="dc-flabel">@Loc["CBFieldTextLabels"]</span>
                            <input class="dc-inp" type="text" @bind="Field.TextFieldsLabels[i]" @bind:event="oninput" />
                        </div>
                    }
                    <button type="button" class="dc-ib dc-danger" title="Delete"
                            @onclick="@(() => Field.RemoveOption(Field.Labels[i]))">
                        <DcIcon Name="delete" />
                    </button>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="dc-fgrp" style="flex-wrap:wrap;">
        @if (Field.ShowFieldName)
        {
            <span class="dc-flabel">@Field.Title</span>
        }
        @foreach (int i in Enumerable.Range(0, Field.Labels.Count))
        {
            var index = i;
            @if (Field.HighlightWhenChecked)
            {
                @* The whole cell lights, name and value included. *@
                <div class="dc-ohl @(Field.SelectedOptions[index] ? "dc-on" : "")">
                    <label class="dc-chk">
                        <input type="checkbox" checked="@Field.SelectedOptions[index]"
                               @onchange="@(e => OnOptionChanged(index, e.Value is bool v && v))" />
                        <span class="dc-ohl-name">@Field.Labels[index]</span>
                    </label>
                    @if (Field.ShowTextFields == true)
                    {
                        <textarea class="dc-inp dc-gta" rows="1" data-dc-grow="height" spellcheck="false"
                                  style="width:110px;flex:0 1 110px;"
                                  placeholder="@Field.TextFieldsLabels[index]" title="@Field.TextFieldsLabels[index]"
                                  value="@Field.TextFields[index]"
                                  @onchange="@(e => OnTextChanged(index, e.Value?.ToString() ?? string.Empty))"></textarea>
                    }
                </div>
            }
            else
            {
                <label class="dc-chk">
                    <input type="checkbox" checked="@Field.SelectedOptions[index]"
                           @onchange="@(e => OnOptionChanged(index, e.Value is bool v && v))" />
                    @Field.Labels[index]
                </label>
                @if (Field.ShowTextFields == true)
                {
                    <textarea class="dc-inp dc-gta" rows="1" data-dc-grow="height" spellcheck="false"
                              style="width:110px;flex:0 1 110px;"
                              placeholder="@Field.TextFieldsLabels[index]" title="@Field.TextFieldsLabels[index]"
                              value="@Field.TextFields[index]"
                              @onchange="@(e => OnTextChanged(index, e.Value?.ToString() ?? string.Empty))"></textarea>
                }
            }
        }
    </div>
}

@code {
    [Parameter] public DCCreatureCheckboxField Field { get; set; } = default!;
    [Parameter] public bool EditionMode { get; set; } = false;
    [Parameter] public EventCallback OnChange { get; set; }
    [Parameter] public EventCallback<CustomFieldChangeInfo> OnFieldChanged { get; set; }

    private async Task OnOptionChanged(int index, bool newValue)
    {
        var oldValue = Field.SelectedOptions[index];
        Field.SelectedOptions[index] = newValue;
        await RaiseChanged(oldValue, newValue, newValue ? "Checked" : "Unchecked", index, Field.Labels.ElementAtOrDefault(index));
    }

    private async Task OnTextChanged(int index, string newValue)
    {
        var oldValue = Field.TextFields[index];
        Field.TextFields[index] = newValue;
        await RaiseChanged(oldValue, newValue, "TextChanged", index, Field.Labels.ElementAtOrDefault(index), Field.TextFieldsLabels.ElementAtOrDefault(index));
    }

    private async Task RaiseChanged(object? oldValue, object? newValue, string action, int index, string? optionName, string? textLabel = null)
    {
        if (OnFieldChanged.HasDelegate)
        {
            await OnFieldChanged.InvokeAsync(new CustomFieldChangeInfo
            {
                Field = Field,
                OldValue = oldValue,
                NewValue = newValue,
                Action = action,
                OptionIndex = index,
                OptionName = optionName,
                TextLabel = textLabel
            });
        }

        if (OnChange.HasDelegate)
            await OnChange.InvokeAsync();
    }
}
