@using DiceCombats
@inject DiceCombatsService CombatService
@inject IStringLocalizer<Resources.Localization.CreatureCustomFieldRenderer> Loc

@if (EditionMode)
{
    <div class="dc-fbody">
        <div class="dc-field" style="flex:1 1 auto;">
            <span class="dc-flabel">@Field.Title</span>
            <input class="dc-inp" type="text" spellcheck="false" value="@Field.Text"
                   @onchange="@(e => OnTextChanged(e.Value?.ToString() ?? string.Empty))" />
        </div>
    </div>
}
else
{
    @* The box is sized by what is in it: --dc-grow-w is set from the outside,
       and data-dc-grow marks the textarea that measurement looks for. *@
    <div class="dc-fgrp dc-fgrp-grow">
        <span class="dc-flabel">@Field.Title</span>
        <textarea class="dc-inp dc-gta" rows="1" data-dc-grow="true" spellcheck="false"
                  style="flex:1 1 auto;" value="@Field.Text"
                  @onchange="@(e => OnTextChanged(e.Value?.ToString() ?? string.Empty))"></textarea>
    </div>
}

@code {
    [Parameter] public DCCreatureTextField Field { get; set; } = default!;
    [Parameter] public bool EditionMode { get; set; } = false;
    [Parameter] public EventCallback OnChange { get; set; }
    [Parameter] public EventCallback<CustomFieldChangeInfo> OnFieldChanged { get; set; }

    private async Task OnTextChanged(string value)
    {
        var oldValue = Field.Text;
        Field.Text = value;

        if (OnFieldChanged.HasDelegate)
        {
            await OnFieldChanged.InvokeAsync(new CustomFieldChangeInfo
            {
                Field = Field,
                OldValue = oldValue,
                NewValue = value,
                Action = "Changed"
            });
        }

        if (OnChange.HasDelegate)
            await OnChange.InvokeAsync();
    }
}
